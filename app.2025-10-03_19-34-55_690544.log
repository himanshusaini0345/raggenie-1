INNER JOIN mst.Department mst ON mst.Id = emp.DepartmentId
WHERE emp.University_Id = 1  AND emp.ActionStatusId = 1  
GROUP BY mst.DepartmentName
HAVING COUNT(emp.Id) > 50
ORDER BY EmployeeCount DESC;





