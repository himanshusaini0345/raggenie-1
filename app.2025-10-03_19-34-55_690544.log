2025-10-03 13:34:44.530 | INFO     | app.chain.modules.cache_checker:handle:77 - out:[{'_id': ObjectId('68df81f09f6ab1f4e510ac8f'), 'document': 'attendence details of vk ti?', 'metadatas': {'query': "SELECT A.EmployeeId, E.EmployeeName, E.FrontImage, E.DepartmentName, A.AttendanceDate, A.SiftIn, A.SiftOut, A.SiftTypeId, MBA.SiftName, RIGHT('0' + CAST(CASE WHEN A.SiftIn > (CAST(A.AttendanceDate AS DATETIME) + CAST(MBA.SiftIn AS DATETIME)) THEN DATEDIFF(MINUTE, CAST(A.AttendanceDate AS DATETIME) + CAST(MBA.SiftIn AS DATETIME), A.SiftIn) ELSE 0 END / 60 AS VARCHAR), 2) + ':' + RIGHT('0' + CAST(CASE WHEN A.SiftIn > (CAST(A.AttendanceDate AS DATETIME) + CAST(MBA.SiftIn AS DATETIME)) THEN DATEDIFF(MINUTE, CAST(A.AttendanceDate AS DATETIME) + CAST(MBA.SiftIn AS DATETIME), A.SiftIn) ELSE 0 END % 60 AS VARCHAR), 2) AS LateMins, RIGHT('0' + CAST(CASE WHEN A.SiftOut > (CAST(A.AttendanceDate AS DATETIME) + CAST(MBA.SiftOut AS DATETIME)) THEN DATEDIFF(MINUTE, CAST(A.AttendanceDate AS DATETIME) + CAST(MBA.SiftOut AS DATETIME), A.SiftOut) ELSE 0 END / 60 AS VARCHAR), 2) + ':' + RIGHT('0' + CAST(CASE WHEN A.SiftOut > (CAST(A.AttendanceDate AS DATETIME) + CAST(MBA.SiftOut AS DATETIME)) THEN DATEDIFF(MINUTE, CAST(A.AttendanceDate AS DATETIME) + CAST(MBA.SiftOut AS DATETIME), A.SiftOut) ELSE 0 END % 60 AS VARCHAR), 2) AS OTHours, RIGHT('0' + CAST(DATEDIFF(MINUTE, CASE WHEN A.SiftIn > (CAST(A.AttendanceDate AS DATETIME) + CAST(MBA.SiftIn AS DATETIME)) THEN A.SiftIn ELSE (CAST(A.AttendanceDate AS DATETIME) + CAST(MBA.SiftIn AS DATETIME)) END, CASE WHEN A.SiftOut < (CAST(A.AttendanceDate AS DATETIME) + CAST(MBA.SiftOut AS DATETIME)) THEN A.SiftOut ELSE (CAST(A.AttendanceDate AS DATETIME) + CAST(MBA.SiftOut AS DATETIME)) END) / 60 AS VARCHAR), 2) + ':' + RIGHT('0' + CAST(DATEDIFF(MINUTE, CASE WHEN A.SiftIn > (CAST(A.AttendanceDate AS DATETIME) + CAST(MBA.SiftIn AS DATETIME)) THEN A.SiftIn ELSE (CAST(A.AttendanceDate AS DATETIME) + CAST(MBA.SiftIn AS DATETIME)) END, CASE WHEN A.SiftOut < (CAST(A.AttendanceDate AS DATETIME) + CAST(MBA.SiftOut AS DATETIME)) THEN A.SiftOut ELSE (CAST(A.AttendanceDate AS DATETIME) + CAST(MBA.SiftOut AS DATETIME)) END) % 60 AS VARCHAR), 2) AS DutyHours FROM (SELECT BA.EmployeeId, CAST(BA.AttendanceDate AS DATE) AS AttendanceDate, MIN(CASE WHEN BA.PunchMode = 'In' THEN BA.AttendanceDate END) AS SiftIn, MAX(CASE WHEN BA.PunchMode = 'Out' THEN BA.AttendanceDate END) AS SiftOut, MIN(CASE WHEN BA.PunchMode = 'In' THEN BA.SiftTypeId END) AS SiftTypeId FROM emp.BioAttendance BA WHERE BA.EmployeeId IN (SELECT Id FROM emp.vw_EmployeesList WHERE EmployeeName LIKE 'vvvv ttt%') AND CAST(BA.AttendanceDate AS DATE) BETWEEN '2025-06-01' AND '2025-06-18' GROUP BY BA.EmployeeId, CAST(BA.AttendanceDate AS DATE)) AS A INNER JOIN emp.vw_EmployeesList E ON A.EmployeeId = E.Id LEFT JOIN mst.BioAttSift MBA ON MBA.Id = A.SiftTypeId ORDER BY A.EmployeeId, A.AttendanceDate;", 'metadata': '', 'datasource': 'database_agent', 'config_id': 1}, 'score': 0.8070099949836731, 'distances': 0.1929900050163269}, {'_id': ObjectId('68df81f09f6ab1f4e510ac90'), 'document': 'age of vk ti', 'metadatas': {'query': "SELECT Id, EmployeeName, UserDOB, DATEDIFF(YEAR, TRY_CAST(UserDOB AS date), GETDATE()) AS Age FROM emp.vw_EmployeesList WHERE ActionStatusId=1 AND LOWER(EmployeeName) LIKE LOWER('vk ti%')", 'metadata': '', 'datasource': 'database_agent', 'config_id': 1}, 'score': 0.7827445268630981, 'distances': 0.21725547313690186}, {'_id': ObjectId('68df81f09f6ab1f4e510ac73'), 'document': 'Can you provide the arrear details for amil shaji?', 'metadatas': {'query': "SELECT Id, EmployeeName, AllowanceArrear, BasicSalaryArrear, OtArrear FROM emp.FinalPayrollforStipend WHERE LOWER(EmployeeName) LIKE LOWER('amil shaji%') UNION ALL SELECT Id, EmployeeName, AllowanceArrear, BasicSalaryArrear, OtArrear FROM emp.FinalPayrollforTeaching WHERE LOWER(EmployeeName) LIKE LOWER('amil shaji%') UNION ALL SELECT Id, EmployeeName, AllowanceArrear, BasicSalaryArrear, OtArrear FROM emp.FinalPayrollforNonTeaching WHERE LOWER(EmployeeName) LIKE LOWER('amil shaji%');\n", 'metadata': '', 'datasource': 'database_agent', 'config_id': 1}, 'score': 0.7214040756225586, 'distances': 0.2785959243774414}]
