question: Which employees in the IT department have resigned within the last three months?
query: select EmployeeName, UpdateDate as ResignationDate from emp.employees where UpdateDate > DateAdd(Month, -3, GetDate())and ActionStatusId = 2 and DepartmentId = (select top 1 Id from mst.Department where DepartmentName like 'information technology%') 

question: Which departments have more than 100 employees?
query: SELECT mst.DepartmentName,COUNT(emp.Id) AS EmployeeCount FROM emp.Employees emp
INNER JOIN mst.Department mst ON mst.Id = emp.DepartmentId
WHERE emp.University_Id = 1  AND emp.ActionStatusId = 1  
GROUP BY mst.DepartmentName
HAVING COUNT(emp.Id) > 100
ORDER BY EmployeeCount DESC;

question: how many employees were on leave in it department this month
query: SELECT ld.EmployeeId, ev.EmployeeName, ev.DepartmentName, ev.DesignationName, COUNT(*) AS LeavesTaken FROM emp.LeaveDateWiseDetails ld INNER JOIN emp.vw_EmployeesList ev ON ld.EmployeeId = ev.Id WHERE ev.DepartmentName LIKE '%information technology%' AND ld.LeaveDate BETWEEN '2025-06-01' AND GETDATE() AND ld.ActionStatusId = 4 AND ld.ApprovedActionStatusId = 4 GROUP BY ld.EmployeeId, ev.EmployeeName, ev.DepartmentName, ev.DesignationName;



