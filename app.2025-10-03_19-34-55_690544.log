question: show me the list of whose total RF is more than 1,00,000.
query: SELECT emp.Id AS EmployeeId,emp.EmployeeCode,emp.EmployeeName,SUM(ISNULL(FPT.RF, 0)) + ISNULL(RFO.OpeningBalance, 0) AS TotalRF FROM emp.FinalPayrollforTeaching FPT
INNER JOIN emp.vw_EmployeesList emp ON emp.Id = FPT.EmployeeId 
LEFT JOIN emp.RFIntrestForTeaching RFO  ON emp.Id = RFO.EmployeeId AND RFO.IsOpeningBal = 1  
WHERE emp.UniversityId=1 AND emp.ActionStatusId=1
GROUP BY emp.Id, emp.EmployeeCode, emp.EmployeeName,RFO.OpeningBalance
HAVING SUM(ISNULL(FPT.RF, 0)) + ISNULL(RFO.OpeningBalance, 0) > 100000;

question: provide the relative working list?
query: SELECT EmployeeId,EMP.EmployeeName,EMP.FatherName,EMP.DesignationName, EMP.DepartmentName,EMP.CollegeName,EM.RelativeEmployeeId,REMP.EmployeeName RelativeEmployeeName,
REMP.FatherName  RelativeFatherName,REMP.DesignationName  RelativeDesignationName,REMP.DepartmentName  RelativeDepartmentName,REMP.CollegeName  RelativeCollegeName FROm emp.Relatives EM
 INNER JOIN emp.vw_EmployeesList EMP ON EMP.Id=EM.EmployeeId AND EMP.ActionStatusId=1
 INNER JOIN emp.vw_EmployeesList REMP ON REMP.Id=EM.RelativeEmployeeId AND REMP.ActionStatusId=1
WHERE EMP.UniversityId=1 AND  EM.ActionStatusId=1  
ORDER BY REMP.JobName,REMP.EmployeeName

question: list of boy hostel warden
query:  SELECT EmployeeName, FatherName, DepartmentName, DesignationName, MobileNo FROM emp.vw_EmployeesList WHERE UniversityId = 1 AND ActionStatusId = 1 AND LOWER(DesignationName) LIKE '%warden%' AND LOWER(DepartmentName) LIKE '%boy%' ORDER BY DepartmentName

question: list all hod in different medicine department?
query: SELECT Id, EmployeeName, DepartmentName, DesignationName FROM emp.vw_EmployeesList WHERE LOWER(DepartmentName) LIKE LOWER('%MEDICINE%') and LOWER(DesignationName) LIKE LOWER('%HOD%') 

question: provide me the allowence data list
query: SELECT EmployeeId,EmployeeName,FatherName,DesignationName,JobName,DepartmentName,CollegeName,Amount,EC.EarningName FROm emp.EarningsMappings EM
 INNER JOIN emp.vw_EmployeesList EMP ON EMP.Id=EM.EmployeeId AND EMP.ActionStatusId=1
 INNER JOIN mst.EarningCategoryDetail EC ON EC.Id=EM.EarningCatDetailId AND EMP.ActionStatusId=1
WHERE UniversityId=1 AND  EM.ActionStatusId=1   AND ISNULL(Amount,0)>0
ORDER BY JobName,EmployeeName,EarningName


