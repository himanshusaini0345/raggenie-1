            question: What is the current Casual Leaves (CL) balance of Shivdatt?
query: SELECT  LB.EmployeeId,EMP.JobName,EMP.EmployeeName,EMP.DesignationName,EMP.DepartmentName, EMP.FatherName,LT.LeaveTypeName,LB.BalanceLeave, ISNULL(TL.TakenLeave, 0) AS TakenLeave,
(LB.BalanceLeave - ISNULL(TL.TakenLeave, 0)) AS LeaveBalance FROM emp.LeaveBalance LB
INNER JOIN emp.VW_EmployeesList EMP ON LB.EmployeeId = EMP.Id
INNER JOIN mst.LeaveType LT ON LT.Id = LB.LeaveTypeId
LEFT JOIN (SELECT EmployeeId, LeaveTypeId,SUM(TotalLeave) AS TakenLeave FROM emp.LeaveDateWiseDetails 
WHERE  ActionStatusId = 9  AND ApprovedActionStatusId = 8 AND LeaveDate >= DATEFROMPARTS(YEAR(GETDATE()), 1, 1) GROUP BY EmployeeId, LeaveTypeId) TL
ON LB.EmployeeId = TL.EmployeeId AND LB.LeaveTypeId = TL.LeaveTypeId
WHERE EMP.EmployeeName LIKE 'Shivdatt%'  AND LT.LeaveTypeName LIKE 'Casual Leave%' AND LB.CreateDate >= DATEFROMPARTS(YEAR(GETDATE()), 1, 1)

question: driver details with dl number UP1520090054348
query: SELECT d.DLNumber, d.NTVailidity, d.TRVailidity, e.EmployeeName, e.FatherName, d.Address FROM [vhc].DriverDetails d INNER JOIN emp.employees e ON e.Id = d.EmployeeId WHERE d.DLNumber LIKE 'UP1520090054348%';


question: Identify departments that have a staff strength greater than 50?
query: SELECT mst.DepartmentName,COUNT(emp.Id) AS EmployeeCount FROM emp.Employees emp
INNER JOIN mst.Department mst ON mst.Id = emp.DepartmentId
WHERE emp.University_Id = 1  AND emp.ActionStatusId = 1  
GROUP BY mst.DepartmentName
HAVING COUNT(emp.Id) > 50
ORDER BY EmployeeCount DESC;




question: is there any 2BHK set available
query:  SELECT *  FROM acom.vw_AccommodationAvailabilityList emp  WHERE  AllotmentStatusName='vacant' AND buildingTypeName='2-BHK'

question: show me the list of whose total RF is more than 1,00,000.
query: SELECT emp.Id AS EmployeeId,emp.EmployeeCode,emp.EmployeeName,SUM(ISNULL(FPT.RF, 0)) + ISNULL(RFO.OpeningBalance, 0) AS TotalRF FROM emp.FinalPayrollforTeaching FPT
INNER JOIN emp.vw_EmployeesList emp ON emp.Id = FPT.EmployeeId 
LEFT JOIN emp.RFIntrestForTeaching RFO  ON emp.Id = RFO.EmployeeId AND RFO.IsOpeningBal = 1  
WHERE emp.UniversityId=1 AND emp.ActionStatusId=1
GROUP BY emp.Id, emp.EmployeeCode, emp.EmployeeName,RFO.OpeningBalance
HAVING SUM(ISNULL(FPT.RF, 0)) + ISNULL(RFO.OpeningBalance, 0) > 100000;


