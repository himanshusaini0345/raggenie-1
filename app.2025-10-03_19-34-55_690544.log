            question: punch out time for himanshu saini of it department on 10 may
query: select e.EmployeeName, b.PunchMode,b.AttendanceDate 
from emp.bioattendance b
left join emp.vw_EmployeesList e on b.EmployeeId = e.Id 
where e.EmployeeName = 'himanshu saini'
and e.DepartmentName = 'information technology'
and cast(b.AttendanceDate as date) = '2025-05-10'
and b.PunchMode = 'out'

question: Please provide the attendance details of Mr. Yash.
query: SELECT A.EmployeeId, E.EmployeeName, E.FrontImage, E.DepartmentName, A.AttendanceDate, A.SiftIn, A.SiftOut, A.SiftTypeId, MBA.SiftName, RIGHT('0' + CAST(CASE WHEN A.SiftIn > (CAST(A.AttendanceDate AS DATETIME) + CAST(MBA.SiftIn AS DATETIME)) THEN DATEDIFF(MINUTE, CAST(A.AttendanceDate AS DATETIME) + CAST(MBA.SiftIn AS DATETIME), A.SiftIn) ELSE 0 END / 60 AS VARCHAR), 2) + ':' + RIGHT('0' + CAST(CASE WHEN A.SiftIn > (CAST(A.AttendanceDate AS DATETIME) + CAST(MBA.SiftIn AS DATETIME)) THEN DATEDIFF(MINUTE, CAST(A.AttendanceDate AS DATETIME) + CAST(MBA.SiftIn AS DATETIME), A.SiftIn) ELSE 0 END % 60 AS VARCHAR), 2) AS LateMins, RIGHT('0' + CAST(CASE WHEN A.SiftOut > (CAST(A.AttendanceDate AS DATETIME) + CAST(MBA.SiftOut AS DATETIME)) THEN DATEDIFF(MINUTE, CAST(A.AttendanceDate AS DATETIME) + CAST(MBA.SiftOut AS DATETIME), A.SiftOut) ELSE 0 END / 60 AS VARCHAR), 2) + ':' + RIGHT('0' + CAST(CASE WHEN A.SiftOut > (CAST(A.AttendanceDate AS DATETIME) + CAST(MBA.SiftOut AS DATETIME)) THEN DATEDIFF(MINUTE, CAST(A.AttendanceDate AS DATETIME) + CAST(MBA.SiftOut AS DATETIME), A.SiftOut) ELSE 0 END % 60 AS VARCHAR), 2) AS OTHours, RIGHT('0' + CAST(DATEDIFF(MINUTE, CASE WHEN A.SiftIn > (CAST(A.AttendanceDate AS DATETIME) + CAST(MBA.SiftIn AS DATETIME)) THEN A.SiftIn ELSE (CAST(A.AttendanceDate AS DATETIME) + CAST(MBA.SiftIn AS DATETIME)) END, CASE WHEN A.SiftOut < (CAST(A.AttendanceDate AS DATETIME) + CAST(MBA.SiftOut AS DATETIME)) THEN A.SiftOut ELSE (CAST(A.AttendanceDate AS DATETIME) + CAST(MBA.SiftOut AS DATETIME)) END) / 60 AS VARCHAR), 2) + ':' + RIGHT('0' + CAST(DATEDIFF(MINUTE, CASE WHEN A.SiftIn > (CAST(A.AttendanceDate AS DATETIME) + CAST(MBA.SiftIn AS DATETIME)) THEN A.SiftIn ELSE (CAST(A.AttendanceDate AS DATETIME) + CAST(MBA.SiftIn AS DATETIME)) END, CASE WHEN A.SiftOut < (CAST(A.AttendanceDate AS DATETIME) + CAST(MBA.SiftOut AS DATETIME)) THEN A.SiftOut ELSE (CAST(A.AttendanceDate AS DATETIME) + CAST(MBA.SiftOut AS DATETIME)) END) % 60 AS VARCHAR), 2) AS DutyHours FROM (SELECT BA.EmployeeId, CAST(BA.AttendanceDate AS DATE) AS AttendanceDate, MIN(CASE WHEN BA.PunchMode = 'In' THEN BA.AttendanceDate END) AS SiftIn, MAX(CASE WHEN BA.PunchMode = 'Out' THEN BA.AttendanceDate END) AS SiftOut, MIN(CASE WHEN BA.PunchMode = 'In' THEN BA.SiftTypeId END) AS SiftTypeId FROM emp.BioAttendance BA WHERE BA.EmployeeId IN (SELECT Id FROM emp.vw_EmployeesList WHERE EmployeeName LIKE 'yash%') AND CAST(BA.AttendanceDate AS DATE) BETWEEN '2025-06-01' AND '2025-06-18' GROUP BY BA.EmployeeId, CAST(BA.AttendanceDate AS DATE)) AS A INNER JOIN emp.vw_EmployeesList E ON A.EmployeeId = E.Id LEFT JOIN mst.BioAttSift MBA ON MBA.Id = A.SiftTypeId ORDER BY A.EmployeeId, A.AttendanceDate;


