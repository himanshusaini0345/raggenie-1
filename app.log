, DepartmentName, ', ', CollegeName), ': ') AS Relatives FROM emp.vw_RelativesList r WHERE r.EmployeeId = e.Id) AS rel WHERE LOWER(e.DepartmentName) LIKE LOWER('%pharmacy%') AND LOWER(e.EmployeeName) LIKE LOWER('%neeru%');\n", 'metadata': '', 'datasource': 'database_agent', 'config_id': 1}, 'score': 0.7339684963226318, 'distances': 0.26603150367736816}]
