': 'SFT:A8', 'LateMins': '00:00', 'OTHours': '00:15', 'DutyHours': '08:00'}, {'EmployeeId': 12818, 'EmployeeName': 'Anurag Goyal', 'FrontImage': '/Uploads/Employee/Profile/20240716150611.jpg', 'DepartmentName': 'INFORMATION TECHNOLOGY', 'AttendanceDate': '2025-09-09', 'SiftIn': '2025-09-09T08:01:00', 'SiftOut': '2025-09-09T18:03:00', 'SiftTypeId': 40, 'SiftName': 'SFT:A8', 'LateMins': '00:01', 'OTHours': '02:03', 'DutyHours': '07:59'}, {'EmployeeId': 12818, 'EmployeeName': 'Anurag Goyal', 'FrontImage': '/Uploads/Employee/Profile/20240716150611.jpg', 'DepartmentName': 'INFORMATION TECHNOLOGY', 'AttendanceDate': '2025-09-10', 'SiftIn': '2025-09-10T07:59:00', 'SiftOut': '2025-09-10T18:03:00', 'SiftTypeId': 40, 'SiftName': 'SFT:A8', 'LateMins': '00:00', 'OTHours': '02:03', 'DutyHours': '08:00'}, {'EmployeeId': 12818, 'EmployeeName': 'Anurag Goyal', 'FrontImage': '/Uploads/Employee/Profile/20240716150611.jpg', 'DepartmentName': 'INFORMATION TECHNOLOGY', 'AttendanceDate': '2025-09-11', 'SiftIn': '2025-09-11T08:00:00', 'SiftOut': '2025-09-11T16:18:00', 'SiftTypeId': 40, 'SiftName': 'SFT:A8', 'LateMins': '00:00', 'OTHours': '00:18', 'DutyHours': '08:00'}, {'EmployeeId': 12818, 'EmployeeName': 'Anurag Goyal', 'FrontImage': '/Uploads/Employee/Profile/20240716150611.jpg', 'DepartmentName': 'INFORMATION TECHNOLOGY', 'AttendanceDate': '2025-09-12', 'SiftIn': '2025-09-12T08:03:00', 'SiftOut': '2025-09-12T16:04:00', 'SiftTypeId': 40, 'SiftName': 'SFT:A8', 'LateMins': '00:03', 'OTHours': '00:04', 'DutyHours': '07:57'}, {'EmployeeId': 12818, 'EmployeeName': 'Anurag Goyal', 'FrontImage': '/Uploads/Employee/Profile/20240716150611.jpg', 'DepartmentName': 'INFORMATION TECHNOLOGY', 'AttendanceDate': '2025-09-13', 'SiftIn': '2025-09-13T08:00:00', 'SiftOut': '2025-09-13T16:06:00', 'SiftTypeId': 40, 'SiftName': 'SFT:A8', 'LateMins': '00:00', 'OTHours': '00:06', 'DutyHours': '08:00'}, {'EmployeeId': 12818, 'EmployeeName': 'Anurag Goyal', 'FrontImage': '/Uploads/Employee/Profile/20240716150611.jpg', 'DepartmentName': 'INFORMATION TECHNOLOGY', 'AttendanceDate': '2025-09-15', 'SiftIn': '2025-09-15T08:00:00', 'SiftOut': '2025-09-15T18:36:00', 'SiftTypeId': 40, 'SiftName': 'SFT:A8', 'LateMins': '00:00', 'OTHours': '02:36', 'DutyHours': '08:00'}, {'EmployeeId': 12818, 'EmployeeName': 'Anurag Goyal', 'FrontImage': '/Uploads/Employee/Profile/20240716150611.jpg', 'DepartmentName': 'INFORMATION TECHNOLOGY', 'AttendanceDate': '2025-09-16', 'SiftIn': '2025-09-16T08:00:00', 'SiftOut': '2025-09-16T18:12:00', 'SiftTypeId': 40, 'SiftName': 'SFT:A8', 'LateMins': '00:00', 'OTHours': '02:12', 'DutyHours': '08:00'}, {'EmployeeId': 12818, 'EmployeeName': 'Anurag Goyal', 'FrontImage': '/Uploads/Employee/Profile/20240716150611.jpg', 'DepartmentName': 'INFORMATION TECHNOLOGY', 'AttendanceDate': '2025-09-17', 'SiftIn': '2025-09-17T08:01:00', 'SiftOut': None, 'SiftTypeId': 40, 'SiftName': 'SFT:A8', 'LateMins': '00:01', 'OTHours': '00:00', 'DutyHours': '07:59'}], 'kind': 'list', 'main_entity': 'Employee Attendance', 'main_format': 'list', 'role': 'assistant', 'content': 'Here are the attendance details for Anurag Goyal.', 'context_id': '19271-20250917-104201-847', 'question': 'attendance of anurag goyal', 'query': "SELECT A.EmployeeId, E.EmployeeName, E.FrontImage, E.DepartmentName, A.AttendanceDate, A.SiftIn, A.SiftOut, A.SiftTypeId, MBA.SiftName, RIGHT('0' + CAST(CASE WHEN A.SiftIn > (CAST(A.AttendanceDate AS DATETIME) + CAST(MBA.SiftIn AS DATETIME)) THEN DATEDIFF(MINUTE, CAST(A.AttendanceDate AS DATETIME) + CAST(MBA.SiftIn AS DATETIME), A.SiftIn) ELSE 0 END / 60 AS VARCHAR), 2) + ':' + RIGHT('0' + CAST(CASE WHEN A.SiftIn > (CAST(A.AttendanceDate AS DATETIME) + CAST(MBA.SiftIn AS DATETIME)) THEN DATEDIFF(MINUTE, CAST(A.AttendanceDate AS DATETIME) + CAST(MBA.SiftIn AS DATETIME), A.SiftIn) ELSE 0 END % 60 AS VARCHAR), 2) AS LateMins, RIGHT('0' + CAST(CASE WHEN A.SiftOut > (CAST(A.AttendanceDate AS DATETIME) + CAST(MBA.SiftOut AS DATETIME)) THEN DATEDIFF(MINUTE, CAST(A.AttendanceDate AS DATETIME) + CAST(MBA.SiftOut AS DATETIME), A.SiftOut) ELSE 0 END / 60 AS VARCHAR), 2) + ':' + RIGHT('0' + CAST(CASE WHEN A.SiftOut > (CAST(A.AttendanceDate AS DATETIME) + CAST(MBA.SiftOut AS DATETIME)) THEN DATEDIFF(MINUTE, CAST(A.AttendanceDate AS DATETIME) + CAST(MBA.SiftOut AS DATETIME), A.SiftOut) ELSE 0 END % 60 AS VARCHAR), 2) AS OTHours, RIGHT('0' + CAST(DATEDIFF(MINUTE, CASE WHEN A.SiftIn > (CAST(A.AttendanceDate AS DATETIME) + CAST(MBA.SiftIn AS DATETIME)) THEN A.SiftIn ELSE (CAST(A.AttendanceDate AS DATETIME) + CAST(MBA.SiftIn AS DATETIME)) END, CASE WHEN A.SiftOut < (CAST(A.AttendanceDate AS DATETIME) + CAST(MBA.SiftOut AS DATETIME)) THEN A.SiftOut ELSE (CAST(A.AttendanceDate AS DATETIME) + CAST(MBA.SiftOut AS DATETIME)) END) / 60 AS VARCHAR), 2) + ':' + RIGHT('0' + CAST(DATEDIFF(MINUTE, CASE WHEN A.SiftIn > (CAST(A.AttendanceDate AS DATETIME) + CAST(MBA.SiftIn AS DATETIME)) THEN A.SiftIn ELSE (CAST(A.AttendanceDate AS DATETIME) + CAST(MBA.SiftIn AS DATETIME)) END, CASE WHEN A.SiftOut < (CAST(A.AttendanceDate AS DATETIME) + CAST(MBA.SiftOut AS DATETIME)) THEN A.SiftOut ELSE (CAST(A.AttendanceDate AS DATETIME) + CAST(MBA.SiftOut AS DATETIME)) END) % 60 AS VARCHAR), 2) AS DutyHours FROM (SELECT BA.EmployeeId, CAST(BA.AttendanceDate AS DATE) AS AttendanceDate, MIN(CASE WHEN BA.PunchMode = 'In' THEN BA.AttendanceDate END) AS SiftIn, MAX(CASE WHEN BA.PunchMode = 'Out' THEN BA.AttendanceDate END) AS SiftOut, MIN(CASE WHEN BA.PunchMode = 'In' THEN BA.SiftTypeId END) AS SiftTypeId FROM emp.BioAttendance BA WHERE BA.EmployeeId IN (SELECT Id FROM emp.vw_EmployeesList WHERE LOWER(EmployeeName) LIKE LOWER('%anurag goyal%')) AND CAST(BA.AttendanceDate AS DATE) BETWEEN DATEADD(DAY, -30, GETDATE()) AND GETDATE() GROUP BY BA.EmployeeId, CAST(BA.AttendanceDate AS DATE)) AS A INNER JOIN emp.vw_EmployeesList E ON A.EmployeeId = E.Id LEFT JOIN mst.BioAttSift MBA ON MBA.Id = A.SiftTypeId ORDER BY A.EmployeeId, A.AttendanceDate;", 'intent': 'database_agent', 'summary': "Anurag Goyal's attendance details are available from August 19, 2025, to September 17, 2025, with most days having 8 hours of duty and some variations in overtime hours."}
