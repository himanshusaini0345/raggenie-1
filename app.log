AST(AttendancePercentage AS float)) AS AverageAttendancePercentage FROM (SELECT BA.EmployeeId, EV.EmployeeName, COUNT(DISTINCT CAST(BA.AttendanceDate AS Date)) * 100.0 / (SELECT COUNT(DATEADD(DAY, number, DATEFROMPARTS(YEAR(GETDATE()), 5, 1))) FROM master..spt_values WHERE type = 'P' AND number BETWEEN 0 AND DAY(EOMONTH(DATEFROMPARTS(YEAR(GETDATE()), 5, 1))) - 1 AND DATENAME(WEEKDAY, DATEADD(DAY, number, DATEFROMPARTS(YEAR(GETDATE()), 5, 1))) <> 'Sunday' AND DATEADD(DAY, number, DATEFROMPARTS(YEAR(GETDATE()), 5, 1)) NOT IN (SELECT HolidayDate FROM mst.HolidayMaster)) AS AttendancePercentage FROM emp.BioAttendance BA INNER JOIN emp.vw_EmployeesList EV ON BA.EmployeeId = EV.Id WHERE LOWER(EV.DepartmentName) LIKE LOWER('%information technology%') AND EV.ActionStatusId = 1 AND CAST(BA.AttendanceDate AS Date) >= DATEFROMPARTS(YEAR(GETDATE()), 5, 1) AND CAST(BA.AttendanceDate AS Date) < DATEADD(MONTH, 1, DATEFROMPARTS(YEAR(GETDATE()), 5, 1)) GROUP BY BA.EmployeeId, EV.EmployeeName) AS AttendanceStats;\n", 'metadata': '', 'datasource': 'database_agent', 'config_id': 1}, 'score': 0.7953651547431946, 'distances': 0.20463484525680542}, {'_id': ObjectId('68ba6fd4ff185dae514dc98f'), 'document': 'how many employees were on leave in it department this month', 'metadatas': {'query': "SELECT ld.EmployeeId, ev.EmployeeName, ev.DepartmentName, ev.DesignationName, COUNT(*) AS LeavesTaken FROM emp.LeaveDateWiseDetails ld INNER JOIN emp.vw_EmployeesList ev ON ld.EmployeeId = ev.Id WHERE ev.DepartmentName LIKE '%information technology%' AND ld.LeaveDate BETWEEN '2025-06-01' AND GETDATE() AND ld.ActionStatusId = 4 AND ld.ApprovedActionStatusId = 4 GROUP BY ld.EmployeeId, ev.EmployeeName, ev.DepartmentName, ev.DesignationName;\n", 'metadata': '', 'datasource': 'database_agent', 'config_id': 1}, 'score': 0.7912309765815735, 'distances': 0.2087690234184265}, {'_id': ObjectId('68ba6fd4ff185dae514dc977'), 'document': 'show me the user profiles of all it employees', 'metadatas': {'query': "SELECT e.Id, e.TitleName, e.EmployeeName, e.FrontImage, e.FatherName, e.DesignationName, e.DepartmentName, e.JoiningDate, ISNULL(exp.Years, 0) AS WorkingExperience, ISNULL(lv.LeaveTaken, 0) AS LeaveTaken, e.Phone, ISNULL(rel.Relatives, '') AS Relatives FROM emp.vw_EmployeesList e LEFT JOIN (SELECT EmployeeId, SUM(DATEDIFF(DAY, JoiningDate, CASE WHEN LeavingDate IS NULL OR LeavingDate = '' OR LeavingDate = '1900-01-01' THEN CAST(GETDATE() AS DATE) ELSE LeavingDate END)) / 365 AS Years FROM emp.WorkingExperience GROUP BY EmployeeId) AS exp ON e.Id = exp.EmployeeId LEFT JOIN (SELECT EmployeeId, SUM(CASE WHEN IsHalf = 1 THEN 0.5 ELSE 1.0 END) AS LeaveTaken FROM emp.LeaveDateWiseDetails WHERE MONTH(LeaveDate) = MONTH(GETDATE()) AND YEAR(LeaveDate) = YEAR(GETDATE()) GROUP BY EmployeeId) AS lv ON e.Id = lv.EmployeeId OUTER APPLY (SELECT STRING_AGG(CONCAT(RelativeName, ', ', EmployeeName, ', ', DesignationName, ', ', DepartmentName, ', ', CollegeName), ': ') AS Relatives FROM emp.vw_RelativesList r WHERE r.EmployeeId = e.Id) AS rel WHERE LOWER(e.DepartmentName) LIKE LOWER('%information technology%');\n", 'metadata': '', 'datasource': 'database_agent', 'config_id': 1}, 'score': 0.7902331352233887, 'distances': 0.20976686477661133}, {'_id': ObjectId('68ba6fd4ff185dae514dc99d'), 'document': 'how many employees were on leave in it department for last month', 'metadatas': {'query': "SELECT ld.EmployeeId, ev.EmployeeName, ev.DepartmentName, ev.DesignationName, COUNT(*) AS LeavesTaken FROM emp.LeaveDateWiseDetails ld INNER JOIN emp.vw_EmployeesList ev ON ld.EmployeeId = ev.Id WHERE LOWER(ev.DepartmentName) LIKE '%information technology%' AND ld.LeaveDate >= CONVERT(varchar(10), DATEFROMPARTS(YEAR(GETDATE()), MONTH(DATEADD(MONTH, -1, GETDATE())), 1), 120) AND ld.LeaveDate <= CONVERT(varchar(10), EOMONTH(DATEADD(MONTH, -1, GETDATE())), 120) AND ld.ActionStatusId = 4 AND ld.ApprovedActionStatusId = 4 GROUP BY ld.EmployeeId, ev.EmployeeName, ev.DepartmentName, ev.DesignationName;", 'metadata': '', 'datasource': 'database_agent', 'config_id': 1}, 'score': 0.7865329384803772, 'distances': 0.2134670615196228}]
