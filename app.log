 INNER JOIN emp.VW_EmployeesList EMP ON BIO.EmployeeId=EMP.Id AND EMP.ActionStatusId=1
  WHERE EMP.EmployeeName LIKE 'Shivdatt%' AND CONVERT(DATE,BIO.AttendanceDate)=CONVERT(DATE, GETDATE())
 UNION ALL
