2025-09-18 14:54:47.193 | INFO     | app.chain.modules.cache_checker:handle:77 - out:[{'_id': ObjectId('68cbce52651c175b652023c9'), 'document': 'show the user profile of neeru singh in pharmacy department', 'metadatas': {'query': "SELECT e.Id, e.TitleName, e.EmployeeName, e.FrontImage, e.FatherName, e.DesignationName, e.DepartmentName, e.JoiningDate, ISNULL(exp.Years, 0) AS WorkingExperience, ISNULL(lv.LeaveTaken, 0) AS LeaveTaken, e.Phone, ISNULL(rel.Relatives, '') AS Relatives FROM emp.vw_EmployeesList e LEFT JOIN (SELECT EmployeeId, SUM(DATEDIFF(DAY, JoiningDate, CASE WHEN LeavingDate IS NULL OR LeavingDate = '' OR LeavingDate = '1900-01-01' THEN CAST(GETDATE() AS DATE) ELSE LeavingDate END)) / 365 AS Years FROM emp.WorkingExperience GROUP BY EmployeeId) AS exp ON e.Id = exp.EmployeeId LEFT JOIN (SELECT EmployeeId, SUM(CASE WHEN IsHalf = 1 THEN 0.5 ELSE 1.0 END) AS LeaveTaken FROM emp.LeaveDateWiseDetails WHERE MONTH(LeaveDate) = MONTH(GETDATE()) AND YEAR(LeaveDate) = YEAR(GETDATE()) GROUP BY EmployeeId) AS lv ON e.Id = lv.EmployeeId OUTER APPLY (SELECT STRING_AGG(CONCAT(RelativeName, ', ', EmployeeName, ', ', DesignationName, ', ', DepartmentName, ', ', CollegeName), ': ') AS Relatives FROM emp.vw_RelativesList r WHERE r.EmployeeId = e.Id) AS rel WHERE LOWER(e.DepartmentName) LIKE LOWER('%pharmacy%') AND LOWER(e.EmployeeName) LIKE LOWER('%neeru%');\n", 'metadata': '', 'datasource': 'database_agent', 'config_id': 1}, 'score': 0.7398168444633484, 'distances': 0.2601831555366516}, {'_id': ObjectId('68cbce51651c175b65202329'), 'document': 'show me the PAN card/Aadhaar card/Passport of Mr. amil shaji.', 'metadatas': {'query': "SELECT DD.EmployeeId,emp.EmployeeName,DD.Id,DT.DocumentTypeName,DD.EmployeeDocumentTypeId,DD.FilePath,DD.FileName,DD.FileType,DD.ActionStatusId FROM emp.DocumentDetails  DD\nINNER JOIN mst.EmployeeDocumentType  DT ON DD.EmployeeDocumentTypeId=DT.Id \nINNER JOIN emp.Employees emp ON emp.Id=DD.EmployeeId AND emp.ActionStatusId=1 AND emp.University_Id=1\nWHERE  DD.ActionStatusId=1  AND EmployeeName LIKE 'amil shaji%' AND (DT.DocumentTypeName LIKE'%PAN card%' OR DT.DocumentTypeName LIKE'%Aadhaar card%' OR DT.DocumentTypeName LIKE'%Passport%') \nORDER BY  DD.EmployeeId", 'metadata': '', 'datasource': 'database_agent', 'config_id': 1}, 'score': 0.7384883761405945, 'distances': 0.2615116238594055}]
