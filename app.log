query: SELECT ld.EmployeeId, ev.EmployeeName, ev.DepartmentName, ev.DesignationName, COUNT(*) AS LeavesTaken FROM emp.LeaveDateWiseDetails ld INNER JOIN emp.vw_EmployeesList ev ON ld.EmployeeId = ev.Id WHERE ev.DepartmentName LIKE '%information technology%' AND ld.LeaveDate BETWEEN '2025-06-01' AND GETDATE() AND ld.ActionStatusId = 4 AND ld.ApprovedActionStatusId = 4 GROUP BY ld.EmployeeId, ev.EmployeeName, ev.DepartmentName, ev.DesignationName;


