            question: How many employees have joined in Information of Technology Department of Subharti University this month?
query: SELECT Id,JobName,DesignationName,DepartmentName,EmployeeName,FatherName,MobileNo,JoiningDate FROM emp.VW_EmployeesList
WHERE JoiningDate >= DATEFROMPARTS(YEAR(GETDATE()), MONTH(GETDATE()), 1) AND DepartmentName LIKE 'Information Technology' ORDER BY JoiningDate

question: How many employees are on leave in the Information Technology department Today?
query: SELECT LEA.EmployeeId,EMP.EmployeeName,EMP.FatherName,EMP.DesignationName,EMP.DepartmentName,LEA.LeaveDate FROM [emp].[LeaveDateWiseDetails] LEA
INNER JOIN emp.vw_EmployeesList EMP ON LEA.EmployeeId=EMP.Id
WHERE EMP.DepartmentName LIKE 'Information%' AND LEA.ActionStatusId=9 AND (LEA.ReptActionStatusId=9 OR LEA.ReptActionStatusId=12 OR LEA.RecomActionStatusId=9 OR LEA.RecomActionStatusId=12 OR 
LEA.ApprovedEmployeeId=8 OR LEA.ApprovedEmployeeId=12) AND CONVERT(DATE,LEA.LeaveDate)=CONVERT(date, GETDATE())
ORDER BY EMP.Id

question: show me the list of IT department with their name
query: SELECT Id, DepartmentName FROM mst.Department WHERE LOWER(DepartmentName) LIKE LOWER('%information technology%')

question: How many employees were on leave in the Information Technology department yesterday?
