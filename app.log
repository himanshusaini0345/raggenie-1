iveName, ', ', EmployeeName, ', ', DesignationName, ', ', DepartmentName, ', ', CollegeName), ': ') AS Relatives FROM emp.vw_RelativesList r WHERE r.EmployeeId = e.Id) AS rel WHERE LOWER(e.DepartmentName) LIKE LOWER('%information technology%');\n", 'metadata': '', 'datasource': 'database_agent', 'config_id': 1}, 'score': 0.756442666053772, 'distances': 0.24355733394622803}, {'_id': ObjectId('68df81f09f6ab1f4e510ac50'), 'document': 'Which employees in the IT department have resigned within the last three months?', 'metadatas': {'query': "select EmployeeName, UpdateDate as ResignationDate from emp.employees where UpdateDate > DateAdd(Month, -3, GetDate())and ActionStatusId = 2 and DepartmentId = (select top 1 Id from mst.Department where DepartmentName like 'information technology%') ", 'metadata': '', 'datasource': 'database_agent', 'config_id': 1}, 'score': 0.7523854970932007, 'distances': 0.24761450290679932}, {'_id': ObjectId('68df81f09f6ab1f4e510abd0'), 'document': 'provide the list of employee under ESI?', 'metadatas': {'query': "select e.EmployeeName ,e.FatherName ,e.DepartmentName ,e.DesignationName,p.ESICode  ,p.ESINo   from emp.vw_EmployeesList e\ninner join emp.[EmployeePFESIUNNO] p on e.Id = p.EmployeeId \nwhere p.ESINo  <> ''", 'metadata': '', 'datasource': 'database_agent', 'config_id': 1}, 'score': 0.7501881122589111, 'distances': 0.24981188774108887}, {'_id': ObjectId('68df81f09f6ab1f4e510ac47'), 'document': 'show me the list of IT department with their name', 'metadatas': {'query': "SELECT Id, DepartmentName FROM mst.Department WHERE LOWER(DepartmentName) LIKE LOWER('%information technology%')", 'metadata': '', 'datasource': 'database_agent', 'config_id': 1}, 'score': 0.7469427585601807, 'distances': 0.25305724143981934}]
