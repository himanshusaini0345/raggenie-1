ata': '', 'datasource': 'database_agent', 'config_id': 1}, 'score': 0.5976731181144714, 'distances': 0.40232688188552856}, {'_id': ObjectId('68c90109aed45539f3ce295f'), 'document': 'How many times did Shivdatt come late to the office last month?', 'metadatas': {'query': "SELECT BIO.EmployeeId,BIO.AttendanceDate,EMP.JobName,EMP.JobName,EMP.EmployeeName,EMP.FatherName,EMP.DesignationName,EMP.DepartmentName,COUNT(*) OVER()LateCount  FROM emp.BioAttendance BIO\nINNER JOIN emp.vw_EmployeesList EMP ON BIO.EmployeeId=EMP.Id\nINNER JOIN mst.BioAttSift BS ON BS.Id=BIO.SiftTypeId \nWHERE BIO.EmployeeId=2972 AND CONVERT(varchar(5), BIO.AttendanceDate, 108) > BS.SiftIn \nAND BIO.AttendanceDate >= DATEADD(MONTH, -1, DATEFROMPARTS(YEAR(GETDATE()), MONTH(GETDATE()), 1))\nAND BIO.AttendanceDate < DATEFROMPARTS(YEAR(GETDATE()), MONTH(GETDATE()), 1) AND BIO.PunchMode='IN'\nORDER BY BIO.Id ", 'metadata': '', 'datasource': 'database_agent', 'config_id': 1}, 'score': 0.5906566977500916, 'distances': 0.40934330224990845}, {'_id': ObjectId('68c90109aed45539f3ce28f5'), 'document': 'show me the list of whose total RF is more than 1,00,000.', 'metadatas': {'query': 'SELECT emp.Id AS EmployeeId,emp.EmployeeCode,emp.EmployeeName,SUM(ISNULL(FPT.RF, 0)) + ISNULL(RFO.OpeningBalance, 0) AS TotalRF FROM emp.FinalPayrollforTeaching FPT\nINNER JOIN emp.vw_EmployeesList emp ON emp.Id = FPT.EmployeeId \nLEFT JOIN emp.RFIntrestForTeaching RFO  ON emp.Id = RFO.EmployeeId AND RFO.IsOpeningBal = 1  \nWHERE emp.UniversityId=1 AND emp.ActionStatusId=1\nGROUP BY emp.Id, emp.EmployeeCode, emp.EmployeeName,RFO.OpeningBalance\nHAVING SUM(ISNULL(FPT.RF, 0)) + ISNULL(RFO.OpeningBalance, 0) > 100000;', 'metadata': '', 'datasource': 'database_agent', 'config_id': 1}, 'score': 0.5845369100570679, 'distances': 0.41546308994293213}]
