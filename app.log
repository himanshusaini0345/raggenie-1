            question: show me the list of IT department with the staff names
query: SELECT Id, EmployeeName, DepartmentName FROM emp.vw_EmployeesList WHERE LOWER(DepartmentName) LIKE LOWER('%information technology%')

question: show me the list of IT department with their name
query: SELECT Id, DepartmentName FROM mst.Department WHERE LOWER(DepartmentName) LIKE LOWER('%information technology%')

question: list of those employee which designation is software developer and working in MS Office?
query: SELECT EmployeeCode, EmployeeName, DepartmentName, DesignationName FROM emp.vw_EmployeesList WHERE LOWER(DesignationName) LIKE LOWER('%software developer%') AND LOWER(DepartmentName) LIKE LOWER('%M.S.OFFICE%')

question: Which employees in the IT department have resigned within the last three months?
query: select EmployeeName, UpdateDate as ResignationDate from emp.employees where UpdateDate > DateAdd(Month, -3, GetDate())and ActionStatusId = 2 and DepartmentId = (select top 1 Id from mst.Department where DepartmentName like 'information technology%') 

question: Please provide the details of employees whose state name is Uttar Pradesh.
query: SELECT EAD.EmployeeId,EMP.JobName,EMP.DesignationName,EMP.DepartmentName,EMP.EmployeeName,EMP.FatherName,EAD.CityName FROM emp.VW_EmployeesList EMP 
INNER JOIN [emp].[vw_EmployeesAddressList] EAD ON EMP.Id=EAD.EmployeeId
WHERE EAD.StateName LIKE 'Uttar Pradesh'

question: provide the refrence by employee list?
query: "
SELECT  EMP.Id,EMP.EmployeeName,EMP.FatherName,EMP.DesignationName, EMP.DepartmentName,EMP.CollegeName,REMP.Id,REMP.EmployeeName ReferedEmployeeName,REMP.FatherName ReferedFatherName,
REMP.DesignationName ReferedDesignationName,REMP.DepartmentName ReferedDepartmentName,REMP.CollegeName ReferedCollegeName FROm emp.vw_EmployeesList EMP
 INNER JOIN emp.vw_EmployeesList REMP ON EMP.ReferedbyId=REMP.Id AND EMP.ActionStatusId=1 
WHERE EMP.UniversityId=1 AND  EMP.ActionStatusId=1  
ORDER BY REMP.JobName,REMP.EmployeeName"


