            question: teachers with less than 5 leaves remaining and have taken a leave in the past 3 months
query: SELECT 
    el.EmployeeName,
    t.BalanceLeave,
    COUNT(ld.Id) AS LeavesTakenInLast3Months
FROM emp.TeachingLeaveBalance t
INNER JOIN emp.vw_EmployeesList el ON t.EmployeeId = el.Id
LEFT JOIN emp.LeaveDateWiseDetails ld ON t.EmployeeId = ld.EmployeeId
    AND ld.LeaveDate >= DATEADD(MONTH, -3, GETDATE()) AND ld.ActionStatusId = 9
WHERE t.BalanceLeave < 5
GROUP BY el.EmployeeName, t.BalanceLeave
ORDER BY LeavesTakenInLast3Months DESC;

question: how many employee in teaching leave the transport service in march 2025 month?
query: SELECT PCL.Id AS PayCycleId, PCL.PayCycleName, COUNT(FPT.EmployeeId) AS EmployeesLeftTransport FROM emp.FinalPayrollforTeaching FPT 
INNER JOIN mst.PayCycle PCL ON FPT.PayCycleId = PCL.Id WHERE PCL.PayCycleName LIKE '%Mar 2025%' AND FPT.TransportationCharge = 0 and EmployeeId  NOT IN(select EmployeeId FRom emp.FinalPayrollforTeaching where PayCycleName NOT Like '%Mar 2025%') GROUP BY PCL.Id, PCL.PayCycleName;

question: show me leave requests of employees in may
query: SELECT l.Id, l.ApplicationNo, l.EmployeeId, e.EmployeeName, l.LeaveTypeId, l.LeaveDate, l.ActionStatusId FROM emp.LeaveDateWiseDetails l INNER JOIN emp.vw_EmployeesList e ON l.EmployeeId = e.Id WHERE MONTH(l.LeaveDate) = 5 AND YEAR(l.LeaveDate) = YEAR(GETDATE())

question: how many staff were on leave today
query: SELECT LEA.EmployeeId, EMP.EmployeeName, EMP.DepartmentName, EMP.DesignationName, EMP.CollegeName FROM emp.[LeaveDateWiseDetails] LEA INNER JOIN emp.vw_EmployeesList EMP ON LEA.EmployeeId = EMP.Id WHERE LEA.ActionStatusId = 9 AND LEA.ApprovedActionStatusId = 8 AND CONVERT(DATE, LEA.LeaveDate) = CONVERT(DATE, GETDATE())

question: how many staff were on leave today
query: SELECT  *FROM  emp.[LeaveDateWiseDetails] Where ActionStatusId=9 AND ApprovedActionStatusId=8 AND LeaveDate=CONVERT(DATE,GETDATE())

