INNER JOIN mst.ActionStatus  ATS ON ATS.Id=TH.ActionStatusId  
Where ATS.StatusName LIKE'%pending%' AND TD.DepartmentName LIKE '%House Service%'

question: list the pending complaints from the House Service department.
query: SELECT  *FROM  emp.TicketingHead TH   
INNER JOIN mst.TicketingDepartment  TD ON TD.Id=TH.TicketingDepartmentId    
INNER JOIN mst.ActionStatus  ATS ON ATS.Id=TH.ActionStatusId  
Where ATS.StatusName LIKE'%pending%' AND TD.DepartmentName LIKE '%House Service%'  

question: pending complaints of plumbing in june
query: SELECT TH.TokenNo, TH.Subject FROM emp.TicketingHead TH INNER JOIN mst.TicketingSubDepartment TD ON TD.Id = TH.TicketingSubDepartmentId INNER JOIN mst.ActionStatus ATS ON ATS.Id = TH.ActionStatusId WHERE LOWER(ATS.StatusName) LIKE '%pending%' AND LOWER(TD.SubDepartmentName) LIKE '%plumbing%' AND MONTH(TH.CreateDate) = 6

question: What plumbing complaints remain unresolved in June?
query: SELECT TH.TokenNo, TH.Subject FROM emp.TicketingHead TH INNER JOIN mst.TicketingSubDepartment TD ON TD.Id = TH.TicketingSubDepartmentId INNER JOIN mst.ActionStatus ATS ON ATS.Id = TH.ActionStatusId WHERE LOWER(ATS.StatusName) LIKE '%pending%' AND LOWER(TD.SubDepartmentName) LIKE '%plumbing%' AND MONTH(TH.CreateDate) = 6

question: who all staff have not uploaded their Aadhaar card?
query: 
SELECT  *FROM  emp.[Employees]    
Where LocationId=1 AND ActionStatusId=1  
AND Id NOT IN(SELECT DISTINCT EmployeeId FROM emp.DocumentDetails WHERE  ActionStatusId=1 AND EmployeeDocumentTypeId   IN(1,3))


