utyHours': '08:00'}, {'EmployeeId': 3125, 'EmployeeName': 'ROOP SINGH', 'FrontImage': '/Uploads/Employee/Profile/20250130083714.jpg', 'DepartmentName': 'INFORMATION TECHNOLOGY', 'AttendanceDate': '2025-09-10', 'SiftIn': '2025-09-10T07:57:00', 'SiftOut': '2025-09-10T18:04:00', 'SiftTypeId': 40, 'SiftName': 'SFT:A8', 'LateMins': '00:00', 'OTHours': '02:04', 'DutyHours': '08:00'}, {'EmployeeId': 3125, 'EmployeeName': 'ROOP SINGH', 'FrontImage': '/Uploads/Employee/Profile/20250130083714.jpg', 'DepartmentName': 'INFORMATION TECHNOLOGY', 'AttendanceDate': '2025-09-11', 'SiftIn': '2025-09-11T07:58:00', 'SiftOut': '2025-09-11T18:11:00', 'SiftTypeId': 40, 'SiftName': 'SFT:A8', 'LateMins': '00:00', 'OTHours': '02:11', 'DutyHours': '08:00'}, {'EmployeeId': 3125, 'EmployeeName': 'ROOP SINGH', 'FrontImage': '/Uploads/Employee/Profile/20250130083714.jpg', 'DepartmentName': 'INFORMATION TECHNOLOGY', 'AttendanceDate': '2025-09-12', 'SiftIn': '2025-09-12T08:00:00', 'SiftOut': '2025-09-12T18:15:00', 'SiftTypeId': 40, 'SiftName': 'SFT:A8', 'LateMins': '00:00', 'OTHours': '02:15', 'DutyHours': '08:00'}], 'main_entity': 'attendance', 'main_format': 'aggregation', 'role': 'assistant', 'content': 'Here are the attendance details of Roop Singh.', 'context_id': '19271-20250917-104201-847', 'question': 'attendance of roop singh', 'query': "SELECT A.EmployeeId, E.EmployeeName, E.FrontImage, E.DepartmentName, A.AttendanceDate, A.SiftIn, A.SiftOut, A.SiftTypeId, MBA.SiftName, RIGHT('0' + CAST(CASE WHEN A.SiftIn > (CAST(A.AttendanceDate AS DATETIME) + CAST(MBA.SiftIn AS DATETIME)) THEN DATEDIFF(MINUTE, CAST(A.AttendanceDate AS DATETIME) + CAST(MBA.SiftIn AS DATETIME), A.SiftIn) ELSE 0 END / 60 AS VARCHAR), 2) + ':' + RIGHT('0' + CAST(CASE WHEN A.SiftIn > (CAST(A.AttendanceDate AS DATETIME) + CAST(MBA.SiftIn AS DATETIME)) THEN DATEDIFF(MINUTE, CAST(A.AttendanceDate AS DATETIME) + CAST(MBA.SiftIn AS DATETIME), A.SiftIn) ELSE 0 END % 60 AS VARCHAR), 2) AS LateMins, RIGHT('0' + CAST(CASE WHEN A.SiftOut > (CAST(A.AttendanceDate AS DATETIME) + CAST(MBA.SiftOut AS DATETIME)) THEN DATEDIFF(MINUTE, CAST(A.AttendanceDate AS DATETIME) + CAST(MBA.SiftOut AS DATETIME), A.SiftOut) ELSE 0 END / 60 AS VARCHAR), 2) + ':' + RIGHT('0' + CAST(CASE WHEN A.SiftOut > (CAST(A.AttendanceDate AS DATETIME) + CAST(MBA.SiftOut AS DATETIME)) THEN DATEDIFF(MINUTE, CAST(A.AttendanceDate AS DATETIME) + CAST(MBA.SiftOut AS DATETIME), A.SiftOut) ELSE 0 END % 60 AS VARCHAR), 2) AS OTHours, RIGHT('0' + CAST(DATEDIFF(MINUTE, CASE WHEN A.SiftIn > (CAST(A.AttendanceDate AS DATETIME) + CAST(MBA.SiftIn AS DATETIME)) THEN A.SiftIn ELSE (CAST(A.AttendanceDate AS DATETIME) + CAST(MBA.SiftIn AS DATETIME)) END, CASE WHEN A.SiftOut < (CAST(A.AttendanceDate AS DATETIME) + CAST(MBA.SiftOut AS DATETIME)) THEN A.SiftOut ELSE (CAST(A.AttendanceDate AS DATETIME) + CAST(MBA.SiftOut AS DATETIME)) END) / 60 AS VARCHAR), 2) + ':' + RIGHT('0' + CAST(DATEDIFF(MINUTE, CASE WHEN A.SiftIn > (CAST(A.AttendanceDate AS DATETIME) + CAST(MBA.SiftIn AS DATETIME)) THEN A.SiftIn ELSE (CAST(A.AttendanceDate AS DATETIME) + CAST(MBA.SiftIn AS DATETIME)) END, CASE WHEN A.SiftOut < (CAST(A.AttendanceDate AS DATETIME) + CAST(MBA.SiftOut AS DATETIME)) THEN A.SiftOut ELSE (CAST(A.AttendanceDate AS DATETIME) + CAST(MBA.SiftOut AS DATETIME)) END) % 60 AS VARCHAR), 2) AS DutyHours FROM (SELECT BA.EmployeeId, CAST(BA.AttendanceDate AS DATE) AS AttendanceDate, MIN(CASE WHEN BA.PunchMode = 'In' THEN BA.AttendanceDate END) AS SiftIn, MAX(CASE WHEN BA.PunchMode = 'Out' THEN BA.AttendanceDate END) AS SiftOut, MIN(CASE WHEN BA.PunchMode = 'In' THEN BA.SiftTypeId END) AS SiftTypeId FROM emp.BioAttendance BA WHERE BA.EmployeeId IN (SELECT Id FROM emp.vw_EmployeesList WHERE LOWER(EmployeeName) LIKE LOWER('%roop singh%')) AND CAST(BA.AttendanceDate AS DATE) BETWEEN DATEADD(DAY, -30, GETDATE()) AND GETDATE() GROUP BY BA.EmployeeId, CAST(BA.AttendanceDate AS DATE)) AS A INNER JOIN emp.vw_EmployeesList E ON A.EmployeeId = E.Id LEFT JOIN mst.BioAttSift MBA ON MBA.Id = A.SiftTypeId ORDER BY A.EmployeeId, A.AttendanceDate;", 'intent': 'database_agent', 'summary': "Roop Singh's attendance details are available from August 19, 2025, to September 12, 2025, with most days having 8 hours of duty and some variations in overtime hours."}
