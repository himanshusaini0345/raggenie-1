            question: How many employees have joined in Information of Technology Department of Subharti University this month?
query: SELECT Id,JobName,DesignationName,DepartmentName,EmployeeName,FatherName,MobileNo,JoiningDate FROM emp.VW_EmployeesList
WHERE JoiningDate >= DATEFROMPARTS(YEAR(GETDATE()), MONTH(GETDATE()), 1) AND DepartmentName LIKE 'Information Technology' ORDER BY JoiningDate

question: show me the list of IT department with the staff names
query: SELECT Id, EmployeeName, DepartmentName FROM emp.vw_EmployeesList WHERE LOWER(DepartmentName) LIKE LOWER('%information technology%')

question: show me the list of IT department with their name
query: SELECT Id, DepartmentName FROM mst.Department WHERE LOWER(DepartmentName) LIKE LOWER('%information technology%')

question: Which departments have more than 100 employees?
query: SELECT mst.DepartmentName,COUNT(emp.Id) AS EmployeeCount FROM emp.Employees emp
INNER JOIN mst.Department mst ON mst.Id = emp.DepartmentId
WHERE emp.University_Id = 1  AND emp.ActionStatusId = 1  
GROUP BY mst.DepartmentName
HAVING COUNT(emp.Id) > 100
ORDER BY EmployeeCount DESC;

question: give me the department name where number of employees are more than 100
query: SELECT mst.DepartmentName,COUNT(emp.Id) AS EmployeeCount FROM emp.Employees emp
INNER JOIN mst.Department mst ON mst.Id = emp.DepartmentId
WHERE emp.University_Id = 1  AND emp.ActionStatusId = 1  
GROUP BY mst.DepartmentName
HAVING COUNT(emp.Id) > 100
ORDER BY EmployeeCount DESC;


