y_Id=1\nWHERE  DD.ActionStatusId=1  AND EmployeeName LIKE 'amil shaji%' AND (DT.DocumentTypeName LIKE'%PAN card%' OR DT.DocumentTypeName LIKE'%Aadhaar card%' OR DT.DocumentTypeName LIKE'%Passport%') \nORDER BY  DD.EmployeeId", 'metadata': '', 'datasource': 'database_agent', 'config_id': 1}, 'score': 0.7384883761405945, 'distances': 0.2615116238594055}]
