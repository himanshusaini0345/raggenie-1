            question: What is the average attendance percentage recorded for all employees in IT department in May?
query: SELECT AVG(CAST(AttendancePercentage AS float)) AS AverageAttendancePercentage FROM (SELECT BA.EmployeeId, EV.EmployeeName, COUNT(DISTINCT CAST(BA.AttendanceDate AS Date)) * 100.0 / (SELECT COUNT(DATEADD(DAY, number, DATEFROMPARTS(YEAR(GETDATE()), 5, 1))) FROM master..spt_values WHERE type = 'P' AND number BETWEEN 0 AND DAY(EOMONTH(DATEFROMPARTS(YEAR(GETDATE()), 5, 1))) - 1 AND DATENAME(WEEKDAY, DATEADD(DAY, number, DATEFROMPARTS(YEAR(GETDATE()), 5, 1))) <> 'Sunday' AND DATEADD(DAY, number, DATEFROMPARTS(YEAR(GETDATE()), 5, 1)) NOT IN (SELECT HolidayDate FROM mst.HolidayMaster)) AS AttendancePercentage FROM emp.BioAttendance BA INNER JOIN emp.vw_EmployeesList EV ON BA.EmployeeId = EV.Id WHERE LOWER(EV.DepartmentName) LIKE LOWER('%information technology%') AND EV.ActionStatusId = 1 AND CAST(BA.AttendanceDate AS Date) >= DATEFROMPARTS(YEAR(GETDATE()), 5, 1) AND CAST(BA.AttendanceDate AS Date) < DATEADD(MONTH, 1, DATEFROMPARTS(YEAR(GETDATE()), 5, 1)) GROUP BY BA.EmployeeId, EV.EmployeeName) AS AttendanceStats;


question: provide the refrence by employee list?
query: "
SELECT  EMP.Id,EMP.EmployeeName,EMP.FatherName,EMP.DesignationName, EMP.DepartmentName,EMP.CollegeName,REMP.Id,REMP.EmployeeName ReferedEmployeeName,REMP.FatherName ReferedFatherName,
REMP.DesignationName ReferedDesignationName,REMP.DepartmentName ReferedDepartmentName,REMP.CollegeName ReferedCollegeName FROm emp.vw_EmployeesList EMP
 INNER JOIN emp.vw_EmployeesList REMP ON EMP.ReferedbyId=REMP.Id AND EMP.ActionStatusId=1 
WHERE EMP.UniversityId=1 AND  EMP.ActionStatusId=1  
ORDER BY REMP.JobName,REMP.EmployeeName"

question: show me the list of IT department with the staff names
query: SELECT Id, EmployeeName, DepartmentName FROM emp.vw_EmployeesList WHERE LOWER(DepartmentName) LIKE LOWER('%information technology%')

question: Show me departments with employee numbers greater than 100.
query: SELECT mst.DepartmentName,COUNT(emp.Id) AS EmployeeCount FROM emp.Employees emp
INNER JOIN mst.Department mst ON mst.Id = emp.DepartmentId
WHERE emp.University_Id = 1  AND emp.ActionStatusId = 1  
GROUP BY mst.DepartmentName
HAVING COUNT(emp.Id) > 100
ORDER BY EmployeeCount DESC;

question: List all employees whose age is less than 50.
query: SELECT 
    Id, 
    EmployeeName, 
    UserDOB, 
    DATEDIFF(YEAR, TRY_CAST(UserDOB AS date), GETDATE()) AS Age 
FROM 
    emp.vw_EmployeesList 
WHERE 
    ActionStatusId = 1 
    AND DATEDIFF(YEAR, TRY_CAST(UserDOB AS date), GETDATE()) < 50;


