            question: Can you provide the count of teaching employees who worked in April?
query: SELECT Count(*) AS EmployeeCount FROM emp.employees e INNER JOIN mst.Designation dgn ON e.DesignationId = dgn.Id INNER JOIN mst.JobType jt ON dgn.JobTypeId = jt.Id WHERE jt.JobName = 'teaching' AND e.ActionStatusId = 1 AND EXISTS (SELECT 1 FROM emp.BioAttendanceTeaching ba WHERE ba.EmployeeId = e.Id AND ba.AttendanceDate >= '2025-04-01' AND ba.AttendanceDate < '2025-05-01');


question: regularized employee list for teaching department wise
query: SELECT  EmployeeName,FatherName,DesignationName,JobName,DepartmentName,CollegeName,RegularizedStatus,  GenderName
FROm emp.vw_EmployeesList WHERE UniversityId=1 AND  ActionStatusId=1 AND ISNULL(RegularizedStatusId,0)=21 AND JobName LIKE 'TEACHING%'
ORDER BY DepartmentName

question: Number of teaching staff members who were on duty in April?
query: SELECT Count(*) AS EmployeeCount FROM emp.employees e INNER JOIN mst.Designation dgn ON e.DesignationId = dgn.Id INNER JOIN mst.JobType jt ON dgn.JobTypeId = jt.Id WHERE jt.JobName = 'teaching' AND e.ActionStatusId = 1 AND EXISTS (SELECT 1 FROM emp.BioAttendanceTeaching ba WHERE ba.EmployeeId = e.Id AND ba.AttendanceDate >= '2025-04-01' AND ba.AttendanceDate < '2025-05-01');


