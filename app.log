anceDate AS DATETIME) + CAST(MBA.SiftOut AS DATETIME)) THEN A.SiftOut ELSE (CAST(A.AttendanceDate AS DATETIME) + CAST(MBA.SiftOut AS DATETIME)) END) / 60 AS VARCHAR), 2) + ':' + RIGHT('0' + CAST(DATEDIFF(MINUTE, CASE WHEN A.SiftIn > (CAST(A.AttendanceDate AS DATETIME) + CAST(MBA.SiftIn AS DATETIME)) THEN A.SiftIn ELSE (CAST(A.AttendanceDate AS DATETIME) + CAST(MBA.SiftIn AS DATETIME)) END, CASE WHEN A.SiftOut < (CAST(A.AttendanceDate AS DATETIME) + CAST(MBA.SiftOut AS DATETIME)) THEN A.SiftOut ELSE (CAST(A.AttendanceDate AS DATETIME) + CAST(MBA.SiftOut AS DATETIME)) END) % 60 AS VARCHAR), 2) AS DutyHours FROM (SELECT BA.EmployeeId, CAST(BA.AttendanceDate AS DATE) AS AttendanceDate, MIN(CASE WHEN BA.PunchMode = 'In' THEN BA.AttendanceDate END) AS SiftIn, MAX(CASE WHEN BA.PunchMode = 'Out' THEN BA.AttendanceDate END) AS SiftOut, MIN(CASE WHEN BA.PunchMode = 'In' THEN BA.SiftTypeId END) AS SiftTypeId FROM emp.BioAttendance BA WHERE BA.EmployeeId IN (SELECT Id FROM emp.vw_EmployeesList WHERE EmployeeName LIKE 'vvvv ttt%') AND CAST(BA.AttendanceDate AS DATE) BETWEEN '2025-06-01' AND '2025-06-18' GROUP BY BA.EmployeeId, CAST(BA.AttendanceDate AS DATE)) AS A INNER JOIN emp.vw_EmployeesList E ON A.EmployeeId = E.Id LEFT JOIN mst.BioAttSift MBA ON MBA.Id = A.SiftTypeId ORDER BY A.EmployeeId, A.AttendanceDate;", 'metadata': '', 'datasource': 'database_agent', 'config_id': 1}, 'score': 0.7270676493644714, 'distances': 0.27293235063552856}, {'_id': ObjectId('68e888748035f3d97a682b78'), 'document': 'show me the list of staff who is having salary belween 30000 to 50000', 'metadatas': {'query': '"SELECT *FROM (SELECT FPN.EmployeeId,FPN.EmployeeName,FPN.FatherName,FPN.DesignationName,FPN.DepartmentName,FPN.PayCycleId,FPN.PayCycleName,FCLY.FinancialYearName,JobName,FPN.CurrentBasicSalary\nFROM emp.FinalPayrollforNONTeaching FPN\nINNER JOIN mst.PayCycle PCL ON FPN.PayCycleId = PCL.Id AND PCL.IsDefaltForPayRoll = 1 \nINNER JOIN mst.FinancialYear FCLY ON FCLY.Id = PCL.FinancialYearId AND FCLY.IsDefaultLeave = 1  \nUNION ALL \nSELECT FPN.EmployeeId,FPN.EmployeeName,FPN.FatherName,FPN.DesignationName,FPN.DepartmentName,FPN.PayCycleId,FPN.PayCycleName,FCLY.FinancialYearName,JobName,FPN.CurrentBasicSalary\nFROM emp.FinalPayrollforTeaching FPN\nINNER JOIN mst.PayCycle PCL ON FPN.PayCycleId = PCL.Id  AND PCL.IsDefaltForPayRoll = 1 \nINNER JOIN mst.FinancialYear FCLY ON FCLY.Id = PCL.FinancialYearId AND FCLY.IsDefaultLeave = 1  \nUNION ALL \nSELECT FPN.EmployeeId,FPN.EmployeeName,FPN.FatherName,FPN.DesignationName,FPN.DepartmentName,FPN.PayCycleId,FPN.PayCycleName,FCLY.FinancialYearName,JobName,FPN.CurrentBasicSalary\nFROM emp.FinalPayrollforStipend FPN\nINNER JOIN mst.PayCycle PCL ON FPN.PayCycleId = PCL.Id AND PCL.IsDefaltForPayRoll = 1 \nINNER JOIN mst.FinancialYear FCLY ON FCLY.Id = PCL.FinancialYearId AND FCLY.IsDefaultLeave = 1 \n) AS EmployeeSalaryDetails\nWHERE   TRY_CAST(EmployeeSalaryDetails.CurrentBasicSalary AS float) BETWEEN 30000 AND 50000 "', 'metadata': '', 'datasource': 'database_agent', 'config_id': 1}, 'score': 0.7067457437515259, 'distances': 0.2932542562484741}, {'_id': ObjectId('68e888748035f3d97a682c09'), 'document': 'show me the salary deduction of ankush verma month of march and april', 'metadatas': {'query': " \n\nSELECT * FROM (SELECT emp.UniversityId,FPN.EmployeeId,FPN.EmployeeName,FPN.FatherName,FPN.DesignationName,FPN.DepartmentName,FPN.PayCycleId,FPN.PayCycleName,emp.JobName,FPN.CurrentBasicSalary,emp.ActionStatusId,\n        ServicesCharge,TransportationCharge,WifiCharge,GailCharge,TDS,Advance,PF AS PF,0 AS RF,MI AS Medical,SEF,SWF AS SWF,0 AS TC,ESI,0 AS SRF,Loan,Intrest AS LoanInterest,OtherDeduction,TotDeductions,AggregateDeduction\n    FROM emp.FinalPayrollforNONTeaching FPN\n    INNER JOIN mst.PayCycle PCL ON FPN.PayCycleId = PCL.Id \n    INNER JOIN emp.vw_EmployeesList emp ON emp.Id = FPN.EmployeeId \n    UNION ALL \n    SELECT  emp.UniversityId,FPN.EmployeeId,FPN.EmployeeName,FPN.FatherName,FPN.DesignationName,FPN.DepartmentName,FPN.PayCycleId,FPN.PayCycleName,emp.JobName,FPN.CurrentBasicSalary,emp.ActionStatusId,\n        ServicesCharge,TransportationCharge,WifiCharge,GailCharge,TDS,Advance,0 AS PF,RF,Medical,SEF,0 AS SWF,TC,0 AS ESI,SRF,Loan,LoanInterest,OtherDeduction,TotDeductions,AggregateDeduction \n\t\tFROM emp.FinalPayrollforTeaching FPN\n    INNER JOIN mst.PayCycle PCL ON FPN.PayCycleId = PCL.Id \n    INNER JOIN emp.vw_EmployeesList emp ON emp.Id = FPN.EmployeeId \n    UNION ALL \n    SELECT \n        emp.UniversityId,FPN.EmployeeId,FPN.EmployeeName,FPN.FatherName,FPN.DesignationName,FPN.DepartmentName,FPN.PayCycleId,FPN.PayCycleName,emp.JobName,FPN.CurrentBasicSalary,emp.ActionStatusId,\n        ServicesCharge,TransportationCharge,WifiCharge,GailCharge,TDS,Advance,0 AS PF,RF,Medical,SEF,0 AS SWF,TC,0 AS ESI,SRF,Loan,LoanInterest,OtherDeduction,TotDeductions,AggregateDeduction\n    FROM emp.FinalPayrollforStipend FPN\n    INNER JOIN mst.PayCycle PCL ON FPN.PayCycleId = PCL.Id   \n    INNER JOIN emp.vw_EmployeesList emp ON emp.Id = FPN.EmployeeId  \n) AS EmployeeSalaryDetails\nWHERE UniversityId = 1 AND ActionStatusId=1 AND  (UPPER(PayCycleName) LIKE '%MAR%' OR UPPER(PayCycleName) LIKE '%APR%'\n)  AND LOWER(EmployeeName) LIKE LOWER('%ankush Verma%')\n\nORDER BY  PayCycleId DESC", 'metadata': '', 'datasource': 'database_agent', 'config_id': 1}, 'score': 0.704169750213623, 'distances': 0.29583024978637695}, {'_id': ObjectId('68e888748035f3d97a682c2b'), 'document': 'How many employees received a salary hike of more than ₹5000?', 'metadatas': {'query': 'SELECT COUNT(*) AS EmployeesWithHikeOver5000 FROM (SELECT curr.EmployeeId, TRY_CAST(curr.CurrentBasicSalary AS DECIMAL(18,2)) AS CurrSalary, TRY_CAST(prev.CurrentBasicSalary AS DECIMAL(18,2)) AS PrevSalary FROM (SELECT EmployeeId, CurrentBasicSalary, TRY_CAST(LEFT(PayCycleName, 11) AS DATE) AS PayCycleStart FROM emp.FinalPayrollforTeaching WHERE ISNUMERIC(CurrentBasicSalary) = 1 UNION ALL SELECT EmployeeId, CurrentBasicSalary, TRY_CAST(LEFT(PayCycleName, 11) AS DATE) AS PayCycleStart FROM emp.FinalPayrollforNONTeaching WHERE ISNUMERIC(CurrentBasicSalary) = 1) AS curr INNER JOIN (SELECT EmployeeId, CurrentBasicSalary, TRY_CAST(LEFT(PayCycleName, 11) AS DATE) AS PayCycleStart FROM emp.FinalPayrollforTeaching WHERE ISNUMERIC(CurrentBasicSalary) = 1 UNION ALL SELECT EmployeeId, CurrentBasicSalary, TRY_CAST(LEFT(PayCycleName, 11) AS DATE) AS PayCycleStart FROM emp.FinalPayrollforNONTeaching WHERE ISNUMERIC(CurrentBasicSalary) = 1) AS prev ON curr.EmployeeId = prev.EmployeeId WHERE MONTH(curr.PayCycleStart) = 5 AND YEAR(curr.PayCycleStart) = YEAR(GETDATE()) AND MONTH(prev.PayCycleStart) = 5 AND YEAR(prev.PayCycleStart) = YEAR(GETDATE()) - 1) AS FinalData WHERE CurrSalary IS NOT NULL AND PrevSalary IS NOT NULL AND CurrSalary - PrevSalary > 5000;\n', 'metadata': '', 'datasource': 'database_agent', 'config_id': 1}, 'score': 0.6995850801467896, 'distances': 0.30041491985321045}, {'_id': ObjectId('68e888748035f3d97a682c29'), 'document': 'How many employees received a salary hike of more than ₹5000?', 'metadatas': {'query': 'SELECT COUNT(*) AS EmployeesWithHikeOver5000 FROM (SELECT curr.EmployeeId, TRY_CAST(curr.CurrentBasicSalary AS DECIMAL(18,2)) AS CurrSalary, TRY_CAST(prev.CurrentBasicSalary AS DECIMAL(18,2)) AS PrevSalary FROM (SELECT EmployeeId, CurrentBasicSalary, TRY_CAST(LEFT(PayCycleName, 11) AS DATE) AS PayCycleStart FROM emp.FinalPayrollforTeaching WHERE ISNUMERIC(CurrentBasicSalary) = 1 UNION ALL SELECT EmployeeId, CurrentBasicSalary, TRY_CAST(LEFT(PayCycleName, 11) AS DATE) AS PayCycleStart FROM emp.FinalPayrollforNONTeaching WHERE ISNUMERIC(CurrentBasicSalary) = 1) AS curr INNER JOIN (SELECT EmployeeId, CurrentBasicSalary, TRY_CAST(LEFT(PayCycleName, 11) AS DATE) AS PayCycleStart FROM emp.FinalPayrollforTeaching WHERE ISNUMERIC(CurrentBasicSalary) = 1 UNION ALL SELECT EmployeeId, CurrentBasicSalary, TRY_CAST(LEFT(PayCycleName, 11) AS DATE) AS PayCycleStart FROM emp.FinalPayrollforNONTeaching WHERE ISNUMERIC(CurrentBasicSalary) = 1) AS prev ON curr.EmployeeId = prev.EmployeeId WHERE MONTH(curr.PayCycleStart) = 5 AND YEAR(curr.PayCycleStart) = YEAR(GETDATE()) AND MONTH(prev.PayCycleStart) = 5 AND YEAR(prev.PayCycleStart) = YEAR(GETDATE()) - 1) AS FinalData WHERE CurrSalary IS NOT NULL AND PrevSalary IS NOT NULL AND CurrSalary - PrevSalary > 5000;\n', 'metadata': '', 'datasource': 'database_agent', 'config_id': 1}, 'score': 0.6995850801467896, 'distances': 0.30041491985321045}]
