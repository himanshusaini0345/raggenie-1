            question: provide the  All staff list live in subharti accommodation ?
query: select EmployeeName ,FatherName ,DepartmentName ,DesignationName ,BuildingName ,RoomNo 
from acom.vw_AccommodationAllotmentList  where EmployeeId in (select Id from emp.vw_EmployeesList where UniversityId =1 and ActionStatusId =1) and AllotmentStatusId =2
order by BuildingName ,RoomNo 

question: provide the  teaching staff list live in subharti accommodation ?
query: select EmployeeName ,FatherName ,DepartmentName ,DesignationName ,BuildingName ,RoomNo 
from acom.vw_AccommodationAllotmentList  where EmployeeId in (select Id from emp.vw_EmployeesList where JobName like 'Teaching%') and AllotmentStatusId =2
order by BuildingName ,RoomNo 

question: show the service charge and accommodation details of anurag goyal of march 2025
query: SELECT EmployeeName, FatherName, BuildingName, RoomNo, PaycycleId, RoomCharge, RentalItemCharge, MaintinanceItemCharge, ELECtricMeaterCharge, GailMeaterCharge, GailCharge, NetGailCharge, NetServiceCharge FROM acom.ServicesCharges WHERE EmployeeName LIKE LOWER('%Anurag Goyal%') AND PaycycleId in (SELECT Id FROM mst.PayCycle WHERE PayCycleName like '%Mar 2025%')

question: show me the accommodation details of amil shaji
query: 
SELECT AA.Id, AA.EmployeeId, AA.EmployeeName, AA.FatherName, AA.BuildingName, AA.WingName, AA.FloorName, AA.RoomNo, AA.BuildingTypeName, AA.RoomRent FROM acom.vw_AccommodationAllotmentList AA
INNER JOIN emp.vw_EmployeesList emp ON emp.Id=AA.EmployeeId
WHERE emp.UniversityId=1 ANd emp.ActionStatusId=1 AND AA.AllotmentStatusId=2 AND LOWER(AA.EmployeeName) LIKE LOWER('amil shaji%') ORDER BY AA.EmployeeId, AA.BuildingTypeName DESC


