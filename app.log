INNER JOIN emp.vw_EmployeesList EMP ON LEA.EmployeeId=EMP.Id
WHERE EMP.EmployeeName LIKE 'Anurag%' AND LEA.ActionStatusId=9 AND (LEA.ReptActionStatusId=9 OR LEA.ReptActionStatusId=12 OR LEA.RecomActionStatusId=9 OR LEA.RecomActionStatusId=12 OR 
LEA.ApprovedEmployeeId=8 OR LEA.ApprovedEmployeeId=12) AND CONVERT(DATE,LEA.LeaveDate)=CONVERT(DATE, DATEADD(DAY, -1, GETDATE()))

question: How many times did Shivdatt come late to the office current month?
query: SELECT BIO.EmployeeId,BIO.AttendanceDate,EMP.JobName,EMP.JobName,EMP.EmployeeName,EMP.FatherName,EMP.DesignationName,EMP.DepartmentName,COUNT(*) OVER()LateCount  FROM emp.BioAttendance BIO
INNER JOIN emp.vw_EmployeesList EMP ON BIO.EmployeeId=EMP.Id
INNER JOIN mst.BioAttSift BS ON BS.Id=BIO.SiftTypeId 
WHERE BIO.EmployeeId=2972 AND CONVERT(varchar(5), BIO.AttendanceDate, 108) > BS.SiftIn AND BIO.AttendanceDate >= DATEFROMPARTS(YEAR(GETDATE()), MONTH(GETDATE()), 1)
AND BIO.PunchMode='IN'
ORDER BY BIO.Id

question: How many times did Shivdatt come late to the office last year?
query: SELECT BIO.EmployeeId,EMP.JobName,EMP.JobName,EMP.EmployeeName,EMP.FatherName,EMP.DesignationName,EMP.DepartmentName,BIO.AttendanceDate FROM emp.BioAttendance BIO
INNER JOIN emp.vw_EmployeesList EMP ON BIO.EmployeeId=EMP.Id INNER JOIN mst.BioAttSift BS ON BS.Id=BIO.SiftTypeId 
WHERE CONVERT(varchar(5), BIO.AttendanceDate, 108) > BS.SiftIn 
AND BIO.AttendanceDate >= DATEFROMPARTS(YEAR(GETDATE()) - 1, 1, 1) AND BIO.AttendanceDate < DATEFROMPARTS(YEAR(GETDATE()), 1, 1)
AND DATEPART(WEEKDAY, BIO.AttendanceDate) != 1 
AND BIO.PunchMode='IN'AND EMP.EmployeeName LIKE 'Shivdatt%'
ORDER BY BIO.AttendanceDate 


