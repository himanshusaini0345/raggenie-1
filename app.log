iftOut ELSE (CAST(A.AttendanceDate AS DATETIME) + CAST(MBA.SiftOut AS DATETIME)) END) / 60 AS VARCHAR), 2) + ':' + RIGHT('0' + CAST(DATEDIFF(MINUTE, CASE WHEN A.SiftIn > (CAST(A.AttendanceDate AS DATETIME) + CAST(MBA.SiftIn AS DATETIME)) THEN A.SiftIn ELSE (CAST(A.AttendanceDate AS DATETIME) + CAST(MBA.SiftIn AS DATETIME)) END, CASE WHEN A.SiftOut < (CAST(A.AttendanceDate AS DATETIME) + CAST(MBA.SiftOut AS DATETIME)) THEN A.SiftOut ELSE (CAST(A.AttendanceDate AS DATETIME) + CAST(MBA.SiftOut AS DATETIME)) END) % 60 AS VARCHAR), 2) AS DutyHours FROM (SELECT BA.EmployeeId, CAST(BA.AttendanceDate AS DATE) AS AttendanceDate, MIN(CASE WHEN BA.PunchMode = 'In' THEN BA.AttendanceDate END) AS SiftIn, MAX(CASE WHEN BA.PunchMode = 'Out' THEN BA.AttendanceDate END) AS SiftOut, MIN(CASE WHEN BA.PunchMode = 'In' THEN BA.SiftTypeId END) AS SiftTypeId FROM emp.BioAttendance BA WHERE BA.EmployeeId IN (SELECT Id FROM emp.vw_EmployeesList WHERE EmployeeName LIKE 'vivek tiwari%') GROUP BY BA.EmployeeId, CAST(BA.AttendanceDate AS DATE)) AS A INNER JOIN emp.vw_EmployeesList E ON A.EmployeeId = E.Id LEFT JOIN mst.BioAttSift MBA ON MBA.Id = A.SiftTypeId ORDER BY A.EmployeeId, A.AttendanceDate;", 'intent': 'database_agent', 'summary': "Vivek Tiwari's attendance records show he worked in the Information Technology department with varying shift-in times, often late by 30 minutes to 1 hour and 53 minutes."}
