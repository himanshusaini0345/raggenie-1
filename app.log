LEA.ApprovedEmployeeId=8 OR LEA.ApprovedEmployeeId=12) AND CONVERT(DATE,LEA.LeaveDate)=CONVERT(DATE, DATEADD(DAY, -1, GETDATE()))
ORDER BY EMP.Id


