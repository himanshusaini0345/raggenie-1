4, 33000), 'SiftOut': datetime.datetime(2023, 8, 30, 17, 2, 25, 43000), 'SiftTypeId': 22, 'SiftName': 'SFT:A3', 'LateMins': '00:09', 'OTHours': '01:02', 'DutyHours': '07:51'}], 'main_entity': 'Employee Attendance', 'main_format': 'aggregation', 'role': 'assistant', 'content': 'Here are the attendance details for Himanshu.', 'context_id': '5edbdc9e-eb6f-4264-a870-df56b6ba3b7c', 'question': 'give attendence details of himanshu ', 'query': "SELECT A.EmployeeId, E.EmployeeName, E.FrontImage, E.DepartmentName, A.AttendanceDate, A.SiftIn, A.SiftOut, A.SiftTypeId, MBA.SiftName, RIGHT('0' + CAST(CASE WHEN A.SiftIn > (CAST(A.AttendanceDate AS DATETIME) + CAST(MBA.SiftIn AS DATETIME)) THEN DATEDIFF(MINUTE, CAST(A.AttendanceDate AS DATETIME) + CAST(MBA.SiftIn AS DATETIME), A.SiftIn) ELSE 0 END / 60 AS VARCHAR), 2) + ':' + RIGHT('0' + CAST(CASE WHEN A.SiftIn > (CAST(A.AttendanceDate AS DATETIME) + CAST(MBA.SiftIn AS DATETIME)) THEN DATEDIFF(MINUTE, CAST(A.AttendanceDate AS DATETIME) + CAST(MBA.SiftIn AS DATETIME), A.SiftIn) ELSE 0 END % 60 AS VARCHAR), 2) AS LateMins, RIGHT('0' + CAST(CASE WHEN A.SiftOut > (CAST(A.AttendanceDate AS DATETIME) + CAST(MBA.SiftOut AS DATETIME)) THEN DATEDIFF(MINUTE, CAST(A.AttendanceDate AS DATETIME) + CAST(MBA.SiftOut AS DATETIME), A.SiftOut) ELSE 0 END / 60 AS VARCHAR), 2) + ':' + RIGHT('0' + CAST(CASE WHEN A.SiftOut > (CAST(A.AttendanceDate AS DATETIME) + CAST(MBA.SiftOut AS DATETIME)) THEN DATEDIFF(MINUTE, CAST(A.AttendanceDate AS DATETIME) + CAST(MBA.SiftOut AS DATETIME), A.SiftOut) ELSE 0 END % 60 AS VARCHAR), 2) AS OTHours, RIGHT('0' + CAST(DATEDIFF(MINUTE, CASE WHEN A.SiftIn > (CAST(A.AttendanceDate AS DATETIME) + CAST(MBA.SiftIn AS DATETIME)) THEN A.SiftIn ELSE (CAST(A.AttendanceDate AS DATETIME) + CAST(MBA.SiftIn AS DATETIME)) END, CASE WHEN A.SiftOut < (CAST(A.AttendanceDate AS DATETIME) + CAST(MBA.SiftOut AS DATETIME)) THEN A.SiftOut ELSE (CAST(A.AttendanceDate AS DATETIME) + CAST(MBA.SiftOut AS DATETIME)) END) / 60 AS VARCHAR), 2) + ':' + RIGHT('0' + CAST(DATEDIFF(MINUTE, CASE WHEN A.SiftIn > (CAST(A.AttendanceDate AS DATETIME) + CAST(MBA.SiftIn AS DATETIME)) THEN A.SiftIn ELSE (CAST(A.AttendanceDate AS DATETIME) + CAST(MBA.SiftIn AS DATETIME)) END, CASE WHEN A.SiftOut < (CAST(A.AttendanceDate AS DATETIME) + CAST(MBA.SiftOut AS DATETIME)) THEN A.SiftOut ELSE (CAST(A.AttendanceDate AS DATETIME) + CAST(MBA.SiftOut AS DATETIME)) END) % 60 AS VARCHAR), 2) AS DutyHours FROM (SELECT BA.EmployeeId, CAST(BA.AttendanceDate AS DATE) AS AttendanceDate, MIN(CASE WHEN BA.PunchMode = 'In' THEN BA.AttendanceDate END) AS SiftIn, MAX(CASE WHEN BA.PunchMode = 'Out' THEN BA.AttendanceDate END) AS SiftOut, MIN(CASE WHEN BA.PunchMode = 'In' THEN BA.SiftTypeId END) AS SiftTypeId FROM emp.BioAttendance BA WHERE BA.EmployeeId IN (SELECT Id FROM emp.vw_EmployeesList WHERE LOWER(EmployeeName) LIKE LOWER('himanshu%')) GROUP BY BA.EmployeeId, CAST(BA.AttendanceDate AS DATE)) AS A INNER JOIN emp.vw_EmployeesList E ON A.EmployeeId = E.Id LEFT JOIN mst.BioAttSift MBA ON MBA.Id = A.SiftTypeId ORDER BY A.EmployeeId, A.AttendanceDate;", 'intent': 'database_agent', 'summary': 'Here are the attendance details of Himanshu:\n\nHimanshu Tomar is an employee in the Purchase department. His attendance details for the month of August 2023 are as follows:\n\n- August 1: \n  - Shift: SFT:A3\n  - Late Minutes: 9 minutes\n  - Duty Hours: 7 hours 51 minutes\n  - Overtime Hours: 1 hour 42 minutes\n\n- August 2: \n  - Shift: SFT:A3\n  - Late Minutes: 4 minutes\n  - Duty Hours: 7 hours 56 minutes\n  - Overtime Hours: 1 hour 2 minutes\n\n- August 3: \n  - Shift: SFT:A3\n  - Late Minutes: 8 minutes\n  - Duty Hours: 7 hours 52 minutes\n  - Overtime Hours: 1 hour 30 minutes\n\n- August 4: \n  - Shift: SFT:A3\n  - Late Minutes: 4 minutes\n  - Duty Hours: 7 hours 56 minutes\n  - Overtime Hours: 1 hour 22 minutes\n\n- August 5: \n  - Shift: SFT:A3\n  - Late Minutes: 9 minutes\n  - Duty Hours: 7 hours 51 minutes\n  - Overtime Hours: 56 minutes\n\n- Augu