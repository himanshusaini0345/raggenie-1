question: show me the salary of ORAL PATHOLOGY department
query: SELECT * FROM ( SELECT FPN.EmployeeId, FPN.EmployeeName, FPN.FatherName, FPN.DesignationName, FPN.DepartmentName, FPN.PayCycleId, FPN.PayCycleName, FCLY.FinancialYearName, JobName, FPN.CurrentBasicSalary FROM emp.FinalPayrollforNONTeaching FPN INNER JOIN mst.PayCycle PCL ON FPN.PayCycleId = PCL.Id AND PCL.IsDefaltForPayRoll = 1 INNER JOIN mst.FinancialYear FCLY ON FCLY.Id = PCL.FinancialYearId AND FCLY.IsDefaultLeave = 1 UNION ALL SELECT FPN.EmployeeId, FPN.EmployeeName, FPN.FatherName, FPN.DesignationName, FPN.DepartmentName, FPN.PayCycleId, FPN.PayCycleName, FCLY.FinancialYearName, JobName, FPN.CurrentBasicSalary FROM emp.FinalPayrollforTeaching FPN INNER JOIN mst.PayCycle PCL ON FPN.PayCycleId = PCL.Id AND PCL.IsDefaltForPayRoll = 1 INNER JOIN mst.FinancialYear FCLY ON FCLY.Id = PCL.FinancialYearId AND FCLY.IsDefaultLeave = 1 UNION ALL SELECT FPN.EmployeeId, FPN.EmployeeName, FPN.FatherName, FPN.DesignationName, FPN.DepartmentName, FPN.PayCycleId, FPN.PayCycleName, FCLY.FinancialYearName, JobName, FPN.CurrentBasicSalary FROM emp.FinalPayrollforStipend FPN INNER JOIN mst.PayCycle PCL ON FPN.PayCycleId = PCL.Id AND PCL.IsDefaltForPayRoll = 1 INNER JOIN mst.FinancialYear FCLY ON FCLY.Id = PCL.FinancialYearId AND FCLY.IsDefaultLeave = 1 ) AS EmployeeSalaryDetails WHERE LOWER(EmployeeSalaryDetails.DepartmentName) LIKE LOWER('ORAL PATHOLOGY%') ORDER BY JobName, EmployeeName

