END) \n    ELSE 0 END) % 365.25) % 30.44) AS VARCHAR) + ' Days' FROM emp.vw_WorkingExperienceList WE WHERE WE.EmployeeId = e.Id AND WE.ActionStatusId = 1) AS InSideExperience, \n    (SELECT CAST(FLOOR(SUM(CASE WHEN Organization NOT IN ('SUBHARTI UNIVERSITY', 'Swami Vivekanand Subharti University', 'Swami Vivekanand Subharti Univesity') THEN DATEDIFF(DAY, TRY_CONVERT(DATE, WE.JoiningDate), \n    CASE WHEN WE.LeavingDate = '1900-01-01' THEN GETDATE() ELSE TRY_CONVERT(DATE, WE.LeavingDate) END) ELSE 0 END) / 365.25) AS VARCHAR) + ' Years ' + CAST(FLOOR((SUM(CASE WHEN Organization NOT IN ('SUBHARTI UNIVERSITY', 'Swami Vivekanand Subharti University', 'Swami Vivekanand Subharti Univesity') \n    THEN DATEDIFF(DAY, TRY_CONVERT(DATE, WE.JoiningDate),CASE WHEN WE.LeavingDate = '1900-01-01' THEN GETDATE() ELSE TRY_CONVERT(DATE, WE.LeavingDate) END) ELSE 0 END) % 365.25) / 30.44) AS VARCHAR) + ' Months ' +\n    CAST(FLOOR((SUM(CASE WHEN Organization NOT IN ('SUBHARTI UNIVERSITY', 'Swami Vivekanand Subharti University', 'Swami Vivekanand Subharti Univesity') THEN DATEDIFF(DAY, TRY_CONVERT(DATE, WE.JoiningDate), CASE \n    WHEN WE.LeavingDate = '1900-01-01' THEN GETDATE() ELSE TRY_CONVERT(DATE, WE.LeavingDate) END) ELSE 0 END) % 365.25) % 30.44) AS VARCHAR) + ' Days' FROM emp.vw_WorkingExperienceList WE \n    WHERE WE.EmployeeId = e.Id AND WE.ActionStatusId = 1) AS OutsiteExperience,e.DesignationName,e.DepartmentName,e.MobileNo FROM emp.vw_EmployeesList e WHERE\n        e.UniversityId=1 AND\n        e.ActionStatusId = 1 AND e.EmployeeName LIKE 'amil shaji%' ", 'metadata': '', 'datasource': 'database_agent', 'config_id': 1}, 'score': 0.6916165947914124, 'distances': 0.30838340520858765}, {'_id': ObjectId('68ba6fd4ff185dae514dc96e'), 'document': 'Which employees have had their salaries stopped?', 'metadatas': {'query': 'SELECT * FROM ( SELECT EmployeeName,EmployeeCode,FatherName,PanNo,DOB,DesignationName,DepartmentName,JobName,CollegeName,PayCycleName  FROM emp.FinalPayrollforNON