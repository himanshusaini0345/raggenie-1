question: show the user profile of neeru singh in pharmacy department
query: SELECT e.Id, e.TitleName, e.EmployeeName, e.FrontImage, e.FatherName, e.DesignationName, e.DepartmentName, e.JoiningDate, ISNULL(exp.Years, 0) AS WorkingExperience, ISNULL(lv.LeaveTaken, 0) AS LeaveTaken, e.Phone, ISNULL(rel.Relatives, '') AS Relatives FROM emp.vw_EmployeesList e LEFT JOIN (SELECT EmployeeId, SUM(DATEDIFF(DAY, JoiningDate, CASE WHEN LeavingDate IS NULL OR LeavingDate = '' OR LeavingDate = '1900-01-01' THEN CAST(GETDATE() AS DATE) ELSE LeavingDate END)) / 365 AS Years FROM emp.WorkingExperience GROUP BY EmployeeId) AS exp ON e.Id = exp.EmployeeId LEFT JOIN (SELECT EmployeeId, SUM(CASE WHEN IsHalf = 1 THEN 0.5 ELSE 1.0 END) AS LeaveTaken FROM emp.LeaveDateWiseDetails WHERE MONTH(LeaveDate) = MONTH(GETDATE()) AND YEAR(LeaveDate) = YEAR(GETDATE()) GROUP BY EmployeeId) AS lv ON e.Id = lv.EmployeeId OUTER APPLY (SELECT STRING_AGG(CONCAT(RelativeName, ', ', EmployeeName, ', ', DesignationName, ', ', DepartmentName, ', ', CollegeName), ': ') AS Relatives FROM emp.vw_RelativesList r WHERE r.EmployeeId = e.Id) AS rel WHERE LOWER(e.DepartmentName) LIKE LOWER('%pharmacy%') AND LOWER(e.EmployeeName) LIKE LOWER('%neeru%');


question: give attendence details of xxxx xx?
query: SELECT A.EmployeeId, E.EmployeeName, E.FrontImage, E.DepartmentName, A.AttendanceDate, A.SiftIn, A.SiftOut, A.SiftTypeId, MBA.SiftName, RIGHT('0' + CAST(CASE WHEN A.SiftIn > (CAST(A.AttendanceDate AS DATETIME) + CAST(MBA.SiftIn AS DATETIME)) THEN DATEDIFF(MINUTE, CAST(A.AttendanceDate AS DATETIME) + CAST(MBA.SiftIn AS DATETIME), A.SiftIn) ELSE 0 END / 60 AS VARCHAR), 2) + ':' + RIGHT('0' + CAST(CASE WHEN A.SiftIn > (CAST(A.AttendanceDate AS DATETIME) + CAST(MBA.SiftIn AS DATETIME)) THEN DATEDIFF(MINUTE, CAST(A.AttendanceDate AS DATETIME) + CAST(MBA.SiftIn AS DATETIME), A.SiftIn) ELSE 0 END % 60 AS VARCHAR), 2) AS LateMins, RIGHT('0' + CAST(CASE WHEN A.SiftOut > (CAST(A.AttendanceDate AS DATETIME) + CAST(MBA.SiftOut AS DATETIME)) THEN DATEDIFF(MINUTE, CAST(A.AttendanceDate AS DATETIME) + CAST(MBA.SiftOut AS DATETIME), A.SiftOut) ELSE 0 END / 60 AS VARCHAR), 2) + ':' + RIGHT('0' + CAST(CASE WHEN A.SiftOut > (CAST(A.AttendanceDate AS DATETIME) + CAST(MBA.SiftOut AS DATETIME)) THEN DATEDIFF(MINUTE, CAST(A.AttendanceDate AS DATETIME) + CAST(MBA.SiftOut AS DATETIME), A.SiftOut) ELSE 0 END % 60 AS VARCHAR), 2) AS OTHours, RIGHT('0' + CAST(DATEDIFF(MINUTE, CASE WHEN A.SiftIn > (CAST(A.AttendanceDate AS DATETIME) + CAST(MBA.SiftIn AS DATETIME)) THEN A.SiftIn ELSE (CAST(A.AttendanceDate AS DATETIME) + CAST(MBA.SiftIn AS DATETIME)) END, CASE WHEN A.SiftOut < (CAST(A.AttendanceDate AS DATETIME) + CAST(MBA.SiftOut AS DATETIME)) THEN A.SiftOut ELSE (CAST(A.AttendanceDate AS DATETIME) + CAST(MBA.SiftOut AS DATETIME)) END) / 60 AS VARCHAR), 2) + ':' + RIGHT('0' + CAST(DATEDIFF(MINUTE, CASE WHEN A.SiftIn > (CAST(A.AttendanceDate AS DATETIME) + CAST(MBA.SiftIn AS DATETIME)) THEN A.SiftIn ELSE (CAST(A.AttendanceDate AS DATETIME) + CAST(MBA.SiftIn AS DATETIME)) END, CASE WHEN A.SiftOut < (CAST(A.AttendanceDate AS DATETIME) + CAST(MBA.SiftOut AS DATETIME)) THEN A.SiftOut ELSE (CAST(A.AttendanceDate AS DATETIME) + CAST(MBA.SiftOut AS DATETIME)) END) % 60 AS VARCHAR), 2) AS DutyHours FROM (SELECT BA.EmployeeId, CAST(BA.AttendanceDate AS DATE) AS AttendanceDate, MIN(CASE WHEN BA.PunchMode = 'In' THEN BA.AttendanceDate END) AS SiftIn, MAX(CASE WHEN BA.PunchMode = 'Out' THEN BA.AttendanceDate END) AS SiftOut, MIN(CASE WHEN BA.PunchMode = 'In' THEN BA.SiftTypeId END) AS SiftTypeId FROM emp.BioAttendance BA WHERE BA.EmployeeId IN (SELECT Id FROM emp.vw_EmployeesList WHERE EmployeeName LIKE 'xxxx xx%') AND CAST(BA.AttendanceDate AS DATE) BETWEEN '2025-06-01' AND '2025-06-18' GROUP BY BA.EmployeeId, CAST(BA.AttendanceDate AS DATE)) AS A INNER JOIN emp.vw_EmployeesList E ON A.EmployeeId = E.Id LEFT JOIN mst.BioAttSift MBA ON MBA.Id = A.SiftTypeId ORDER BY A.EmployeeId, A.AttendanceDate;

question: show me the PAN card/Aadhaar card/Passport of Mr. amil shaji.
query: SELECT DD.EmployeeId,emp.EmployeeName,DD.Id,DT.DocumentTypeName,DD.EmployeeDocumentTypeId,DD.FilePath,DD.FileName,DD.FileType,DD.ActionStatusId FROM emp.DocumentDetails  DD
INNER JOIN mst.EmployeeDocumentType  DT ON DD.EmployeeDocumentTypeId=DT.Id 
INNER JOIN emp.Employees emp ON emp.Id=DD.EmployeeId AND emp.ActionStatusId=1 AND emp.University_Id=1
WHERE  DD.ActionStatusId=1  AND EmployeeName LIKE 'amil shaji%' AND (DT.DocumentTypeName LIKE'%PAN card%' OR DT.DocumentTypeName LIKE'%Aadhaar card%' OR DT.DocumentTypeName LIKE'%Passport%') 
ORDER BY  DD.EmployeeId

question: show the service charge and accommodation details of anurag goyal of march 2025
query: SELECT EmployeeName, FatherName, BuildingName, RoomNo, PaycycleId, RoomCharge, RentalItemCharge, MaintinanceItemCharge, ELECtricMeaterCharge, GailMeaterCharge, GailCharge, NetGailCharge, NetServiceCharge FROM acom.ServicesCharges WHERE EmployeeName LIKE LOWER('%Anurag Goyal%') AND PaycycleId in (SELECT Id FROM mst.PayCycle WHERE PayCycleName like '%Mar 2025%')

question: roop singh service charge details?
query: "
select e.EmployeeName ,e.FatherName ,e.DepartmentName ,e.DesignationName ,BuildingName , RoomNo,RoomCharge,
ELECtricMeaterCharge MeaterCharge,GarbageCharge  ,NETELCTCharge Charge ,NetServiceCharge , NetGailCharge  ,NetServiceCharge+NetGailCharge TotalServiceCharge
,p.PayCycleName Month   from acom.ServicesCharges s
inner join mst.PayCycle p  on p.Id = s.PaycycleId 
inner join emp.vw_EmployeesList  e on e.Id = s.EmployeeId 
where  s.PaycycleId >=40 and e.EmployeeName like 'Roop singh%' and e.UniversityId =1
order by s.EmployeeId ,s.PaycycleId
"


