Out < (CAST(A.AttendanceDate AS DATETIME) + CAST(MBA.SiftOut AS DATETIME)) THEN A.SiftOut ELSE (CAST(A.AttendanceDate AS DATETIME) + CAST(MBA.SiftOut AS DATETIME)) END) % 60 AS VARCHAR), 2) AS DutyHours FROM (SELECT BA.EmployeeId, CAST(BA.AttendanceDate AS DATE) AS AttendanceDate, MIN(CASE WHEN BA.PunchMode = 'In' THEN BA.AttendanceDate END) AS SiftIn, MAX(CASE WHEN BA.PunchMode = 'Out' THEN BA.AttendanceDate END) AS SiftOut, MIN(CASE WHEN BA.PunchMode = 'In' THEN BA.SiftTypeId END) AS SiftTypeId FROM emp.BioAttendance BA WHERE BA.EmployeeId IN (SELECT Id FROM emp.vw_EmployeesList WHERE EmployeeName LIKE 'xxxx xx%') AND CAST(BA.AttendanceDate AS DATE) BETWEEN '2025-06-01' AND '2025-06-18' GROUP BY BA.EmployeeId, CAST(BA.AttendanceDate AS DATE)) AS A INNER JOIN emp.vw_EmployeesList E ON A.EmployeeId = E.Id LEFT JOIN mst.BioAttSift MBA ON MBA.Id = A.SiftTypeId ORDER BY A.EmployeeId, A.AttendanceDate;", 'metadata': '', 'datasource': 'database_agent', 'config_id': 1}, 'score': 0.709464430809021, 'distances': 0.290535569190979}, {'_id': ObjectId('68ba6e42ff185dae514dc4d7'), 'document': 'show the service charge and accommodation details of anurag goyal of march 2025', 'metadatas': {'query': "SELECT EmployeeName, FatherName, BuildingName, RoomNo, PaycycleId, RoomCharge, RentalItemCharge, MaintinanceItemCharge, ELECtricMeaterCharge, GailMeaterCharge, GailCharge, NetGailCharge, NetServiceCharge FROM acom.ServicesCharges WHERE EmployeeName LIKE LOWER('%Anurag Goyal%') AND PaycycleId in (SELECT Id FROM mst.PayCycle WHERE PayCycleName like '%Mar 2025%')", 'metadata': '', 'datasource': 'database_agent', 'config_id': 1}, 'score': 0.7029100060462952, 'distances': 0.29708999395370483}, {'_id': ObjectId('68ba6e42ff185dae514dc50b'), 'document': 'can you show me details for Navpreet kaur', 'metadatas': {'query': "SELECT Id, EmployeeName, FatherName, DepartmentName, DesignationName, MobileNo, EmailId FROM emp.vw_EmployeesList WHERE LOWER(EmployeeName) LIKE LOWER('%navpreet kaur%')", 'm