ff185dae514dc930'), 'document': 'How many times did Shivdatt come late to the office last year?', 'metadatas': {'query': "SELECT BIO.EmployeeId,EMP.JobName,EMP.JobName,EMP.EmployeeName,EMP.FatherName,EMP.DesignationName,EMP.DepartmentName,BIO.AttendanceDate FROM emp.BioAttendance BIO\nINNER JOIN emp.vw_EmployeesList EMP ON BIO.EmployeeId=EMP.Id\nINNER JOIN mst.BioAttSift BS ON BS.Id=BIO.SiftTypeId \nWHERE BIO.EmployeeId=12141 AND CONVERT(varchar(5), BIO.AttendanceDate, 108) > BS.SiftIn \nAND BIO.AttendanceDate >= DATEFROMPARTS(YEAR(GETDATE()) - 1, 1, 1)\nAND BIO.AttendanceDate < DATEFROMPARTS(YEAR(GETDATE()), 1, 1)\nAND DATEPART(WEEKDAY, BIO.AttendanceDate) != 1 -- Sunday excluded\nAND BIO.PunchMode='IN'\nORDER BY BIO.AttendanceDate  ", 'metadata': '', 'datasource': 'database_agent', 'config_id': 1}, 'score': 0.5944941639900208, 'distances': 0.40550583600997925}]
