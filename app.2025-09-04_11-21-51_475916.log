question: show me the user profile of krishna murty
query: SELECT e.Id, e.TitleName, e.EmployeeName, e.FrontImage, e.FatherName, e.DesignationName, e.DepartmentName, e.JoiningDate, ISNULL(exp.Years, 0) AS WorkingExperience, ISNULL(lv.LeaveTaken, 0) AS LeaveTaken, e.Phone, ISNULL(rel.Relatives, '') AS Relatives FROM emp.vw_EmployeesList e LEFT JOIN (SELECT EmployeeId, SUM(DATEDIFF(DAY, JoiningDate, CASE WHEN LeavingDate IS NULL OR LeavingDate = '' OR LeavingDate = '1900-01-01' THEN CAST(GETDATE() AS DATE) ELSE LeavingDate END)) / 365 AS Years FROM emp.WorkingExperience GROUP BY EmployeeId) AS exp ON e.Id = exp.EmployeeId LEFT JOIN (SELECT EmployeeId, SUM(CASE WHEN IsHalf = 1 THEN 0.5 ELSE 1.0 END) AS LeaveTaken FROM emp.LeaveDateWiseDetails WHERE MONTH(LeaveDate) = MONTH(GETDATE()) AND YEAR(LeaveDate) = YEAR(GETDATE()) GROUP BY EmployeeId) AS lv ON e.Id = lv.EmployeeId OUTER APPLY (SELECT STRING_AGG(CONCAT(RelativeName, ', ', EmployeeName, ', ', DesignationName, ', ', DepartmentName, ', ', CollegeName), ': ') AS Relatives FROM emp.vw_RelativesList r WHERE r.EmployeeId = e.Id) AS rel WHERE LOWER(e.EmployeeName) LIKE LOWER('krishna murty%');



