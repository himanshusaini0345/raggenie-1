sList e LEFT JOIN (SELECT EmployeeId, SUM(DATEDIFF(DAY, JoiningDate, CASE WHEN LeavingDate IS NULL OR LeavingDate = '' OR LeavingDate = '1900-01-01' THEN CAST(GETDATE() AS DATE) ELSE LeavingDate END)) / 365 AS Years FROM emp.WorkingExperience GROUP BY EmployeeId) AS exp ON e.Id = exp.EmployeeId LEFT JOIN (SELECT EmployeeId, SUM(CASE WHEN IsHalf = 1 THEN 0.5 ELSE 1.0 END) AS LeaveTaken FROM emp.LeaveDateWiseDetails WHERE MONTH(LeaveDate) = MONTH(GETDATE()) AND YEAR(LeaveDate) = YEAR(GETDATE()) GROUP BY EmployeeId) AS lv ON e.Id = lv.EmployeeId OUTER APPLY (SELECT STRING_AGG(CONCAT(RelativeName, ', ', EmployeeName, ', ', DesignationName, ', ', DepartmentName, ', ', CollegeName), ': ') AS Relatives FROM emp.vw_RelativesList r WHERE r.EmployeeId = e.Id) AS rel WHERE LOWER(e.DepartmentName) LIKE LOWER('%pharmacy%') AND LOWER(e.EmployeeName) LIKE LOWER('%neeru%');\n"}, 'distances': 1.4905307292938232}, {'document': 'Can you provide the arrear details for amil shaji?', 'id': 'id_306', 'metadatas': {'config_id': 1, 'datasource': 'database_agent', 'metadata': '', 'query': "SELECT Id, EmployeeName, AllowanceArrear, BasicSalaryArrear, OtArrear FROM emp.FinalPayrollforStipend WHERE LOWER(EmployeeName) LIKE LOWER('amil shaji%') UNION ALL SELECT Id, EmployeeName, AllowanceArrear, BasicSalaryArrear, OtArrear FROM emp.FinalPayrollforTeaching WHERE LOWER(EmployeeName) LIKE LOWER('amil shaji%') UNION ALL SELECT Id, EmployeeName, AllowanceArrear, BasicSalaryArrear, OtArrear FROM emp.FinalPayrollforNonTeaching WHERE LOWER(EmployeeName) LIKE LOWER('amil shaji%');\n"}, 'distances': 1.5030186176300049}, {'document': 'show me the attendence of amil shaji', 'id': 'id_86', 'metadatas': {'config_id': 1, 'datasource': 'database_agent', 'metadata': '', 'query': "SELECT A.EmployeeId, E.EmployeeName, E.FrontImage, E.DepartmentName, A.AttendanceDate, A.SiftIn, A.SiftOut, A.SiftTypeId, MBA.SiftName, RIGHT('0' + CAST(CASE WHEN A.SiftIn > (CAST(A.AttendanceDate AS DATETIME) + CAST(MBA.SiftIn AS DATET