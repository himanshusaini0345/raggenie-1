2025-09-04 11:44:37.657 | INFO     | app.chain.modules.prompt_generator:handle:74 - datasource_suggestions:{'database_agent': [{'document': 'How many employees have joined Subharti University this month?', 'id': 'id_171', 'metadatas': {'config_id': 1, 'datasource': 'database_agent', 'metadata': '', 'query': 'SELECT Id,JobName,DesignationName,DepartmentName,EmployeeName,FatherName,MobileNo,JoiningDate FROM emp.VW_EmployeesList\nWHERE UniversityId =1 and datepart(MONTH ,JoiningDate) >= datepart(MONTH ,getdate()) and datepart(YEAR ,JoiningDate)  = datepart(YEAR ,getdate()) ORDER\xa0BY\xa0JoiningDate'}, 'distances': 1.445722222328186}, {'document': 'How many employees have joined Subharti University this year?', 'id': 'id_170', 'metadatas': {'config_id': 1, 'datasource': 'database_agent', 'metadata': '', 'query': 'SELECT Id,JobName,DesignationName,DepartmentName,EmployeeName,FatherName,MobileNo,JoiningDate FROM emp.VW_EmployeesList\nWHERE JoiningDate >= DATEFROMPARTS(YEAR(GETDATE()), 1, 1) \nORDER BY JoiningDate'}, 'distances': 1.4521116018295288}, {'document': 'How many employees have joined in Information of Technology Department of Subharti University this month?', 'id': 'id_172', 'metadatas': {'config_id': 1, 'datasource': 'database_agent', 'metadata': '', 'query': "SELECT Id,JobName,DesignationName,DepartmentName,EmployeeName,FatherName,MobileNo,JoiningDate FROM emp.VW_EmployeesList\nWHERE JoiningDate >= DATEFROMPARTS(YEAR(GETDATE()), MONTH(GETDATE()), 1) AND DepartmentName LIKE 'Information Technology' ORDER BY JoiningDate"}, 'distances': 1.484813928604126}, {'document': 'show the user profile of neeru singh in pharmacy department', 'id': 'id_260', 'metadatas': {'config_id': 1, 'datasource': 'database_agent', 'metadata': '', 'query': "SELECT e.Id, e.TitleName, e.EmployeeName, e.FrontImage, e.FatherName, e.DesignationName, e.DepartmentName, e.JoiningDate, ISNULL(exp.Years, 0) AS WorkingExperience, ISNULL(lv.LeaveTaken, 0) AS LeaveTaken, e.Phone, ISNULL(rel.Relatives, '') AS Relatives FROM emp.vw_EmployeesList e LEFT JOIN (SELECT EmployeeId, SUM(DATEDIFF(DAY, JoiningDate, CASE WHEN LeavingDate IS NULL OR LeavingDate = '' OR LeavingDate = '1900-01-01' THEN CAST(GETDATE() AS DATE) ELSE LeavingDate END)) / 365 AS Years FROM emp.WorkingExperience GROUP BY EmployeeId) AS exp ON e.Id = exp.EmployeeId LEFT JOIN (SELECT EmployeeId, SUM(CASE WHEN IsHalf = 1 THEN 0.5 ELSE 1.0 END) AS LeaveTaken FROM emp.LeaveDateWiseDetails WHERE MONTH(LeaveDate) = MONTH(GETDATE()) AND YEAR(LeaveDate) = YEAR(GETDATE()) GROUP BY EmployeeId) AS lv ON e.Id = lv.EmployeeId OUTER APPLY (SELECT STRING_AGG(CONCAT(RelativeName, ', ', EmployeeName, ', ', DesignationName, ', ', DepartmentName, ', ', CollegeName), ': ') AS Relatives FROM emp.vw_RelativesList r WHERE r.EmployeeId = e.Id) AS rel WHERE LOWER(e.DepartmentName) LIKE LOWER('%pharmacy%') AND LOWER(e.EmployeeName) LIKE LOWER('%neeru%');\n"}, 'distances': 1.4905307292938232}, {'document': 'Can you provide the arrear details for amil shaji?', 'id': 'id_306', 'metadatas': {'config_id': 1, 'datasource': 'database_agent', 'metadata': '', 'query': "SELECT Id, EmployeeName, AllowanceArrear, BasicSalaryArrear, OtArrear FROM emp.FinalPayrollforStipend WHERE LOWER(EmployeeName) LIKE LOWER('amil shaji%') UNION ALL SELECT Id, EmployeeName, AllowanceArrear, BasicSalaryArrear, OtArrear FROM emp.FinalPayrollforTeaching WHERE LOWER(EmployeeName) LIKE LOWER('amil shaji%') UNION ALL SELECT Id, EmployeeName, AllowanceArrear, BasicSalaryArrear, OtArrear FROM emp.FinalPayrollforNonTeaching WHERE LOWER(EmployeeName) LIKE LOWER('amil shaji%');\n"}, 'distances': 1.5030186176300049}, {'document': 'show me the attendence of amil shaji', 'id': 'id_86', 'metadatas': {'config_id': 1, 'datasource': 'database_agent', 'metadata': '', 'query': "SELECT A.EmployeeId, E.EmployeeName, E.FrontImage, E.DepartmentName, A.AttendanceDate, A.SiftIn, A.SiftOut, A.SiftTypeId, MBA.SiftName, RIGHT('0' + CAST(CASE WHEN A.SiftIn > (CAST(A.AttendanceDate AS DATETIME) + CAST(MBA.SiftIn AS DATETIME)) THEN DATEDIFF(MINUTE, CAST(A.AttendanceDate AS DATETIME) + CAST(MBA.SiftIn AS DATETIME), A.SiftIn) ELSE 0 END / 60 AS VARCHAR), 2) + ':' + RIGHT('0' + CAST(CASE WHEN A.SiftIn > (CAST(A.AttendanceDate AS DATETIME) + CAST(MBA.SiftIn AS DATETIME)) THEN DATEDIFF(MINUTE, CAST(A.AttendanceDate AS DATETIME) + CAST(MBA.SiftIn AS DATETIME), A.SiftIn) ELSE 0 END % 60 AS VARCHAR), 2) AS LateMins, RIGHT('0' + CAST(CASE WHEN A.SiftOut > (CAST(A.AttendanceDate AS DATETIME) + CAST(MBA.SiftOut AS DATETIME)) THEN DATEDIFF(MINUTE, CAST(A.AttendanceDate AS DATETIME) + CAST(MBA.SiftOut AS DATETIME), A.SiftOut) ELSE 0 END / 60 AS VARCHAR), 2) + ':' + RIGHT('0' + CAST(CASE WHEN A.SiftOut > (CAST(A.AttendanceDate AS DATETIME) + CAST(MBA.SiftOut AS DATETIME)) THEN DATEDIFF(MINUTE, CAST(A.AttendanceDate AS DATETIME) + CAST(MBA.SiftOut AS DATETIME), A.SiftOut) ELSE 0 END % 60 AS VARCHAR), 2) AS OTHours, RIGHT('0' + CAST(DATEDIFF(MINUTE, CASE WHEN A.SiftIn > (CAST(A.AttendanceDate AS DATETIME) + CAST(MBA.SiftIn AS DATETIME)) THEN A.SiftIn ELSE (CAST(A.AttendanceDate AS DATETIME) + CAST(MBA.SiftIn AS DATETIME)) END, CASE WHEN A.SiftOut < (CAST(A.AttendanceDate AS DATETIME) + CAST(MBA.SiftOut AS DATETIME)) THEN A.SiftOut ELSE (CAST(A.AttendanceDate AS DATETIME) + CAST(MBA.SiftOut AS DATETIME)) END) / 60 AS VARCHAR), 2) + ':' + RIGHT('0' + CAST(DATEDIFF(MINUTE, CASE WHEN A.SiftIn > (CAST(A.AttendanceDate AS DATETIME) + CAST(MBA.SiftIn AS DATETIME)) THEN A.SiftIn ELSE (CAST(A.AttendanceDate AS DATETIME) + CAST(MBA.SiftIn AS DATETIME)) END, CASE WHEN A.SiftOut < (CAST(A.AttendanceDate AS DATETIME) + CAST(MBA.SiftOut AS DATETIME)) THEN A.SiftOut ELSE (CAST(A.AttendanceDate AS DATETIME) + CAST(MBA.SiftOut AS DATETIME)) END) % 60 AS VARCHAR), 2) AS DutyHours FROM (SELECT BA.EmployeeId, CAST(BA.AttendanceDate AS DATE) AS AttendanceDate, MIN(CASE WHEN BA.PunchMode = 'In' THEN BA.AttendanceDate END) AS SiftIn, MAX(CASE WHEN BA.PunchMode = 'Out' THEN BA.AttendanceDate END) AS SiftOut, MIN(CASE WHEN BA.PunchMode = 'In' THEN BA.SiftTypeId END) AS SiftTypeId FROM emp.BioAttendance BA WHERE BA.EmployeeId IN (SELECT Id FROM emp.vw_EmployeesList WHERE EmployeeName LIKE 'amil shaji%') AND CAST(BA.AttendanceDate AS DATE) BETWEEN '2025-06-01' AND '2025-06-18' GROUP BY BA.EmployeeId, CAST(BA.AttendanceDate AS DATE)) AS A INNER JOIN emp.vw_EmployeesList E ON A.EmployeeId = E.Id LEFT JOIN mst.BioAttSift MBA ON MBA.Id = A.SiftTypeId ORDER BY A.EmployeeId, A.AttendanceDate;"}, 'distances': 1.5081007480621338}], 'general_enquiry_agent': [{'document': 'Bhalla Papdi Chat thoda meetha hota hai kya?', 'id': 'id_387', 'metadatas': {'config_id': 1, 'datasource': 'general_enquiry_agent', 'query': 'Haan, Bhalla Papdi Chat me dahi aur chutney ki wajah se thoda meetha hota hai.'}, 'distances': 1.374517798423767}, {'document': 'South Indian items morning me available hote hain ya full day?', 'id': 'id_370', 'metadatas': {'config_id': 1, 'datasource': 'general_enquiry_agent', 'query': 'South Indian items mostly full day available hote hain.'}, 'distances': 1.3903560638427734}, {'document': 'Oreo Shake me chocolate topping bhi hoti hai kya?', 'id': 'id_380', 'metadatas': {'config_id': 1, 'datasource': 'general_enquiry_agent', 'query': 'Haan, Oreo Shake me chocolate topping bhi hoti hai.'}, 'distances': 1.401269793510437}, {'document': 'Masala Paneer Dosa students ke beech popular hai kya?', 'id': 'id_368', 'metadatas': {'config_id': 1, 'datasource': 'general_enquiry_agent', 'query': 'Haan, Masala Paneer Dosa kaafi popular hai students ke beech.'}, 'distances': 1.4139347076416016}, {'document': 'Mango Shake sirf summer me available hota hai kya?', 'id': 'id_377', 'metadatas': {'config_id': 1, 'datasource': 'general_enquiry_agent', 'query': 'Haan, Mango Shake seasonal hota hai aur mostly summer me milta hai.'}, 'distances': 1.420231819152832}, {'document': 'Papdi Chat ek plate me zyada papdi hoti hai ya kam?', 'id': 'id_386', 'metadatas': {'config_i