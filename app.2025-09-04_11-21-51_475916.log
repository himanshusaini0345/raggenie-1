2025-09-05 11:07:44.635 | INFO     | app.chain.modules.cache_checker:handle:72 - out:[{'_id': ObjectId('68ba6fd4ff185dae514dc975'), 'document': 'show me the salary deduction of ankush verma month of march and april', 'metadatas': {'query': " \n\nSELECT * FROM (SELECT emp.UniversityId,FPN.EmployeeId,FPN.EmployeeName,FPN.FatherName,FPN.DesignationName,FPN.DepartmentName,FPN.PayCycleId,FPN.PayCycleName,emp.JobName,FPN.CurrentBasicSalary,emp.ActionStatusId,\n        ServicesCharge,TransportationCharge,WifiCharge,GailCharge,TDS,Advance,PF AS PF,0 AS RF,MI AS Medical,SEF,SWF AS SWF,0 AS TC,ESI,0 AS SRF,Loan,Intrest AS LoanInterest,OtherDeduction,TotDeductions,AggregateDeduction\n    FROM emp.FinalPayrollforNONTeaching FPN\n    INNER JOIN mst.PayCycle PCL ON FPN.PayCycleId = PCL.Id \n    INNER JOIN emp.vw_EmployeesList emp ON emp.Id = FPN.EmployeeId \n    UNION ALL \n    SELECT  emp.UniversityId,FPN.EmployeeId,FPN.EmployeeName,FPN.FatherName,FPN.DesignationName,FPN.DepartmentName,FPN.PayCycleId,FPN.PayCycleName,emp.JobName,FPN.CurrentBasicSalary,emp.ActionStatusId,\n        ServicesCharge,TransportationCharge,WifiCharge,GailCharge,TDS,Advance,0 AS PF,RF,Medical,SEF,0 AS SWF,TC,0 AS ESI,SRF,Loan,LoanInterest,OtherDeduction,TotDeductions,AggregateDeduction \n\t\tFROM emp.FinalPayrollforTeaching FPN\n    INNER JOIN mst.PayCycle PCL ON FPN.PayCycleId = PCL.Id \n    INNER JOIN emp.vw_EmployeesList emp ON emp.Id = FPN.EmployeeId \n    UNION ALL \n    SELECT \n        emp.UniversityId,FPN.EmployeeId,FPN.EmployeeName,FPN.FatherName,FPN.DesignationName,FPN.DepartmentName,FPN.PayCycleId,FPN.PayCycleName,emp.JobName,FPN.CurrentBasicSalary,emp.ActionStatusId,\n        ServicesCharge,TransportationCharge,WifiCharge,GailCharge,TDS,Advance,0 AS PF,RF,Medical,SEF,0 AS SWF,TC,0 AS ESI,SRF,Loan,LoanInterest,OtherDeduction,TotDeductions,AggregateDeduction\n    FROM emp.FinalPayrollforStipend FPN\n    INNER JOIN mst.PayCycle PCL ON FPN.PayCycleId = PCL.Id   \n    INNER JOIN emp.vw_EmployeesList emp ON emp.Id = FPN.EmployeeId  \n) AS EmployeeSalaryDetails\nWHERE UniversityId = 1 AND ActionStatusId=1 AND  (UPPER(PayCycleName) LIKE '%MAR%' OR UPPER(PayCycleName) LIKE '%APR%'\n)  AND LOWER(EmployeeName) LIKE LOWER('%ankush Verma%')\n\nORDER BY  PayCycleId DESC", 'metadata': '', 'datasource': 'database_agent', 'config_id': 1}, 'score': 0.8370477557182312, 'distances': 0.1629522442817688}, {'_id': ObjectId('68ba6fd4ff185dae514dc8e4'), 'document': 'show me the list of staff who is having salary belween 30000 to 50000', 'metadatas': {'query': '"SELECT *FROM (SELECT FPN.EmployeeId,FPN.EmployeeName,FPN.FatherName,FPN.DesignationName,FPN.DepartmentName,FPN.PayCycleId,FPN.PayCycleName,FCLY.FinancialYearName,JobName,FPN.CurrentBasicSalary\nFROM emp.FinalPayrollforNONTeaching FPN\nINNER JOIN mst.PayCycle PCL ON FPN.PayCycleId = PCL.Id AND PCL.IsDefaltForPayRoll = 1 \nINNER JOIN mst.FinancialYear FCLY ON FCLY.Id = PCL.FinancialYearId AND FCLY.IsDefaultLeave = 1  \nUNION ALL \nSELECT FPN.EmployeeId,FPN.EmployeeName,FPN.FatherName,FPN.DesignationName,FPN.DepartmentName,FPN.PayCycleId,FPN.PayCycleName,FCLY.FinancialYearName,JobName,FPN.CurrentBasicSalary\nFROM emp.FinalPayrollforTeaching FPN\nINNER JOIN mst.PayCycle PCL ON FPN.PayCycleId = PCL.Id  AND PCL.IsDefaltForPayRoll = 1 \nINNER JOIN mst.FinancialYear FCLY ON FCLY.Id = PCL.FinancialYearId AND FCLY.IsDefaultLeave = 1  \nUNION ALL \nSELECT FPN.EmployeeId,FPN.EmployeeName,FPN.FatherName,FPN.DesignationName,FPN.DepartmentName,FPN.PayCycleId,FPN.PayCycleName,FCLY.FinancialYearName,JobName,FPN.CurrentBasicSalary\nFROM emp.FinalPayrollforStipend FPN\nINNER JOIN mst.PayCycle PCL ON FPN.PayCycleId = PCL.Id AND PCL.IsDefaltForPayRoll = 1 \nINNER JOIN mst.FinancialYear FCLY ON FCLY.Id = PCL.FinancialYearId AND FCLY.IsDefaultLeave = 1 \n) AS EmployeeSalaryDetails\nWHERE   TRY_CAST(EmployeeSalaryDetails.CurrentBasicSalary AS float) BETWEEN 30000 AND 50000 "', 'metadata': '', 'datasource': 'database_agent', 'config_id': 1}, 'score': 0.7952913045883179, 'distances': 0.20470869541168213}, {'_id': ObjectId('68ba6fd4ff185dae514dc97b'), 'document': 'show me the list of IT department with the staff names', 'metadatas': {'query': "SELECT Id, EmployeeName, DepartmentName FROM emp.vw_EmployeesList WHERE LOWER(DepartmentName) LIKE LOWER('%information technology%')", 'metadata': '', 'datasource': 'database_agent', 'config_id': 1}, 'score': 0.7712805271148682, 'distances': 0.22871947288513184}, {'_id': ObjectId('68ba6fd4ff185dae514dc8c3'), 'document': 'provide the list of employees having a salary above 2,00,000.', 'metadatas': {'query': '\nSELECT *FROM (\nSELECT emp.UniversityId,FPN.EmployeeId,FPN.EmployeeName,FPN.FatherName,FPN.DesignationName,FPN.DepartmentName,FPN.PayCycleId,FPN.PayCycleName,FCLY.FinancialYearName,emp.JobName,FPN.CurrentBasicSalary,emp.ActionStatusId\nFROM emp.FinalPayrollforNONTeaching FPN\nINNER JOIN mst.PayCycle PCL ON FPN.PayCycleId = PCL.Id AND PCL.IsDefaltForPayRoll = 1 \nINNER JOIN mst.FinancialYear FCLY ON FCLY.Id = PCL.FinancialYearId AND FCLY.IsDefaultLeave = 1  \nINNER JOIN emp.vw_EmployeesList emp ON emp.Id = FPN.EmployeeId \nUNION ALL \nSELECT emp.UniversityId,FPN.EmployeeId,FPN.EmployeeName,FPN.FatherName,FPN.DesignationName,FPN.DepartmentName,FPN.PayCycleId,FPN.PayCycleName,FCLY.FinancialYearName,emp.JobName,FPN.CurrentBasicSalary,emp.ActionStatusId\nFROM emp.FinalPayrollforTeaching FPN\nINNER JOIN mst.PayCycle PCL ON FPN.PayCycleId = PCL.Id  AND PCL.IsDefaltForPayRoll = 1 \nINNER JOIN mst.FinancialYear FCLY ON FCLY.Id = PCL.FinancialYearId AND FCLY.IsDefaultLeave = 1  \nINNER JOIN emp.vw_EmployeesList emp ON emp.Id = FPN.EmployeeId \nUNION ALL \nSELECT emp.UniversityId,FPN.EmployeeId,FPN.EmployeeName,FPN.FatherName,FPN.DesignationName,FPN.DepartmentName,FPN.PayCycleId,FPN.PayCycleName,FCLY.FinancialYearName,emp.JobName,FPN.CurrentBasicSalary,emp.ActionStatusId\nFROM emp.FinalPayrollforStipend FPN\nINNER JOIN mst.PayCycle PCL ON FPN.PayCycleId = PCL.Id AND PCL.IsDefaltForPayRoll = 1 \nINNER JOIN mst.FinancialYear FCLY ON FCLY.Id = PCL.FinancialYearId AND FCLY.IsDefaultLeave = 1 \nINNER JOIN emp.vw_EmployeesList emp ON emp.Id = FPN.EmployeeId  \n) AS EmployeeSalaryDetails\nWHERE  UniversityId=1 AND ActionStatusId=1 AND TRY_CAST(EmployeeSalaryDetails.CurrentBasicSalary AS float) > 200000 ', 'metadata': '', 'datasource': 'database_agent', 'config_id': 1}, 'score': 0.7634366154670715, 'distances': 0.23656338453292847}, {'_id': ObjectId('68ba6fd4ff185dae514dc977'), 'document': 'show me the user profiles of all it employees', 'metadatas': {'query': "SELECT e.Id, e.TitleName, e.EmployeeName, e.FrontImage, e.FatherName, e.DesignationName, e.DepartmentName, e.JoiningDate, ISNULL(exp.Years, 0) AS WorkingExperience, ISNULL(lv.LeaveTaken, 0) AS LeaveTaken, e.Phone, ISNULL(rel.Relatives, '') AS Relatives FROM emp.vw_EmployeesList e LEFT JOIN (SELECT EmployeeId, SUM(DATEDIFF(DAY, JoiningDate, CASE WHEN LeavingDate IS NULL OR LeavingDate = '' OR LeavingDate = '1900-01-01' THEN CAST(GETDATE() AS DATE) ELSE LeavingDate END)) / 365 AS Years FROM emp.WorkingExperience GROUP BY EmployeeId) AS exp ON e.Id = exp.EmployeeId LEFT JOIN (SELECT EmployeeId, SUM(CASE WHEN IsHalf = 1 THEN 0.5 ELSE 1.0 END) AS LeaveTaken FROM emp.LeaveDateWiseDetails WHERE MONTH(LeaveDate) = MONTH(GETDATE()) AND YEAR(LeaveDate) = YEAR(GETDATE()) GROUP BY EmployeeId) AS lv ON e.Id = lv.EmployeeId OUTER APPLY (SELECT STRING_AGG(CONCAT(RelativeName, ', ', EmployeeName, ', ', DesignationName, ', ', DepartmentName, ', ', CollegeName), ': ') AS Relatives FROM emp.vw_RelativesList r WHERE r.EmployeeId = e.Id) AS rel WHERE LOWER(e.DepartmentName) LIKE LOWER('%information technology%');\n", 'metadata': '', 'datasource': 'database_agent', 'config_id': 1}, 'score': 0.7623255252838135, 'distances': 0.23767447471618652}, {'_id': ObjectId('68ba6fd4ff185dae514dc97a'), 'document': 'show me the list of IT department with their name', 'metadatas': {'query': "SELECT Id, DepartmentName FROM mst.Department WHERE LOWER(DepartmentName) LIKE LOWER('%information technology%')", 'metadata': '', 'datasource': 'database_agent', 'config_id': 1}, 'score': 0.7608453035354614, 'distances': 0.23915469646453857}]
