danceDate AS DATETIME) + CAST(MBA.SiftIn AS DATETIME)) END, CASE WHEN A.SiftOut < (CAST(A.AttendanceDate AS DATETIME) + CAST(MBA.SiftOut AS DATETIME)) THEN A.SiftOut ELSE (CAST(A.AttendanceDate AS DATETIME) + CAST(MBA.SiftOut AS DATETIME)) END) % 60 AS VARCHAR), 2) AS DutyHours FROM (SELECT BA.EmployeeId, CAST(BA.AttendanceDate AS DATE) AS AttendanceDate, MIN(CASE WHEN BA.PunchMode = 'In' THEN BA.AttendanceDate END) AS SiftIn, MAX(CASE WHEN BA.PunchMode = 'Out' THEN BA.AttendanceDate END) AS SiftOut, MIN(CASE WHEN BA.PunchMode = 'In' THEN BA.SiftTypeId END) AS SiftTypeId FROM emp.BioAttendance BA WHERE BA.EmployeeId IN (SELECT Id FROM emp.vw_EmployeesList WHERE EmployeeName LIKE 'amil shaji%') AND CAST(BA.AttendanceDate AS DATE) BETWEEN '2025-06-01' AND '2025-06-18' GROUP BY BA.EmployeeId, CAST(BA.AttendanceDate AS DATE)) AS A INNER JOIN emp.vw_EmployeesList E ON A.EmployeeId = E.Id LEFT JOIN mst.BioAttSift MBA ON MBA.Id = A.SiftTypeId ORDER BY A.EmployeeId, A.AttendanceDate;"}, 'distances': 1.1758830547332764}, {'document': 'Can you provide the arrear details for amil shaji?', 'id': 'id_306', 'metadatas': {'config_id': 1, 'datasource': 'database_agent', 'metadata': '', 'query': "SELECT Id, EmployeeName, AllowanceArrear, BasicSalaryArrear, OtArrear FROM emp.FinalPayrollforStipend WHERE LOWER(EmployeeName) LIKE LOWER('amil shaji%') UNION ALL SELECT Id, EmployeeName, AllowanceArrear, BasicSalaryArrear, OtArrear FROM emp.FinalPayrollforTeaching WHERE LOWER(EmployeeName) LIKE LOWER('amil shaji%') UNION ALL SELECT Id, EmployeeName, AllowanceArrear, BasicSalaryArrear, OtArrear FROM emp.FinalPayrollforNonTeaching WHERE LOWER(EmployeeName) LIKE LOWER('amil shaji%');\n"}, 'distances': 1.2466121912002563}, {'document': 'show me the accommodation details of amil shaji', 'id': 'id_206', 'metadatas': {'config_id': 1, 'datasource': 'database_agent', 'metadata': '', 'query': "\nSELECT AA.Id, AA.EmployeeId, AA.EmployeeName, AA.FatherName, AA.BuildingName, AA.WingName, AA.FloorName,