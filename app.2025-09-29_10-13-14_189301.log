alanceLeave, ISNULL(TL.TakenLeave, 0) AS TakenLeave,\n(LB.BalanceLeave - ISNULL(TL.TakenLeave, 0)) AS LeaveBalance FROM emp.LeaveBalance LB\nINNER JOIN emp.VW_EmployeesList EMP ON LB.EmployeeId = EMP.Id\nINNER JOIN mst.LeaveType LT ON LT.Id = LB.LeaveTypeId\nLEFT JOIN (SELECT EmployeeId, LeaveTypeId,SUM(TotalLeave) AS TakenLeave FROM emp.LeaveDateWiseDetails \nWHERE  ActionStatusId = 9  AND ApprovedActionStatusId = 8 AND LeaveDate >= DATEFROMPARTS(YEAR(GETDATE()), 1, 1) GROUP BY EmployeeId, LeaveTypeId) TL\nON LB.EmployeeId = TL.EmployeeId AND LB.LeaveTypeId = TL.LeaveTypeId\nWHERE EMP.EmployeeName LIKE 'Shivdatt%'  AND LT.LeaveTypeName LIKE 'Earned Leave%' AND LB.CreateDate >= DATEFROMPARTS(YEAR(GETDATE()), 1, 1)", 'metadata': '', 'datasource': 'database_agent', 'config_id': 1}, 'score': 0.8147257566452026, 'distances': 0.18527424335479736}, {'_id': ObjectId('68dc97559119177621c0cc3e'), 'document': 'When did Shivdatt take leave last time? OR What type of leave did Shivdatt apply for last?', 'metadatas': {'query': "SELECT TOP 1 LEA.EmployeeId,LEA.LeaveDate,LT.LeaveTypeName,EMP.JobName,EMP.EmployeeName,EMP.FatherName,EMP.DesignationName,EMP.DepartmentName FROM emp.LeaveDateWiseDetails LEA\nINNER JOIN emp.vw_EmployeesList EMP ON LEA.EmployeeId=EMP.Id\nINNER JOIN mst.LeaveType LT ON LT.Id=LEA.LeaveTypeId\nWHERE EMP.EmployeeName LIKE 'Shivdatt%' AND LEA.RecomActionStatusId=9 AND LEA.LeaveDate >=DATEFROMPARTS(YEAR(GETDATE()), 1, 1) \nORDER BY LEA.Id DESC", 'metadata': '', 'datasource': 'database_agent', 'config_id': 1}, 'score': 0.8011297583580017, 'distances': 0.1988702416419983}, {'_id': ObjectId('68dc97559119177621c0cc42'), 'document': 'What was the room rent for Shivdatt last month?', 'metadatas': {'query': "SELECT  TOP 1 EmployeeName,FatherName,BuildingName,RoomNo,RoomCharge,RentalItemCharge,GarbageCharge,ELECtricMeaterCharge,ELCTNetReading UseElecUnit,NetServiceCharge TotalCharge FROM (\nSELECT TOP 2 * FROM acom.ServicesCharges WHERE EmployeeName Like 'Shivdatt%' ORDER BY Id DESC) AS sub\nORDER BY Id ASC", 'metadata': '', 'datasource': 'database_agent', 'config_id': 1}, 'score': 0.7784199714660645, 'distances': 0.22158002853393555}, {'_id': ObjectId('68dc97559119177621c0cc4e'), 'document': 'How many times did Shivdatt come late to the office last year?', 'metadatas': {'query': "SELECT BIO.EmployeeId,EMP.JobName,EMP.JobName,EMP.EmployeeName,EMP.FatherName,EMP.DesignationName,EMP.DepartmentName,BIO.AttendanceDate FROM emp.BioAttendance BIO\nINNER JOIN emp.vw_EmployeesList EMP ON BIO.EmployeeId=EMP.Id INNER JOIN mst.BioAttSift BS ON BS.Id=BIO.SiftTypeId \nWHERE CONVERT(varchar(5), BIO.AttendanceDate, 108) > BS.SiftIn \nAND BIO.AttendanceDate >= DATEFROMPARTS(YEAR(GETDATE()) - 1, 1, 1) AND BIO.AttendanceDate < DATEFROMPARTS(YEAR(GETDATE()), 1, 1)\nAND DATEPART(WEEKDAY, BIO.AttendanceDate) != 1 \nAND BIO.PunchMode='IN'AND EMP.EmployeeName LIKE 'Shivdatt%'\nORDER BY BIO.AttendanceDate ", 'metadata': '', 'datasource': 'database_agent', 'config_id': 1}, 'score': 0.7624998092651367, 'distances': 0.23750019073486328}]
