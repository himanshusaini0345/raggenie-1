AST(MBA.SiftIn AS DATETIME)) END, CASE WHEN A.SiftOut < (CAST(A.AttendanceDate AS DATETIME) + CAST(MBA.SiftOut AS DATETIME)) THEN A.SiftOut ELSE (CAST(A.AttendanceDate AS DATETIME) + CAST(MBA.SiftOut AS DATETIME)) END) / 60 AS VARCHAR), 2) + \':\' + RIGHT(\'0\' + CAST(DATEDIFF(MINUTE, CASE WHEN A.SiftIn > (CAST(A.AttendanceDate AS DATETIME) + CAST(MBA.SiftIn AS DATETIME)) THEN A.SiftIn ELSE (CAST(A.AttendanceDate AS DATETIME) + CAST(MBA.SiftIn AS DATETIME)) END, CASE WHEN A.SiftOut < (CAST(A.AttendanceDate AS DATETIME) + CAST(MBA.SiftOut AS DATETIME)) THEN A.SiftOut ELSE (CAST(A.AttendanceDate AS DATETIME) + CAST(MBA.SiftOut AS DATETIME)) END) % 60 AS VARCHAR), 2) AS DutyHours FROM (SELECT BA.EmployeeId, CAST(BA.AttendanceDate AS DATE) AS AttendanceDate, MIN(CASE WHEN BA.PunchMode = \'In\' THEN BA.AttendanceDate END) AS SiftIn, MAX(CASE WHEN BA.PunchMode = \'Out\' THEN BA.AttendanceDate END) AS SiftOut, MIN(CASE WHEN BA.PunchMode = \'In\' THEN BA.SiftTypeId END) AS SiftTypeId FROM emp.BioAttendance BA WHERE BA.EmployeeId IN (SELECT Id FROM emp.vw_EmployeesList WHERE LOWER(EmployeeName) LIKE \'vievek tiwari%\') AND CAST(BA.AttendanceDate AS DATE) BETWEEN \'2025-06-01\' AND \'2025-06-18\' GROUP BY BA.EmployeeId, CAST(BA.AttendanceDate AS DATE)) AS A INNER JOIN emp.vw_EmployeesList E ON A.EmployeeId = E.Id LEFT JOIN mst.BioAttSift MBA ON MBA.Id = A.SiftTypeId ORDER BY A.EmployeeId, A.AttendanceDate;",\n    "operation_kind": "aggregation",\n    "schema": "emp.vw_EmployeesList, emp.BioAttendance, mst.BioAttSift",\n    "main_schema": "emp.vw_EmployeesList",\n    "confidence": "100",\n    "visualisation": {\n        "type": "table",\n        "x-axis": ["AttendanceDate"],\n        "y-axis": ["LateMins", "OTHours", "DutyHours"],\n        "title": "Attendance Details for Vievek Tiwari"\n    },\n    "intent": "database_query",\n    "general_message": "Here are the attendance details for Vievek Tiwari.",\n    "empty_message": "No attendance data found for Vievek Tiwari. Please 