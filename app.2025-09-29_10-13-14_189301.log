            question: punch out time for himanshu saini of it department on 10 may
query: select e.EmployeeName, b.PunchMode,b.AttendanceDate 
from emp.bioattendance b
left join emp.vw_EmployeesList e on b.EmployeeId = e.Id 
where e.EmployeeName = 'himanshu saini'
and e.DepartmentName = 'information technology'
and cast(b.AttendanceDate as date) = '2025-05-10'
and b.PunchMode = 'out'

question: how many employees were on leave in it department this month
query: SELECT ld.EmployeeId, ev.EmployeeName, ev.DepartmentName, ev.DesignationName, COUNT(*) AS LeavesTaken FROM emp.LeaveDateWiseDetails ld INNER JOIN emp.vw_EmployeesList ev ON ld.EmployeeId = ev.Id WHERE ev.DepartmentName LIKE '%information technology%' AND ld.LeaveDate BETWEEN '2025-06-01' AND GETDATE() AND ld.ActionStatusId = 4 AND ld.ApprovedActionStatusId = 4 GROUP BY ld.EmployeeId, ev.EmployeeName, ev.DepartmentName, ev.DesignationName;


question: show me the list of IT department with their name
query: SELECT Id, DepartmentName FROM mst.Department WHERE LOWER(DepartmentName) LIKE LOWER('%information technology%')

question: how many employees were on leave in it department for last month
query: SELECT ld.EmployeeId, ev.EmployeeName, ev.DepartmentName, ev.DesignationName, COUNT(*) AS LeavesTaken FROM emp.LeaveDateWiseDetails ld INNER JOIN emp.vw_EmployeesList ev ON ld.EmployeeId = ev.Id WHERE LOWER(ev.DepartmentName) LIKE '%information technology%' AND ld.LeaveDate >= CONVERT(varchar(10), DATEFROMPARTS(YEAR(GETDATE()), MONTH(DATEADD(MONTH, -1, GETDATE())), 1), 120) AND ld.LeaveDate <= CONVERT(varchar(10), EOMONTH(DATEADD(MONTH, -1, GETDATE())), 120) AND ld.ActionStatusId = 4 AND ld.ApprovedActionStatusId = 4 GROUP BY ld.EmployeeId, ev.EmployeeName, ev.DepartmentName, ev.DesignationName;

question: show me the list of IT department with the staff names
query: SELECT Id, EmployeeName, DepartmentName FROM emp.vw_EmployeesList WHERE LOWER(DepartmentName) LIKE LOWER('%information technology%')

question: What is the headcount of IT staff on leave this month?
query: SELECT ld.EmployeeId, ev.EmployeeName, ev.DepartmentName, ev.DesignationName, COUNT(*) AS LeavesTaken FROM emp.LeaveDateWiseDetails ld INNER JOIN emp.vw_EmployeesList ev ON ld.EmployeeId = ev.Id WHERE LOWER(ev.DepartmentName) LIKE '%information technology%' AND ld.LeaveDate >= CONVERT(varchar(10), DATEFROMPARTS(YEAR(GETDATE()), MONTH(GETDATE()), 1), 120) AND ld.LeaveDate <= GETDATE() AND ld.ActionStatusId = 4 AND ld.ApprovedActionStatusId = 4 GROUP BY ld.EmployeeId, ev.EmployeeName, ev.DepartmentName, ev.DesignationName;


