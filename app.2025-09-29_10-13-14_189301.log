urrSalary, TRY_CAST(prev.CurrentBasicSalary AS DECIMAL(18,2)) AS PrevSalary FROM (SELECT EmployeeId, CurrentBasicSalary, TRY_CAST(LEFT(PayCycleName, 11) AS DATE) AS PayCycleStart FROM emp.FinalPayrollforTeaching WHERE ISNUMERIC(CurrentBasicSalary) = 1 UNION ALL SELECT EmployeeId, CurrentBasicSalary, TRY_CAST(LEFT(PayCycleName, 11) AS DATE) AS PayCycleStart FROM emp.FinalPayrollforNONTeaching WHERE ISNUMERIC(CurrentBasicSalary) = 1) AS curr INNER JOIN (SELECT EmployeeId, CurrentBasicSalary, TRY_CAST(LEFT(PayCycleName, 11) AS DATE) AS PayCycleStart FROM emp.FinalPayrollforTeaching WHERE ISNUMERIC(CurrentBasicSalary) = 1 UNION ALL SELECT EmployeeId, CurrentBasicSalary, TRY_CAST(LEFT(PayCycleName, 11) AS DATE) AS PayCycleStart FROM emp.FinalPayrollforNONTeaching WHERE ISNUMERIC(CurrentBasicSalary) = 1) AS prev ON curr.EmployeeId = prev.EmployeeId WHERE MONTH(curr.PayCycleStart) = 5 AND YEAR(curr.PayCycleStart) = YEAR(GETDATE()) AND MONTH(prev.PayCycleStart) = 5 AND YEAR(prev.PayCycleStart) = YEAR(GETDATE()) - 1) AS FinalData WHERE CurrSalary IS NOT NULL AND PrevSalary IS NOT NULL AND CurrSalary - PrevSalary > 5000;\n', 'metadata': '', 'datasource': 'database_agent', 'config_id': 1}, 'score': 0.6983113288879395, 'distances': 0.30168867111206055}]
