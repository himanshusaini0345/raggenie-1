d = FPN.EmployeeId \n    UNION ALL \n    SELECT \n        emp.UniversityId,FPN.EmployeeId,FPN.EmployeeName,FPN.FatherName,FPN.DesignationName,FPN.DepartmentName,FPN.PayCycleId,FPN.PayCycleName,emp.JobName,FPN.CurrentBasicSalary,emp.ActionStatusId,\n        ServicesCharge,TransportationCharge,WifiCharge,GailCharge,TDS,Advance,0 AS PF,RF,Medical,SEF,0 AS SWF,TC,0 AS ESI,SRF,Loan,LoanInterest,OtherDeduction,TotDeductions,AggregateDeduction\n    FROM emp.FinalPayrollforStipend FPN\n    INNER JOIN mst.PayCycle PCL ON FPN.PayCycleId = PCL.Id   \n    INNER JOIN emp.vw_EmployeesList emp ON emp.Id = FPN.EmployeeId  \n) AS EmployeeSalaryDetails\nWHERE UniversityId = 1 AND ActionStatusId=1 AND  (UPPER(PayCycleName) LIKE '%MAR%' OR UPPER(PayCycleName) LIKE '%APR%'\n)  AND LOWER(EmployeeName) LIKE LOWER('%ankush Verma%')\n\nORDER BY  PayCycleId DESC", 'metadata': '', 'datasource': 'database_agent', 'config_id': 1}, 'score': 0.7205217480659485, 'distances': 0.2794782519340515}, {'_id': ObjectId('68dc97559119177621c0cca8'), 'document': 'How many employees received a salary hike of more than ₹5000?', 'metadatas': {'query': 'SELECT COUNT(*) AS EmployeesWithHikeOver5000 FROM (SELECT curr.EmployeeId, TRY_CAST(curr.CurrentBasicSalary AS DECIMAL(18,2)) AS CurrSalary, TRY_CAST(prev.CurrentBasicSalary AS DECIMAL(18,2)) AS PrevSalary FROM (SELECT EmployeeId, CurrentBasicSalary, TRY_CAST(LEFT(PayCycleName, 11) AS DATE) AS PayCycleStart FROM emp.FinalPayrollforTeaching WHERE ISNUMERIC(CurrentBasicSalary) = 1 UNION ALL SELECT EmployeeId, CurrentBasicSalary, TRY_CAST(LEFT(PayCycleName, 11) AS DATE) AS PayCycleStart FROM emp.FinalPayrollforNONTeaching WHERE ISNUMERIC(CurrentBasicSalary) = 1) AS curr INNER JOIN (SELECT EmployeeId, CurrentBasicSalary, TRY_CAST(LEFT(PayCycleName, 11) AS DATE) AS PayCycleStart FROM emp.FinalPayrollforTeaching WHERE ISNUMERIC(CurrentBasicSalary) = 1 UNION ALL SELECT EmployeeId, CurrentBasicSalary, TRY_CAST(LEFT(PayCycleName, 11) AS DATE) AS PayCycleStart FROM emp.FinalPayrollforNONTeaching WHERE ISNUMERIC(CurrentBasicSalary) = 1) AS prev ON curr.EmployeeId = prev.EmployeeId WHERE MONTH(curr.PayCycleStart) = 5 AND YEAR(curr.PayCycleStart) = YEAR(GETDATE()) AND MONTH(prev.PayCycleStart) = 5 AND YEAR(prev.PayCycleStart) = YEAR(GETDATE()) - 1) AS FinalData WHERE CurrSalary IS NOT NULL AND PrevSalary IS NOT NULL AND CurrSalary - PrevSalary > 5000;\n', 'metadata': '', 'datasource': 'database_agent', 'config_id': 1}, 'score': 0.7153671979904175, 'distances': 0.2846328020095825}, {'_id': ObjectId('68dc97559119177621c0cca6'), 'document': 'How many employees received a salary hike of more than ₹5000?', 'metadatas': {'query': 'SELECT COUNT(*) AS EmployeesWithHikeOver5000 FROM (SELECT curr.EmployeeId, TRY_CAST(curr.CurrentBasicSalary AS DECIMAL(18,2)) AS CurrSalary, TRY_CAST(prev.CurrentBasicSalary AS DECIMAL(18,2)) AS PrevSalary FROM (SELECT EmployeeId, CurrentBasicSalary, TRY_CAST(LEFT(PayCycleName, 11) AS DATE) AS PayCycleStart FROM emp.FinalPayrollforTeaching WHERE ISNUMERIC(CurrentBasicSalary) = 1 UNION ALL SELECT EmployeeId, CurrentBasicSalary, TRY_CAST(LEFT(PayCycleName, 11) AS DATE) AS PayCycleStart FROM emp.FinalPayrollforNONTeaching WHERE ISNUMERIC(CurrentBasicSalary) = 1) AS curr INNER JOIN (SELECT EmployeeId, CurrentBasicSalary, TRY_CAST(LEFT(PayCycleName, 11) AS DATE) AS PayCycleStart FROM emp.FinalPayrollforTeaching WHERE ISNUMERIC(CurrentBasicSalary) = 1 UNION ALL SELECT EmployeeId, CurrentBasicSalary, TRY_CAST(LEFT(PayCycleName, 11) AS DATE) AS PayCycleStart FROM emp.FinalPayrollforNONTeaching WHERE ISNUMERIC(CurrentBasicSalary) = 1) AS prev ON curr.EmployeeId = prev.EmployeeId WHERE MONTH(curr.PayCycleStart) = 5 AND YEAR(curr.PayCycleStart) = YEAR(GETDATE()) AND MONTH(prev.PayCycleStart) = 5 AND YEAR(prev.PayCycleStart) = YEAR(GETDATE()) - 1) AS FinalData WHERE CurrSalary IS NOT NULL AND PrevSalary IS NOT NULL AND CurrSalary - PrevSalary > 5000;\n', 'metadata': '', 'datasource': 'database_agent', 'config_id': 1}, 'score': 0.7153671979904175, 'distances': 0.2846328020095825}, {'_id': ObjectId('68dc97559119177621c0cbf5'), 'document': 'show me the list of staff who is having salary belween 30000 to 50000', 'metadatas': {'query': '"SELECT *FROM (SELECT FPN.EmployeeId,FPN.EmployeeName,FPN.FatherName,FPN.DesignationName,FPN.DepartmentName,FPN.PayCycleId,FPN.PayCycleName,FCLY.FinancialYearName,JobName,FPN.CurrentBasicSalary\nFROM emp.FinalPayrollforNONTeaching FPN\nINNER JOIN mst.PayCycle PCL ON FPN.PayCycleId = PCL.Id AND PCL.IsDefaltForPayRoll = 1 \nINNER JOIN mst.FinancialYear FCLY ON FCLY.Id = PCL.FinancialYearId AND FCLY.IsDefaultLeave = 1  \nUNION ALL \nSELECT FPN.EmployeeId,FPN.EmployeeName,FPN.FatherName,FPN.DesignationName,FPN.DepartmentName,FPN.PayCycleId,FPN.PayCycleName,FCLY.FinancialYearName,JobName,FPN.CurrentBasicSalary\nFROM emp.FinalPayrollforTeaching FPN\nINNER JOIN mst.PayCycle PCL ON FPN.PayCycleId = PCL.Id  AND PCL.IsDefaltForPayRoll = 1 \nINNER JOIN mst.FinancialYear FCLY ON FCLY.Id = PCL.FinancialYearId AND FCLY.IsDefaultLeave = 1  \nUNION ALL \nSELECT FPN.EmployeeId,FPN.EmployeeName,FPN.FatherName,FPN.DesignationName,FPN.DepartmentName,FPN.PayCycleId,FPN.PayCycleName,FCLY.FinancialYearName,JobName,FPN.CurrentBasicSalary\nFROM emp.FinalPayrollforStipend FPN\nINNER JOIN mst.PayCycle PCL ON FPN.PayCycleId = PCL.Id AND PCL.IsDefaltForPayRoll = 1 \nINNER JOIN mst.FinancialYear FCLY ON FCLY.Id = PCL.FinancialYearId AND FCLY.IsDefaultLeave = 1 \n) AS EmployeeSalaryDetails\nWHERE   TRY_CAST(EmployeeSalaryDetails.CurrentBasicSalary AS float) BETWEEN 30000 AND 50000 "', 'metadata': '', 'datasource': 'database_agent', 'config_id': 1}, 'score': 0.7084450721740723, 'distances': 0.29155492782592773}, {'_id': ObjectId('68dc97559119177621c0cca5'), 'document': 'count of employees who received a salary increase of more than ₹5000', 'metadatas': {'query': 'SELECT COUNT(*) AS EmployeesWithHikeOver5000 FROM (SELECT curr.EmployeeId, TRY_CAST(curr.CurrentBasicSalary AS DECIMAL(18,2)) AS CurrSalary, TRY_CAST(prev.CurrentBasicSalary AS DECIMAL(18,2)) AS PrevSalary FROM (SELECT EmployeeId, CurrentBasicSalary, TRY_CAST(LEFT(PayCycleName, 11) AS DATE) AS PayCycleStart FROM emp.FinalPayrollforTeaching WHERE ISNUMERIC(CurrentBasicSalary) = 1 UNION ALL SELECT EmployeeId, CurrentBasicSalary, TRY_CAST(LEFT(PayCycleName, 11) AS DATE) AS PayCycleStart FROM emp.FinalPayrollforNONTeaching WHERE ISNUMERIC(CurrentBasicSalary) = 1) AS curr INNER JOIN (SELECT EmployeeId, CurrentBasicSalary, TRY_CAST(LEFT(PayCycleName, 11) AS DATE) AS PayCycleStart FROM emp.FinalPayrollforTeaching WHERE ISNUMERIC(CurrentBasicSalary) = 1 UNION ALL SELECT EmployeeId, CurrentBasicSalary, TRY_CAST(LEFT(PayCycleName, 11) AS DATE) AS PayCycleStart FROM emp.FinalPayrollforNONTeaching WHERE ISNUMERIC(CurrentBasicSalary) = 1) AS prev ON curr.EmployeeId = prev.EmployeeId WHERE MONTH(curr.PayCycleStart) = 5 AND YEAR(curr.PayCycleStart) = YEAR(GETDATE()) AND MONTH(prev.PayCycleStart) = 5 AND YEAR(prev.PayCycleStart) = YEAR(GETDATE()) - 1) AS FinalData WHERE CurrSalary IS NOT NULL AND PrevSalary IS NOT NULL AND CurrSalary - PrevSalary > 5000;\n', 'metadata': '', 'datasource': 'database_agent', 'config_id': 1}, 'score': 0.6983113288879395, 'distances': 0.30168867111206055}]
