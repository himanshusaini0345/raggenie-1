CAST(A.AttendanceDate AS DATETIME) + CAST(MBA.SiftOut AS DATETIME)) THEN A.SiftOut ELSE (CAST(A.AttendanceDate AS DATETIME) + CAST(MBA.SiftOut AS DATETIME)) END) % 60 AS VARCHAR), 2) AS DutyHours FROM (SELECT BA.EmployeeId, CAST(BA.AttendanceDate AS DATE) AS AttendanceDate, MIN(CASE WHEN BA.PunchMode = 'In' THEN BA.AttendanceDate END) AS SiftIn, MAX(CASE WHEN BA.PunchMode = 'Out' THEN BA.AttendanceDate END) AS SiftOut, MIN(CASE WHEN BA.PunchMode = 'In' THEN BA.SiftTypeId END) AS SiftTypeId FROM emp.BioAttendance BA WHERE BA.EmployeeId IN (SELECT Id FROM emp.vw_EmployeesList WHERE EmployeeName LIKE 'vvvv ttt%') AND CAST(BA.AttendanceDate AS DATE) BETWEEN '2025-06-01' AND '2025-06-18' GROUP BY BA.EmployeeId, CAST(BA.AttendanceDate AS DATE)) AS A INNER JOIN emp.vw_EmployeesList E ON A.EmployeeId = E.Id LEFT JOIN mst.BioAttSift MBA ON MBA.Id = A.SiftTypeId ORDER BY A.EmployeeId, A.AttendanceDate;", 'metadata': '', 'datasource': 'database_agent', 'config_id': 1}, 'score': 0.8275720477104187, 'distances': 0.1724279522895813}, {'_id': ObjectId('68dcc7966160c4833b5809c5'), 'document': 'age of vk ti', 'metadatas': {'query': "SELECT Id, EmployeeName, UserDOB, DATEDIFF(YEAR, TRY_CAST(UserDOB AS date), GETDATE()) AS Age FROM emp.vw_EmployeesList WHERE ActionStatusId=1 AND LOWER(EmployeeName) LIKE LOWER('vk ti%')", 'metadata': '', 'datasource': 'database_agent', 'config_id': 1}, 'score': 0.7719143629074097, 'distances': 0.22808563709259033}]
