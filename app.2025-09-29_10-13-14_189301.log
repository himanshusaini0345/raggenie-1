            question: how many CL leave taken by shivdatt in current year
query: SELECT LEV.EmployeeId,EMP.JobName,EMP.EmployeeName,EMP.DesignationName,EMP.DepartmentName,EMP.EmployeeName,EMP.FatherName,LT.LeaveTypeName,LEV.LeaveDate FROM emp.LeaveDateWiseDetails LEV
INNER JOIN emp.VW_EmployeesList EMP ON LEV.EmployeeId=EMP.Id 
INNER JOIN mst.LeaveType LT ON LT.Id=LEV.LeaveTypeId 
WHERE LEV.ActionStatusId=9 AND LEV.ApprovedActionStatusId=8 
AND EMP.EmployeeName LIKE 'Shivdatt%' AND LT.LeaveTypeName LIKE 'Casual%'
AND LEV.LeaveDate >= DATEFROMPARTS(YEAR(GETDATE()),1, 1)  ORDER BY LEV.LeaveDate

question: What is the current Earned Leave(EL) balance of Shivdatt?
query: SELECT  LB.EmployeeId,EMP.JobName,EMP.EmployeeName,EMP.DesignationName,EMP.DepartmentName, EMP.FatherName,LT.LeaveTypeName,LB.BalanceLeave, ISNULL(TL.TakenLeave, 0) AS TakenLeave,
(LB.BalanceLeave - ISNULL(TL.TakenLeave, 0)) AS LeaveBalance FROM emp.LeaveBalance LB
INNER JOIN emp.VW_EmployeesList EMP ON LB.EmployeeId = EMP.Id
INNER JOIN mst.LeaveType LT ON LT.Id = LB.LeaveTypeId
LEFT JOIN (SELECT EmployeeId, LeaveTypeId,SUM(TotalLeave) AS TakenLeave FROM emp.LeaveDateWiseDetails 
WHERE  ActionStatusId = 9  AND ApprovedActionStatusId = 8 AND LeaveDate >= DATEFROMPARTS(YEAR(GETDATE()), 1, 1) GROUP BY EmployeeId, LeaveTypeId) TL
ON LB.EmployeeId = TL.EmployeeId AND LB.LeaveTypeId = TL.LeaveTypeId
WHERE EMP.EmployeeName LIKE 'Shivdatt%'  AND LT.LeaveTypeName LIKE 'Earned Leave%' AND LB.CreateDate >= DATEFROMPARTS(YEAR(GETDATE()), 1, 1)

question: how many CL leave taken by shivdatt in last year
query: SELECT LEV.EmployeeId,EMP.JobName,EMP.EmployeeName,EMP.DesignationName,EMP.DepartmentName,EMP.EmployeeName,EMP.FatherName,LT.LeaveTypeName,LEV.LeaveDate FROM emp.LeaveDateWiseDetails LEV
INNER JOIN emp.VW_EmployeesList EMP ON LEV.EmployeeId=EMP.Id 
INNER JOIN mst.LeaveType LT ON LT.Id=LEV.LeaveTypeId 
WHERE LEV.ActionStatusId=9 AND LEV.ApprovedActionStatusId=8 
AND EMP.EmployeeName LIKE 'Shivdatt%' AND LT.LeaveTypeName LIKE 'Casual%'
AND LEV.LeaveDate >=DATEFROMPARTS(YEAR(GETDATE()) - 1, 1, 1)
AND LEV.LeaveDate <  DATEFROMPARTS(YEAR(GETDATE()), 1, 1)
ORDER BY LEV.LeaveDate

question: When did Shivdatt take leave last time? OR What type of leave did Shivdatt apply for last?
query: SELECT TOP 1 LEA.EmployeeId,LEA.LeaveDate,LT.LeaveTypeName,EMP.JobName,EMP.EmployeeName,EMP.FatherName,EMP.DesignationName,EMP.DepartmentName FROM emp.LeaveDateWiseDetails LEA
INNER JOIN emp.vw_EmployeesList EMP ON LEA.EmployeeId=EMP.Id
INNER JOIN mst.LeaveType LT ON LT.Id=LEA.LeaveTypeId
WHERE EMP.EmployeeName LIKE 'Shivdatt%' AND LEA.RecomActionStatusId=9 AND LEA.LeaveDate >=DATEFROMPARTS(YEAR(GETDATE()), 1, 1) 
ORDER BY LEA.Id DESC

question: What was the room rent for Shivdatt last month?
query: SELECT  TOP 1 EmployeeName,FatherName,BuildingName,RoomNo,RoomCharge,RentalItemCharge,GarbageCharge,ELECtricMeaterCharge,ELCTNetReading UseElecUnit,NetServiceCharge TotalCharge FROM (
SELECT TOP 2 * FROM acom.ServicesCharges WHERE EmployeeName Like 'Shivdatt%' ORDER BY Id DESC) AS sub
ORDER BY Id ASC

question: How many times did Shivdatt come late to the office last year?
query: SELECT BIO.EmployeeId,EMP.JobName,EMP.JobName,EMP.EmployeeName,EMP.FatherName,EMP.DesignationName,EMP.DepartmentName,BIO.AttendanceDate FROM emp.BioAttendance BIO
INNER JOIN emp.vw_EmployeesList EMP ON BIO.EmployeeId=EMP.Id INNER JOIN mst.BioAttSift BS ON BS.Id=BIO.SiftTypeId 
WHERE CONVERT(varchar(5), BIO.AttendanceDate, 108) > BS.SiftIn 
AND BIO.AttendanceDate >= DATEFROMPARTS(YEAR(GETDATE()) - 1, 1, 1) AND BIO.AttendanceDate < DATEFROMPARTS(YEAR(GETDATE()), 1, 1)
AND DATEPART(WEEKDAY, BIO.AttendanceDate) != 1 
AND BIO.PunchMode='IN'AND EMP.EmployeeName LIKE 'Shivdatt%'
ORDER BY BIO.AttendanceDate 


