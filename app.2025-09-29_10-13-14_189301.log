query: SELECT EA.Id,EA.EmployeeId,emp.EmployeeName,emp.FatherName,EA.AddressTypeName,EA.Address,EA.StateName,EA.CityName,EA.PinCode FROM  emp.vw_EmployeesAddressList EA
 INNER JOIn emp.Employees emp ON emp.Id=EA.EmployeeId AND emp.ActionStatusId=1
 WHERE EA.ActionStatusId=1 AND EmployeeName LIKE 'xxxx xx%' 
 ORDER BY EA.EmployeeId,EA.AddressTypeName DESC


