ek Tiwari', 'FrontImage': '/Uploads/Employee/Profile/20210121115600.jpg', 'DepartmentName': 'INFORMATION TECHNOLOGY', 'AttendanceDate': '2025-06-14', 'SiftIn': '2025-06-14T09:05:53.990000', 'SiftOut': '2025-06-14T09:42:19.690000', 'SiftTypeId': 40, 'SiftName': 'SFT:A8', 'LateMins': '01:05', 'OTHours': '00:00', 'DutyHours': '00:37'}], 'main_entity': 'Employee Attendance', 'main_format': 'aggregation', 'role': 'assistant', 'content': 'Here is the attendance details for Vivek Tiwari.', 'context_id': 'dds', 'question': 'attedence of vivek tiwari', 'query': "SELECT A.EmployeeId, E.EmployeeName, E.FrontImage, E.DepartmentName, A.AttendanceDate, A.SiftIn, A.SiftOut, A.SiftTypeId, MBA.SiftName, RIGHT('0' + CAST(CASE WHEN A.SiftIn > (CAST(A.AttendanceDate AS DATETIME) + CAST(MBA.SiftIn AS DATETIME)) THEN DATEDIFF(MINUTE, CAST(A.AttendanceDate AS DATETIME) + CAST(MBA.SiftIn AS DATETIME), A.SiftIn) ELSE 0 END / 60 AS VARCHAR), 2) + ':' + RIGHT('0' + CAST(CASE WHEN A.SiftIn > (CAST(A.AttendanceDate AS DATETIME) + CAST(MBA.SiftIn AS DATETIME)) THEN DATEDIFF(MINUTE, CAST(A.AttendanceDate AS DATETIME) + CAST(MBA.SiftIn AS DATETIME), A.SiftIn) ELSE 0 END % 60 AS VARCHAR), 2) AS LateMins, RIGHT('0' + CAST(CASE WHEN A.SiftOut > (CAST(A.AttendanceDate AS DATETIME) + CAST(MBA.SiftOut AS DATETIME)) THEN DATEDIFF(MINUTE, CAST(A.AttendanceDate AS DATETIME) + CAST(MBA.SiftOut AS DATETIME), A.SiftOut) ELSE 0 END / 60 AS VARCHAR), 2) + ':' + RIGHT('0' + CAST(CASE WHEN A.SiftOut > (CAST(A.AttendanceDate AS DATETIME) + CAST(MBA.SiftOut AS DATETIME)) THEN DATEDIFF(MINUTE, CAST(A.AttendanceDate AS DATETIME) + CAST(MBA.SiftOut AS DATETIME), A.SiftOut) ELSE 0 END % 60 AS VARCHAR), 2) AS OTHours, RIGHT('0' + CAST(DATEDIFF(MINUTE, CASE WHEN A.SiftIn > (CAST(A.AttendanceDate AS DATETIME) + CAST(MBA.SiftIn AS DATETIME)) THEN A.SiftIn ELSE (CAST(A.AttendanceDate AS DATETIME) + CAST(MBA.SiftIn AS DATETIME)) END, CASE WHEN A.SiftOut < (CAST(A.AttendanceDate AS DATETIME) + CAST(MBA.SiftOut AS DATETIME)) THEN A.SiftOut ELSE (CAST(A.AttendanceDate AS DATETIME) + CAST(MBA.SiftOut AS DATETIME)) END) / 60 AS VARCHAR), 2) + ':' + RIGHT('0' + CAST(DATEDIFF(MINUTE, CASE WHEN A.SiftIn > (CAST(A.AttendanceDate AS DATETIME) + CAST(MBA.SiftIn AS DATETIME)) THEN A.SiftIn ELSE (CAST(A.AttendanceDate AS DATETIME) + CAST(MBA.SiftIn AS DATETIME)) END, CASE WHEN A.SiftOut < (CAST(A.AttendanceDate AS DATETIME) + CAST(MBA.SiftOut AS DATETIME)) THEN A.SiftOut ELSE (CAST(A.AttendanceDate AS DATETIME) + CAST(MBA.SiftOut AS DATETIME)) END) % 60 AS VARCHAR), 2) AS DutyHours FROM (SELECT BA.EmployeeId, CAST(BA.AttendanceDate AS DATE) AS AttendanceDate, MIN(CASE WHEN BA.PunchMode = 'In' THEN BA.AttendanceDate END) AS SiftIn, MAX(CASE WHEN BA.PunchMode = 'Out' THEN BA.AttendanceDate END) AS SiftOut, MIN(CASE WHEN BA.PunchMode = 'In' THEN BA.SiftTypeId END) AS SiftTypeId FROM emp.BioAttendance BA WHERE BA.EmployeeId IN (SELECT Id FROM emp.vw_EmployeesList WHERE LOWER(EmployeeName) LIKE LOWER('vivek tiwari%')) AND CAST(BA.AttendanceDate AS DATE) BETWEEN '2025-06-01' AND '2025-06-18' GROUP BY BA.EmployeeId, CAST(BA.AttendanceDate AS DATE)) AS A INNER JOIN emp.vw_EmployeesList E ON A.EmployeeId = E.Id LEFT JOIN mst.BioAttSift MBA ON MBA.Id = A.SiftTypeId ORDER BY A.EmployeeId, A.AttendanceDate;", 'intent': 'database_agent', 'summary': "Vivek Tiwari's attendance details are available from June 1 to June 14, 2025, with varying late minutes and duty hours, working in the Information Technology department."}
