d': 22, 'SiftName': 'SFT:A3', 'LateMins': '00:10', 'OTHours': '01:00', 'DutyHours': '07:50'}, {'EmployeeId': 816, 'EmployeeName': 'HIMANSHU TOMAR', 'FrontImage': '/Uploads/Employee/Profile/20210120125137.jpg', 'DepartmentName': 'PURCHASE', 'AttendanceDate': '2023-08-15', 'SiftIn': '2023-08-15T09:01:18.143000', 'SiftOut': '2023-08-15T10:36:21.460000', 'SiftTypeId': 22, 'SiftName': 'SFT:A3', 'LateMins': '01:01', 'OTHours': '00:00', 'DutyHours': '01:35'}], 'main_entity': 'Employee Attendance', 'main_format': 'aggregation', 'role': 'assistant', 'content': 'Here is the attendance record for Himanshu.', 'context_id': '19271-20251001-085154-016', 'question': 'attendance of himanshu', 'query': "SELECT A.EmployeeId, E.EmployeeName, E.FrontImage, E.DepartmentName, A.AttendanceDate, A.SiftIn, A.SiftOut, A.SiftTypeId, MBA.SiftName, RIGHT('0' + CAST(CASE WHEN A.SiftIn > (CAST(A.AttendanceDate AS DATETIME) + CAST(MBA.SiftIn AS DATETIME)) THEN DATEDIFF(MINUTE, CAST(A.AttendanceDate AS DATETIME) + CAST(MBA.SiftIn AS DATETIME), A.SiftIn) ELSE 0 END / 60 AS VARCHAR), 2) + ':' + RIGHT('0' + CAST(CASE WHEN A.SiftIn > (CAST(A.AttendanceDate AS DATETIME) + CAST(MBA.SiftIn AS DATETIME)) THEN DATEDIFF(MINUTE, CAST(A.AttendanceDate AS DATETIME) + CAST(MBA.SiftIn AS DATETIME), A.SiftIn) ELSE 0 END % 60 AS VARCHAR), 2) AS LateMins, RIGHT('0' + CAST(CASE WHEN A.SiftOut > (CAST(A.AttendanceDate AS DATETIME) + CAST(MBA.SiftOut AS DATETIME)) THEN DATEDIFF(MINUTE, CAST(A.AttendanceDate AS DATETIME) + CAST(MBA.SiftOut AS DATETIME), A.SiftOut) ELSE 0 END / 60 AS VARCHAR), 2) + ':' + RIGHT('0' + CAST(CASE WHEN A.SiftOut > (CAST(A.AttendanceDate AS DATETIME) + CAST(MBA.SiftOut AS DATETIME)) THEN DATEDIFF(MINUTE, CAST(A.AttendanceDate AS DATETIME) + CAST(MBA.SiftOut AS DATETIME), A.SiftOut) ELSE 0 END % 60 AS VARCHAR), 2) AS OTHours, RIGHT('0' + CAST(DATEDIFF(MINUTE, CASE WHEN A.SiftIn > (CAST(A.AttendanceDate AS DATETIME) + CAST(MBA.SiftIn AS DATETIME)) THEN A.SiftIn ELSE (CAST(A.AttendanceDate AS DAT