ee/Profile/20210120125137.jpg', 'DepartmentName': 'PURCHASE', 'AttendanceDate': '2023-08-08', 'SiftIn': '2023-08-08T08:02:56.633000', 'SiftOut': '2023-08-08T16:23:55.740000', 'SiftTypeId': 22, 'SiftName': 'SFT:A3', 'LateMins': '00:02', 'OTHours': '00:23', 'DutyHours': '07:58'}, {'EmployeeId': 816, 'EmployeeName': 'HIMANSHU TOMAR', 'FrontImage': '/Uploads/Employee/Profile/20210120125137.jpg', 'DepartmentName': 'PURCHASE', 'AttendanceDate': '2023-08-09', 'SiftIn': '2023-08-09T08:07:23.227000', 'SiftOut': '2023-08-09T16:52:54.747000', 'SiftTypeId': 22, 'SiftName': 'SFT:A3', 'LateMins': '00:07', 'OTHours': '00:52', 'DutyHours': '07:53'}, {'EmployeeId': 816, 'EmployeeName': 'HIMANSHU TOMAR', 'FrontImage': '/Uploads/Employee/Profile/20210120125137.jpg', 'DepartmentName': 'PURCHASE', 'AttendanceDate': '2023-08-10', 'SiftIn': '2023-08-10T08:04:00.053000', 'SiftOut': '2023-08-10T17:02:03.233000', 'SiftTypeId': 22, 'SiftName': 'SFT:A3', 'LateMins': '00:04', 'OTHours': '01:02', 'DutyHours': '07:56'}, {'EmployeeId': 816, 'EmployeeName': 'HIMANSHU TOMAR', 'FrontImage': '/Uploads/Employee/Profile/20210120125137.jpg', 'DepartmentName': 'PURCHASE', 'AttendanceDate': '2023-08-11', 'SiftIn': '2023-08-11T08:06:38.797000', 'SiftOut': '2023-08-11T17:12:45.017000', 'SiftTypeId': 22, 'SiftName': 'SFT:A3', 'LateMins': '00:06', 'OTHours': '01:12', 'DutyHours': '07:54'}, {'EmployeeId': 816, 'EmployeeName': 'HIMANSHU TOMAR', 'FrontImage': '/Uploads/Employee/Profile/20210120125137.jpg', 'DepartmentName': 'PURCHASE', 'AttendanceDate': '2023-08-12', 'SiftIn': '2023-08-12T08:12:03.580000', 'SiftOut': '2023-08-12T16:52:35.730000', 'SiftTypeId': 22, 'SiftName': 'SFT:A3', 'LateMins': '00:12', 'OTHours': '00:52', 'DutyHours': '07:48'}, {'EmployeeId': 816, 'EmployeeName': 'HIMANSHU TOMAR', 'FrontImage': '/Uploads/Employee/Profile/20210120125137.jpg', 'DepartmentName': 'PURCHASE', 'AttendanceDate': '2023-08-14', 'SiftIn': '2023-08-14T08:10:41.913000', 'SiftOut': '2023-08-14T17:00:27.107000', 'SiftTypeId': 22, 'SiftName': 'SFT:A3', 'LateMins': '00:10', 'OTHours': '01:00', 'DutyHours': '07:50'}, {'EmployeeId': 816, 'EmployeeName': 'HIMANSHU TOMAR', 'FrontImage': '/Uploads/Employee/Profile/20210120125137.jpg', 'DepartmentName': 'PURCHASE', 'AttendanceDate': '2023-08-15', 'SiftIn': '2023-08-15T09:01:18.143000', 'SiftOut': '2023-08-15T10:36:21.460000', 'SiftTypeId': 22, 'SiftName': 'SFT:A3', 'LateMins': '01:01', 'OTHours': '00:00', 'DutyHours': '01:35'}], 'main_entity': 'Employee Attendance', 'main_format': 'aggregation', 'role': 'assistant', 'content': 'Here is the attendance record for Himanshu.', 'context_id': '1', 'question': 'attendance of himanshu', 'query': "SELECT A.EmployeeId, E.EmployeeName, E.FrontImage, E.DepartmentName, A.AttendanceDate, A.SiftIn, A.SiftOut, A.SiftTypeId, MBA.SiftName, RIGHT('0' + CAST(CASE WHEN A.SiftIn > (CAST(A.AttendanceDate AS DATETIME) + CAST(MBA.SiftIn AS DATETIME)) THEN DATEDIFF(MINUTE, CAST(A.AttendanceDate AS DATETIME) + CAST(MBA.SiftIn AS DATETIME), A.SiftIn) ELSE 0 END / 60 AS VARCHAR), 2) + ':' + RIGHT('0' + CAST(CASE WHEN A.SiftIn > (CAST(A.AttendanceDate AS DATETIME) + CAST(MBA.SiftIn AS DATETIME)) THEN DATEDIFF(MINUTE, CAST(A.AttendanceDate AS DATETIME) + CAST(MBA.SiftIn AS DATETIME), A.SiftIn) ELSE 0 END % 60 AS VARCHAR), 2) AS LateMins, RIGHT('0' + CAST(CASE WHEN A.SiftOut > (CAST(A.AttendanceDate AS DATETIME) + CAST(MBA.SiftOut AS DATETIME)) THEN DATEDIFF(MINUTE, CAST(A.AttendanceDate AS DATETIME) + CAST(MBA.SiftOut AS DATETIME), A.SiftOut) ELSE 0 END / 60 AS VARCHAR), 2) + ':' + RIGHT('0' + CAST(CASE WHEN A.SiftOut > (CAST(A.AttendanceDate AS DATETIME) + CAST(MBA.SiftOut AS DATETIME)) THEN DATEDIFF(MINUTE, CAST(A.AttendanceDate AS DATETIME) + CAST(MBA.SiftOut AS DATETIME), A.SiftOut) ELSE 0 END % 60 AS VARCHAR), 2) AS OTHours, RIGHT('0' + CAST(DATEDIFF(MINUTE, CASE WHEN A.SiftIn > (CAST(A.AttendanceDate AS DATETIME) + CAST(MBA.SiftIn AS DATETIME)) THEN A.SiftIn ELSE (CAST(A.AttendanceDate AS DATETIME) + CAST(MBA.SiftIn AS DATETIME)) END, CASE WHEN A.SiftOut < (CAST(A.AttendanceDate AS DATETIME) + CAST(MBA.SiftOut AS DATETIME)) THEN A.SiftOut ELSE (CAST(A.AttendanceDate AS DATETIME) + CAST(MBA.SiftOut AS DATETIME)) END) / 60 AS VARCHAR), 2) + ':' + RIGHT('0' + CAST(DATEDIFF(MINUTE, CASE WHEN A.SiftIn > (CAST(A.AttendanceDate AS DATETIME) + CAST(MBA.SiftIn AS DATETIME)) THEN A.SiftIn ELSE (CAST(A.AttendanceDate AS DATETIME) + CAST(MBA.SiftIn AS DATETIME)) END, CASE WHEN A.SiftOut < (CAST(A.AttendanceDate AS DATETIME) + CAST(MBA.SiftOut AS DATETIME)) THEN A.SiftOut ELSE (CAST(A.AttendanceDate AS DATETIME) + CAST(MBA.SiftOut AS DATETIME)) END) % 60 AS VARCHAR), 2) AS DutyHours FROM (SELECT BA.EmployeeId, CAST(BA.AttendanceDate AS DATE) AS AttendanceDate, MIN(CASE WHEN BA.PunchMode = 'In' THEN BA.AttendanceDate END) AS SiftIn, MAX(CASE WHEN BA.PunchMode = 'Out' THEN BA.AttendanceDate END) AS SiftOut, MIN(CASE WHEN BA.PunchMode = 'In' THEN BA.SiftTypeId END) AS SiftTypeId FROM emp.BioAttendance BA WHERE BA.EmployeeId IN (SELECT Id FROM emp.vw_EmployeesList WHERE LOWER(EmployeeName) LIKE 'himanshu%') GROUP BY BA.EmployeeId, CAST(BA.AttendanceDate AS DATE)) AS A INNER JOIN emp.vw_EmployeesList E ON A.EmployeeId = E.Id LEFT JOIN mst.BioAttSift MBA ON MBA.Id = A.SiftTypeId ORDER BY A.EmployeeId, A.AttendanceDate;", 'intent': 'database_agent', 'summary': "Himanshu's attendance record shows he worked 9 days with varying hours, with late arrivals on several days, and a short 1.5 hour shift on August 15."}
