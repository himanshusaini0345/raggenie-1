mployee/Profile/20220907095434.jpg', 'DepartmentName': 'NURSING COLLEGE', 'AttendanceDate': '2025-06-06', 'SiftIn': '2025-06-06T07:53:15.980000', 'SiftOut': '2025-06-06T16:01:49.440000', 'SiftTypeId': 40, 'SiftName': 'SFT:A8', 'LateMins': '00:00', 'OTHours': '00:01', 'DutyHours': '08:00'}, {'EmployeeId': 8852, 'EmployeeName': 'Himanshu', 'FrontImage': '/Uploads/Employee/Profile/20220907095434.jpg', 'DepartmentName': 'NURSING COLLEGE', 'AttendanceDate': '2025-06-09', 'SiftIn': '2025-06-09T08:00:00.150000', 'SiftOut': '2025-06-09T16:11:00.917000', 'SiftTypeId': 40, 'SiftName': 'SFT:A8', 'LateMins': '00:00', 'OTHours': '00:11', 'DutyHours': '08:00'}, {'EmployeeId': 8852, 'EmployeeName': 'Himanshu', 'FrontImage': '/Uploads/Employee/Profile/20220907095434.jpg', 'DepartmentName': 'NURSING COLLEGE', 'AttendanceDate': '2025-06-10', 'SiftIn': '2025-06-10T07:47:14.930000', 'SiftOut': '2025-06-10T16:08:38.910000', 'SiftTypeId': 40, 'SiftName': 'SFT:A8', 'LateMins': '00:00', 'OTHours': '00:08', 'DutyHours': '08:00'}, {'EmployeeId': 8852, 'EmployeeName': 'Himanshu', 'FrontImage': '/Uploads/Employee/Profile/20220907095434.jpg', 'DepartmentName': 'NURSING COLLEGE', 'AttendanceDate': '2025-06-11', 'SiftIn': '2025-06-11T07:46:45.790000', 'SiftOut': '2025-06-11T16:08:54.407000', 'SiftTypeId': 40, 'SiftName': 'SFT:A8', 'LateMins': '00:00', 'OTHours': '00:08', 'DutyHours': '08:00'}, {'EmployeeId': 8852, 'EmployeeName': 'Himanshu', 'FrontImage': '/Uploads/Employee/Profile/20220907095434.jpg', 'DepartmentName': 'NURSING COLLEGE', 'AttendanceDate': '2025-06-12', 'SiftIn': '2025-06-12T07:48:31.997000', 'SiftOut': '2025-06-12T16:12:57.240000', 'SiftTypeId': 40, 'SiftName': 'SFT:A8', 'LateMins': '00:00', 'OTHours': '00:12', 'DutyHours': '08:00'}, {'EmployeeId': 8852, 'EmployeeName': 'Himanshu', 'FrontImage': '/Uploads/Employee/Profile/20220907095434.jpg', 'DepartmentName': 'NURSING COLLEGE', 'AttendanceDate': '2025-06-13', 'SiftIn': '2025-06-13T07:53:59.003000', 'SiftOut': '2025-06-13T16:07:01.077000', 'SiftTypeId': 40, 'SiftName': 'SFT:A8', 'LateMins': '00:00', 'OTHours': '00:07', 'DutyHours': '08:00'}, {'EmployeeId': 8852, 'EmployeeName': 'Himanshu', 'FrontImage': '/Uploads/Employee/Profile/20220907095434.jpg', 'DepartmentName': 'NURSING COLLEGE', 'AttendanceDate': '2025-06-14', 'SiftIn': '2025-06-14T07:52:49.440000', 'SiftOut': '2025-06-14T16:08:28.820000', 'SiftTypeId': 40, 'SiftName': 'SFT:A8', 'LateMins': '00:00', 'OTHours': '00:08', 'DutyHours': '08:00'}], 'main_entity': 'Employee Attendance', 'main_format': 'aggregation', 'role': 'assistant', 'content': 'Here is the attendance record for Himanshu.', 'context_id': '1', 'question': 'attendance of himanshu', 'query': "SELECT A.EmployeeId, E.EmployeeName, E.FrontImage, E.DepartmentName, A.AttendanceDate, A.SiftIn, A.SiftOut, A.SiftTypeId, MBA.SiftName, RIGHT('0' + CAST(CASE WHEN A.SiftIn > (CAST(A.AttendanceDate AS DATETIME) + CAST(MBA.SiftIn AS DATETIME)) THEN DATEDIFF(MINUTE, CAST(A.AttendanceDate AS DATETIME) + CAST(MBA.SiftIn AS DATETIME), A.SiftIn) ELSE 0 END / 60 AS VARCHAR), 2) + ':' + RIGHT('0' + CAST(CASE WHEN A.SiftIn > (CAST(A.AttendanceDate AS DATETIME) + CAST(MBA.SiftIn AS DATETIME)) THEN DATEDIFF(MINUTE, CAST(A.AttendanceDate AS DATETIME) + CAST(MBA.SiftIn AS DATETIME), A.SiftIn) ELSE 0 END % 60 AS VARCHAR), 2) AS LateMins, RIGHT('0' + CAST(CASE WHEN A.SiftOut > (CAST(A.AttendanceDate AS DATETIME) + CAST(MBA.SiftOut AS DATETIME)) THEN DATEDIFF(MINUTE, CAST(A.AttendanceDate AS DATETIME) + CAST(MBA.SiftOut AS DATETIME), A.SiftOut) ELSE 0 END / 60 AS VARCHAR), 2) + ':' + RIGHT('0' + CAST(CASE WHEN A.SiftOut > (CAST(A.AttendanceDate AS DATETIME) + CAST(MBA.SiftOut AS DATETIME)) THEN DATEDIFF(MINUTE, CAST(A.AttendanceDate AS DATETIME) + CAST(MBA.SiftOut AS DATETIME), A.SiftOut) ELSE 0 END % 60 AS VARCHAR), 2) AS OTHours, RIGHT('0' + CAST(DATEDIFF(MINUTE, CASE WHEN A.SiftIn > (CAST(A.AttendanceDate AS DATETIME) + CAST(MBA.SiftIn AS DATETIME)) THEN A.SiftIn ELSE (CAST(A.AttendanceDate AS DATETIME) + CAST(MBA.SiftIn AS DATETIME)) END, CASE WHEN A.SiftOut < (CAST(A.AttendanceDate AS DATETIME) + CAST(MBA.SiftOut AS DATETIME)) THEN A.SiftOut ELSE (CAST(A.AttendanceDate AS DATETIME) + CAST(MBA.SiftOut AS DATETIME)) END) / 60 AS VARCHAR), 2) + ':' + RIGHT('0' + CAST(DATEDIFF(MINUTE, CASE WHEN A.SiftIn > (CAST(A.AttendanceDate AS DATETIME) + CAST(MBA.SiftIn AS DATETIME)) THEN A.SiftIn ELSE (CAST(A.AttendanceDate AS DATETIME) + CAST(MBA.SiftIn AS DATETIME)) END, CASE WHEN A.SiftOut < (CAST(A.AttendanceDate AS DATETIME) + CAST(MBA.SiftOut AS DATETIME)) THEN A.SiftOut ELSE (CAST(A.AttendanceDate AS DATETIME) + CAST(MBA.SiftOut AS DATETIME)) END) % 60 AS VARCHAR), 2) AS DutyHours FROM (SELECT BA.EmployeeId, CAST(BA.AttendanceDate AS DATE) AS AttendanceDate, MIN(CASE WHEN BA.PunchMode = 'In' THEN BA.AttendanceDate END) AS SiftIn, MAX(CASE WHEN BA.PunchMode = 'Out' THEN BA.AttendanceDate END) AS SiftOut, MIN(CASE WHEN BA.PunchMode = 'In' THEN BA.SiftTypeId END) AS SiftTypeId FROM emp.BioAttendance BA WHERE BA.EmployeeId IN (SELECT Id FROM emp.vw_EmployeesList WHERE LOWER(EmployeeName) LIKE 'himanshu%') AND CAST(BA.AttendanceDate AS DATE) BETWEEN '2025-06-01' AND '2025-06-18' GROUP BY BA.EmployeeId, CAST(BA.AttendanceDate AS DATE)) AS A INNER JOIN emp.vw_EmployeesList E ON A.EmployeeId = E.Id LEFT JOIN mst.BioAttSift MBA ON MBA.Id = A.SiftTypeId ORDER BY A.EmployeeId, A.AttendanceDate;", 'intent': 'database_agent', 'summary': "Himanshu's attendance record shows he worked 10 days from June 1 to 14, 2025, with varying overtime hours, and no late minutes recorded."}
