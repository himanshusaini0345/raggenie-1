OGY', 'AttendanceDate': '2023-08-05', 'SiftIn': '2023-08-05T08:39:53.020000', 'SiftOut': None, 'SiftTypeId': 22, 'SiftName': 'SFT:A3', 'LateMins': '00:39', 'OTHours': '00:00', 'DutyHours': '07:21'}, {'EmployeeId': 3135, 'EmployeeName': 'Vivek Tiwari', 'FrontImage': '/Uploads/Employee/Profile/20210121115600.jpg', 'DepartmentName': 'INFORMATION TECHNOLOGY', 'AttendanceDate': '2023-08-06', 'SiftIn': '2023-08-06T09:53:21', 'SiftOut': None, 'SiftTypeId': 22, 'SiftName': 'SFT:A3', 'LateMins': '01:53', 'OTHours': '00:00', 'DutyHours': '06:07'}, {'EmployeeId': 3135, 'EmployeeName': 'Vivek Tiwari', 'FrontImage': '/Uploads/Employee/Profile/20210121115600.jpg', 'DepartmentName': 'INFORMATION TECHNOLOGY', 'AttendanceDate': '2023-08-07', 'SiftIn': '2023-08-07T08:35:10.340000', 'SiftOut': None, 'SiftTypeId': 22, 'SiftName': 'SFT:A3', 'LateMins': '00:35', 'OTHours': '00:00', 'DutyHours': '07:25'}, {'EmployeeId': 3135, 'EmployeeName': 'Vivek Tiwari', 'FrontImage': '/Uploads/Employee/Profile/20210121115600.jpg', 'DepartmentName': 'INFORMATION TECHNOLOGY', 'AttendanceDate': '2023-08-08', 'SiftIn': '2023-08-08T08:32:49.890000', 'SiftOut': None, 'SiftTypeId': 22, 'SiftName': 'SFT:A3', 'LateMins': '00:32', 'OTHours': '00:00', 'DutyHours': '07:28'}, {'EmployeeId': 3135, 'EmployeeName': 'Vivek Tiwari', 'FrontImage': '/Uploads/Employee/Profile/20210121115600.jpg', 'DepartmentName': 'INFORMATION TECHNOLOGY', 'AttendanceDate': '2023-08-09', 'SiftIn': '2023-08-09T08:32:52.827000', 'SiftOut': None, 'SiftTypeId': 22, 'SiftName': 'SFT:A3', 'LateMins': '00:32', 'OTHours': '00:00', 'DutyHours': '07:28'}, {'EmployeeId': 3135, 'EmployeeName': 'Vivek Tiwari', 'FrontImage': '/Uploads/Employee/Profile/20210121115600.jpg', 'DepartmentName': 'INFORMATION TECHNOLOGY', 'AttendanceDate': '2023-08-10', 'SiftIn': '2023-08-10T08:52:20.760000', 'SiftOut': None, 'SiftTypeId': 22, 'SiftName': 'SFT:A3', 'LateMins': '00:52', 'OTHours': '00:00', 'DutyHours': '07:08'}, {'EmployeeId': 3135, 'EmployeeName': 'Vivek Tiwari', 'FrontImage': '/Uploads/Employee/Profile/20210121115600.jpg', 'DepartmentName': 'INFORMATION TECHNOLOGY', 'AttendanceDate': '2023-08-11', 'SiftIn': '2023-08-11T08:52:57.623000', 'SiftOut': None, 'SiftTypeId': 22, 'SiftName': 'SFT:A3', 'LateMins': '00:52', 'OTHours': '00:00', 'DutyHours': '07:08'}], 'main_entity': 'Employee Attendance', 'main_format': 'aggregation', 'role': 'assistant', 'content': 'Here is the attendance information for Vivek Tiwari.', 'context_id': '122', 'question': 'attedence of vivek tiwari?', 'query': "SELECT A.EmployeeId, E.EmployeeName, E.FrontImage, E.DepartmentName, A.AttendanceDate, A.SiftIn, A.SiftOut, A.SiftTypeId, MBA.SiftName, RIGHT('0' + CAST(CASE WHEN A.SiftIn > (CAST(A.AttendanceDate AS DATETIME) + CAST(MBA.SiftIn AS DATETIME)) THEN DATEDIFF(MINUTE, CAST(A.AttendanceDate AS DATETIME) + CAST(MBA.SiftIn AS DATETIME), A.SiftIn) ELSE 0 END / 60 AS VARCHAR), 2) + ':' + RIGHT('0' + CAST(CASE WHEN A.SiftIn > (CAST(A.AttendanceDate AS DATETIME) + CAST(MBA.SiftIn AS DATETIME)) THEN DATEDIFF(MINUTE, CAST(A.AttendanceDate AS DATETIME) + CAST(MBA.SiftIn AS DATETIME), A.SiftIn) ELSE 0 END % 60 AS VARCHAR), 2) AS LateMins, RIGHT('0' + CAST(CASE WHEN A.SiftOut > (CAST(A.AttendanceDate AS DATETIME) + CAST(MBA.SiftOut AS DATETIME)) THEN DATEDIFF(MINUTE, CAST(A.AttendanceDate AS DATETIME) + CAST(MBA.SiftOut AS DATETIME), A.SiftOut) ELSE 0 END / 60 AS VARCHAR), 2) + ':' + RIGHT('0' + CAST(CASE WHEN A.SiftOut > (CAST(A.AttendanceDate AS DATETIME) + CAST(MBA.SiftOut AS DATETIME)) THEN DATEDIFF(MINUTE, CAST(A.AttendanceDate AS DATETIME) + CAST(MBA.SiftOut AS DATETIME), A.SiftOut) ELSE 0 END % 60 AS VARCHAR), 2) AS OTHours, RIGHT('0' + CAST(DATEDIFF(MINUTE, CASE WHEN A.SiftIn > (CAST(A.AttendanceDate AS DATETIME) + CAST(MBA.SiftIn AS DATETIME)) THEN A.SiftIn ELSE (CAST(A.AttendanceDate AS DATETIME) + CAST(MBA.SiftIn AS DATETIME)) END, CASE WHEN A.SiftOut < (CAST(A.AttendanceDate AS DATETIME) + CAST(MBA.SiftOut AS DATETIME)) THEN A.SiftOut ELSE (CAST(A.AttendanceDate AS DATETIME) + CAST(MBA.SiftOut AS DATETIME)) END) / 60 AS VARCHAR), 2) + ':' + RIGHT('0' + CAST(DATEDIFF(MINUTE, CASE WHEN A.SiftIn > (CAST(A.AttendanceDate AS DATETIME) + CAST(MBA.SiftIn AS DATETIME)) THEN A.SiftIn ELSE (CAST(A.AttendanceDate AS DATETIME) + CAST(MBA.SiftIn AS DATETIME)) END, CASE WHEN A.SiftOut < (CAST(A.AttendanceDate AS DATETIME) + CAST(MBA.SiftOut AS DATETIME)) THEN A.SiftOut ELSE (CAST(A.AttendanceDate AS DATETIME) + CAST(MBA.SiftOut AS DATETIME)) END) % 60 AS VARCHAR), 2) AS DutyHours FROM (SELECT BA.EmployeeId, CAST(BA.AttendanceDate AS DATE) AS AttendanceDate, MIN(CASE WHEN BA.PunchMode = 'In' THEN BA.AttendanceDate END) AS SiftIn, MAX(CASE WHEN BA.PunchMode = 'Out' THEN BA.AttendanceDate END) AS SiftOut, MIN(CASE WHEN BA.PunchMode = 'In' THEN BA.SiftTypeId END) AS SiftTypeId FROM emp.BioAttendance BA WHERE BA.EmployeeId IN (SELECT Id FROM emp.vw_EmployeesList WHERE LOWER(EmployeeName) LIKE LOWER('vivek tiwari%')) GROUP BY BA.EmployeeId, CAST(BA.AttendanceDate AS DATE)) AS A INNER JOIN emp.vw_EmployeesList E ON A.EmployeeId = E.Id LEFT JOIN mst.BioAttSift MBA ON MBA.Id = A.SiftTypeId ORDER BY A.EmployeeId, A.AttendanceDate;", 'intent': 'database_agent', 'summary': "Vivek Tiwari's attendance records show he worked in the Information Technology department with varying shift-in times, often late by 30-60 minutes, and worked around 7 hours daily."}
