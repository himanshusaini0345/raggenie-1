onth   from acom.ServicesCharges s\ninner join mst.PayCycle p  on p.Id = s.PaycycleId \ninner join emp.vw_EmployeesList  e on e.Id = s.EmployeeId \nwhere  s.PaycycleId >=41 and e.EmployeeName like 'Roop singh%' and e.UniversityId =1\norder by s.EmployeeId ,s.PaycycleId", 'metadata': '', 'datasource': 'database_agent', 'config_id': 1}, 'score': 0.7564480304718018, 'distances': 0.24355196952819824}, {'_id': ObjectId('68dc97559119177621c0cc5e'), 'document': 'Please provide the attendance details of Mr. Yash.', 'metadatas': {'query': "SELECT A.EmployeeId, E.EmployeeName, E.FrontImage, E.DepartmentName, A.AttendanceDate, A.SiftIn, A.SiftOut, A.SiftTypeId, MBA.SiftName, RIGHT('0' + CAST(CASE WHEN A.SiftIn > (CAST(A.AttendanceDate AS DATETIME) + CAST(MBA.SiftIn AS DATETIME)) THEN DATEDIFF(MINUTE, CAST(A.AttendanceDate AS DATETIME) + CAST(MBA.SiftIn AS DATETIME), A.SiftIn) ELSE 0 END / 60 AS VARCHAR), 2) + ':' + RIGHT('0' + CAST(CASE WHEN A.SiftIn > (CAST(A.AttendanceDate AS DATETIME) + CAST(MBA.SiftIn AS DATETIME)) THEN DATEDIFF(MINUTE, CAST(A.AttendanceDate AS DATETIME) + CAST(MBA.SiftIn AS DATETIME), A.SiftIn) ELSE 0 END % 60 AS VARCHAR), 2) AS LateMins, RIGHT('0' + CAST(CASE WHEN A.SiftOut > (CAST(A.AttendanceDate AS DATETIME) + CAST(MBA.SiftOut AS DATETIME)) THEN DATEDIFF(MINUTE, CAST(A.AttendanceDate AS DATETIME) + CAST(MBA.SiftOut AS DATETIME), A.SiftOut) ELSE 0 END / 60 AS VARCHAR), 2) + ':' + RIGHT('0' + CAST(CASE WHEN A.SiftOut > (CAST(A.AttendanceDate AS DATETIME) + CAST(MBA.SiftOut AS DATETIME)) THEN DATEDIFF(MINUTE, CAST(A.AttendanceDate AS DATETIME) + CAST(MBA.SiftOut AS DATETIME), A.SiftOut) ELSE 0 END % 60 AS VARCHAR), 2) AS OTHours, RIGHT('0' + CAST(DATEDIFF(MINUTE, CASE WHEN A.SiftIn > (CAST(A.AttendanceDate AS DATETIME) + CAST(MBA.SiftIn AS DATETIME)) THEN A.SiftIn ELSE (CAST(A.AttendanceDate AS DATETIME) + CAST(MBA.SiftIn AS DATETIME)) END, CASE WHEN A.SiftOut < (CAST(A.AttendanceDate AS DATETIME) + CAST(MBA.SiftOut AS DATETIME)) THEN A.SiftOut ELSE (CAST(A.AttendanceDate AS DATETIME) + CAST(MBA.SiftOut AS DATETIME)) END) / 60 AS VARCHAR), 2) + ':' + RIGHT('0' + CAST(DATEDIFF(MINUTE, CASE WHEN A.SiftIn > (CAST(A.AttendanceDate AS DATETIME) + CAST(MBA.SiftIn AS DATETIME)) THEN A.SiftIn ELSE (CAST(A.AttendanceDate AS DATETIME) + CAST(MBA.SiftIn AS DATETIME)) END, CASE WHEN A.SiftOut < (CAST(A.AttendanceDate AS DATETIME) + CAST(MBA.SiftOut AS DATETIME)) THEN A.SiftOut ELSE (CAST(A.AttendanceDate AS DATETIME) + CAST(MBA.SiftOut AS DATETIME)) END) % 60 AS VARCHAR), 2) AS DutyHours FROM (SELECT BA.EmployeeId, CAST(BA.AttendanceDate AS DATE) AS AttendanceDate, MIN(CASE WHEN BA.PunchMode = 'In' THEN BA.AttendanceDate END) AS SiftIn, MAX(CASE WHEN BA.PunchMode = 'Out' THEN BA.AttendanceDate END) AS SiftOut, MIN(CASE WHEN BA.PunchMode = 'In' THEN BA.SiftTypeId END) AS SiftTypeId FROM emp.BioAttendance BA WHERE BA.EmployeeId IN (SELECT Id FROM emp.vw_EmployeesList WHERE EmployeeName LIKE 'yash%') AND CAST(BA.AttendanceDate AS DATE) BETWEEN '2025-06-01' AND '2025-06-18' GROUP BY BA.EmployeeId, CAST(BA.AttendanceDate AS DATE)) AS A INNER JOIN emp.vw_EmployeesList E ON A.EmployeeId = E.Id LEFT JOIN mst.BioAttSift MBA ON MBA.Id = A.SiftTypeId ORDER BY A.EmployeeId, A.AttendanceDate;\n", 'metadata': '', 'datasource': 'database_agent', 'config_id': 1}, 'score': 0.7305552959442139, 'distances': 0.26944470405578613}]
