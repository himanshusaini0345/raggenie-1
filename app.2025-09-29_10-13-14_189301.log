ile/20241225121935.jpg', 'DepartmentName': 'NS OFFICE', 'AttendanceDate': '2025-01-01', 'SiftIn': '2025-01-01T08:17:54.150000', 'SiftOut': '2025-01-01T12:21:32.893000', 'SiftTypeId': 41, 'SiftName': 'SFT:A9', 'LateMins': '00:17', 'OTHours': '00:00', 'DutyHours': '04:04'}, {'EmployeeId': 15480, 'EmployeeName': 'HIMANSHU SAINI', 'FrontImage': '/Uploads/Employee/Profile/20241225121935.jpg', 'DepartmentName': 'NS OFFICE', 'AttendanceDate': '2025-01-03', 'SiftIn': '2025-01-03T08:35:43.993000', 'SiftOut': '2025-01-03T16:13:11.227000', 'SiftTypeId': 41, 'SiftName': 'SFT:A9', 'LateMins': '00:35', 'OTHours': '00:13', 'DutyHours': '07:25'}, {'EmployeeId': 15480, 'EmployeeName': 'HIMANSHU SAINI', 'FrontImage': '/Uploads/Employee/Profile/20241225121935.jpg', 'DepartmentName': 'NS OFFICE', 'AttendanceDate': '2025-01-04', 'SiftIn': '2025-01-04T08:15:00.013000', 'SiftOut': '2025-01-04T16:08:19.733000', 'SiftTypeId': 41, 'SiftName': 'SFT:A9', 'LateMins': '00:15', 'OTHours': '00:08', 'DutyHours': '07:45'}, {'EmployeeId': 15480, 'EmployeeName': 'HIMANSHU SAINI', 'FrontImage': '/Uploads/Employee/Profile/20241225121935.jpg', 'DepartmentName': 'NS OFFICE', 'AttendanceDate': '2025-01-05', 'SiftIn': '2025-01-05T08:21:04.717000', 'SiftOut': '2025-01-05T16:07:08.777000', 'SiftTypeId': 41, 'SiftName': 'SFT:A9', 'LateMins': '00:21', 'OTHours': '00:07', 'DutyHours': '07:39'}, {'EmployeeId': 15480, 'EmployeeName': 'HIMANSHU SAINI', 'FrontImage': '/Uploads/Employee/Profile/20241225121935.jpg', 'DepartmentName': 'NS OFFICE', 'AttendanceDate': '2025-01-06', 'SiftIn': '2025-01-06T08:19:20.580000', 'SiftOut': '2025-01-06T16:09:21.490000', 'SiftTypeId': 41, 'SiftName': 'SFT:A9', 'LateMins': '00:19', 'OTHours': '00:09', 'DutyHours': '07:41'}, {'EmployeeId': 15480, 'EmployeeName': 'HIMANSHU SAINI', 'FrontImage': '/Uploads/Employee/Profile/20241225121935.jpg', 'DepartmentName': 'NS OFFICE', 'AttendanceDate': '2025-01-07', 'SiftIn': '2025-01-07T08:09:00.490000', 'SiftOut': '2025-01-07T16:06:51.470000', 'SiftTypeId': 41, 'SiftName': 'SFT:A9', 'LateMins': '00:09', 'OTHours': '00:06', 'DutyHours': '07:51'}, {'EmployeeId': 15480, 'EmployeeName': 'HIMANSHU SAINI', 'FrontImage': '/Uploads/Employee/Profile/20241225121935.jpg', 'DepartmentName': 'NS OFFICE', 'AttendanceDate': '2025-01-08', 'SiftIn': '2025-01-08T08:18:53.260000', 'SiftOut': '2025-01-08T16:18:46.487000', 'SiftTypeId': 41, 'SiftName': 'SFT:A9', 'LateMins': '00:18', 'OTHours': '00:18', 'DutyHours': '07:42'}], 'main_entity': 'attendance', 'main_format': 'aggregation', 'role': 'assistant', 'content': 'Here are the attendance details of Himanshu Saini.', 'context_id': '19271-20250930-174643-097', 'question': 'attendance of himanshu saini', 'query': "SELECT A.EmployeeId, E.EmployeeName, E.FrontImage, E.DepartmentName, A.AttendanceDate, A.SiftIn, A.SiftOut, A.SiftTypeId, MBA.SiftName, RIGHT('0' + CAST(CASE WHEN A.SiftIn > (CAST(A.AttendanceDate AS DATETIME) + CAST(MBA.SiftIn AS DATETIME)) THEN DATEDIFF(MINUTE, CAST(A.AttendanceDate AS DATETIME) + CAST(MBA.SiftIn AS DATETIME), A.SiftIn) ELSE 0 END / 60 AS VARCHAR), 2) + ':' + RIGHT('0' + CAST(CASE WHEN A.SiftIn > (CAST(A.AttendanceDate AS DATETIME) + CAST(MBA.SiftIn AS DATETIME)) THEN DATEDIFF(MINUTE, CAST(A.AttendanceDate AS DATETIME) + CAST(MBA.SiftIn AS DATETIME), A.SiftIn) ELSE 0 END % 60 AS VARCHAR), 2) AS LateMins, RIGHT('0' + CAST(CASE WHEN A.SiftOut > (CAST(A.AttendanceDate AS DATETIME) + CAST(MBA.SiftOut AS DATETIME)) THEN DATEDIFF(MINUTE, CAST(A.AttendanceDate AS DATETIME) + CAST(MBA.SiftOut AS DATETIME), A.SiftOut) ELSE 0 END / 60 AS VARCHAR), 2) + ':' + RIGHT('0' + CAST(CASE WHEN A.SiftOut > (CAST(A.AttendanceDate AS DATETIME) + CAST(MBA.SiftOut AS DATETIME)) THEN DATEDIFF(MINUTE, CAST(A.AttendanceDate AS DATETIME) + CAST(MBA.SiftOut AS DATETIME), A.SiftOut) ELSE 0 END % 60 AS VARCHAR), 2) AS OTHours, RIGHT('0' + CAST(DATEDIFF(MINUTE, CASE WHEN A.SiftIn > (CAST(A.AttendanceDate AS DATETIME) + CAST(MBA.SiftIn AS DATETIME)) THEN A.SiftIn ELSE (CAST(A.AttendanceDate AS DATETIME) + CAST(MBA.SiftIn AS DATETIME)) END, CASE WHEN A.SiftOut < (CAST(A.AttendanceDate AS DATETIME) + CAST(MBA.SiftOut AS DATETIME)) THEN A.SiftOut ELSE (CAST(A.AttendanceDate AS DATETIME) + CAST(MBA.SiftOut AS DATETIME)) END) / 60 AS VARCHAR), 2) + ':' + RIGHT('0' + CAST(DATEDIFF(MINUTE, CASE WHEN A.SiftIn > (CAST(A.AttendanceDate AS DATETIME) + CAST(MBA.SiftIn AS DATETIME)) THEN A.SiftIn ELSE (CAST(A.AttendanceDate AS DATETIME) + CAST(MBA.SiftIn AS DATETIME)) END, CASE WHEN A.SiftOut < (CAST(A.AttendanceDate AS DATETIME) + CAST(MBA.SiftOut AS DATETIME)) THEN A.SiftOut ELSE (CAST(A.AttendanceDate AS DATETIME) + CAST(MBA.SiftOut AS DATETIME)) END) % 60 AS VARCHAR), 2) AS DutyHours FROM (SELECT BA.EmployeeId, CAST(BA.AttendanceDate AS DATE) AS AttendanceDate, MIN(CASE WHEN BA.PunchMode = 'In' THEN BA.AttendanceDate END) AS SiftIn, MAX(CASE WHEN BA.PunchMode = 'Out' THEN BA.AttendanceDate END) AS SiftOut, MIN(CASE WHEN BA.PunchMode = 'In' THEN BA.SiftTypeId END) AS SiftTypeId FROM emp.BioAttendance BA WHERE BA.EmployeeId IN (SELECT Id FROM emp.vw_EmployeesList WHERE LOWER(EmployeeName) LIKE 'himanshu saini%') GROUP BY BA.EmployeeId, CAST(BA.AttendanceDate AS DATE)) AS A INNER JOIN emp.vw_EmployeesList E ON A.EmployeeId = E.Id LEFT JOIN mst.BioAttSift MBA ON MBA.Id = A.SiftTypeId ORDER BY A.EmployeeId, A.AttendanceDate;", 'intent': 'database_agent', 'summary': "Himanshu Saini's attendance details are available from 27th Dec 2024 to 8th Jan 2025, with varying shift timings, late minutes, and duty hours."}
