+ RIGHT('0' + CAST(CASE WHEN A.SiftIn > (CAST(A.AttendanceDate AS DATETIME) + CAST(MBA.SiftIn AS DATETIME)) THEN DATEDIFF(MINUTE, CAST(A.AttendanceDate AS DATETIME) + CAST(MBA.SiftIn AS DATETIME), A.SiftIn) ELSE 0 END % 60 AS VARCHAR), 2) AS LateMins, RIGHT('0' + CAST(CASE WHEN A.SiftOut > (CAST(A.AttendanceDate AS DATETIME) + CAST(MBA.SiftOut AS DATETIME)) THEN DATEDIFF(MINUTE, CAST(A.AttendanceDate AS DATETIME) + CAST(MBA.SiftOut AS DATETIME), A.SiftOut) ELSE 0 END / 60 AS VARCHAR), 2) + ':' + RIGHT('0' + CAST(CASE WHEN A.SiftOut > (CAST(A.AttendanceDate AS DATETIME) + CAST(MBA.SiftOut AS DATETIME)) THEN DATEDIFF(MINUTE, CAST(A.AttendanceDate AS DATETIME) + CAST(MBA.SiftOut AS DATETIME), A.SiftOut) ELSE 0 END % 60 AS VARCHAR), 2) AS OTHours, RIGHT('0' + CAST(DATEDIFF(MINUTE, CASE WHEN A.SiftIn > (CAST(A.AttendanceDate AS DATETIME) + CAST(MBA.SiftIn AS DATETIME)) THEN A.SiftIn ELSE (CAST(A.AttendanceDate AS DATETIME) + CAST(MBA.SiftIn AS DATETIME)) END, CASE WHEN A.SiftOut < (CAST(A.AttendanceDate AS DATETIME) + CAST(MBA.SiftOut AS DATETIME)) THEN A.SiftOut ELSE (CAST(A.AttendanceDate AS DATETIME) + CAST(MBA.SiftOut AS DATETIME)) END) / 60 AS VARCHAR), 2) + ':' + RIGHT('0' + CAST(DATEDIFF(MINUTE, CASE WHEN A.SiftIn > (CAST(A.AttendanceDate AS DATETIME) + CAST(MBA.SiftIn AS DATETIME)) THEN A.SiftIn ELSE (CAST(A.AttendanceDate AS DATETIME) + CAST(MBA.SiftIn AS DATETIME)) END, CASE WHEN A.SiftOut < (CAST(A.AttendanceDate AS DATETIME) + CAST(MBA.SiftOut AS DATETIME)) THEN A.SiftOut ELSE (CAST(A.AttendanceDate AS DATETIME) + CAST(MBA.SiftOut AS DATETIME)) END) % 60 AS VARCHAR), 2) AS DutyHours FROM (SELECT BA.EmployeeId, CAST(BA.AttendanceDate AS DATE) AS AttendanceDate, MIN(CASE WHEN BA.PunchMode = 'In' THEN BA.AttendanceDate END) AS SiftIn, MAX(CASE WHEN BA.PunchMode = 'Out' THEN BA.AttendanceDate END) AS SiftOut, MIN(CASE WHEN BA.PunchMode = 'In' THEN BA.SiftTypeId END) AS SiftTypeId FROM emp.BioAttendance BA WHERE BA.EmployeeId IN (SELECT Id FROM emp.vw_EmployeesList WHERE LOWER(EmployeeName) LIKE 'vivek tiwari%') GROUP BY BA.EmployeeId, CAST(BA.AttendanceDate AS DATE)) AS A INNER JOIN emp.vw_EmployeesList E ON A.EmployeeId = E.Id LEFT JOIN mst.BioAttSift MBA ON MBA.Id = A.SiftTypeId ORDER BY A.EmployeeId, A.AttendanceDate;", 'intent': 'database_agent', 'summary': "Vivek Tiwari's attendance details are as follows:\n\n- Employee ID: 3135\n- Department: INFORMATION TECHNOLOGY\n\nHere are his attendance records:\n\n1. 18 Oct 2015: \n   - Shift: SFT:A3\n   - In: 08:41:24\n   - Late: 00:41\n   - Duty Hours: 07:19\n\n2. 01 Aug 2023: \n   - Shift: SFT:A3\n   - In: 09:07:51\n   - Late: 01:07\n   - Duty Hours: 06:53\n\n3. 02 Aug 2023: \n   - Shift: SFT:A3\n   - In: 08:52:47\n   - Late: 00:52\n   - Duty Hours: 07:08\n\n4. 03 Aug 2023: \n   - Shift: SFT:A3\n   - In: 08:34:50\n   - Late: 00:34\n   - Duty Hours: 07:26\n\n5. 04 Aug 2023: \n   - Shift: SFT:A3\n   - In: 08:43:25\n   - Late: 00:43\n   - Duty Hours: 07:17\n\n6. 05 Aug 2023: \n   - Shift: SFT:A3\n   - In: 08:39:53\n   - Late: 00:39\n   - Duty Hours: 07:21\n\n7. 06 Aug 2023: \n   - Shift: SFT:A3\n   - In: 09:53:21\n   - Late: 01:53\n   - Duty Hours: 06:07\n\n8. 07 Aug 2023: \n   - Shift: SFT:A3\n   - In: 08:35:10\n   - Late: 00:35\n   - Duty Hours: 07:25\n\n9. 08 Aug 2023: \n   - Shift: SFT:A3\n   - In: 08:32:49\n   - Late: 00:32\n   - Duty Hours: 07:28\n\n10. 09 Aug 2023: \n    - Shift: SFT:A3\n    - In: 08:32:52\n    - Late: 00:32\n    - Duty Hours: 07:28\n\n11. 10 Aug 2023: \n    - Shift: SFT:A3\n    - In: 08:52:20\n    - Late: 00:52\n    - Duty Hours: 07:08\n\n12. 11 Aug 2023: \n    - Shift: SFT:A3\n    - In: 08:52:57\n    - Late: 00:52\n    - Duty Hours: 07:08\n\n13. 12 Aug 2023: \n    - Shift: SFT:A3\n    - In: 08:52:23\n    - Late: 00:52\n    - Duty Hours: 07:08\n\n14. 13 Aug 2023: \n    - Shift: SFT:A3\n    - In: 09:57:23\n    - Late: 01:57\n    - Duty Hours: 06:03\n\n15. 14 Aug 2023: \n    - Shift: SFT:A3\n    - In: 08:51:20\n    - Late: 00:51\n    - Duty Hours: 07:09\n\