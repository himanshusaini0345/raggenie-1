            question: Show the accommodation charges deducted for Mr. sukumar
query:   SELECT  EmployeeName,FatherName,BuildingName,RoomNo,PaycycleId,RoomCharge,RentalItemCharge,MaintinanceItemCharge,ELECtricMeaterCharge,GailMeaterCharge,GailCharge,
    NetGailCharge,NetServiceCharge FROM acom.ServicesCharges   WHERE  EmployeeId IN (SELECT Id FROM emp.Employees WHERE ActionStatusId = 1 AND LocationId = 1 AND EmployeeName LIKE 'sukumar%') 
ORDER BY EmployeeId,PaycycleId DESC

