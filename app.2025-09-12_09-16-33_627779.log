2025-09-12 14:14:03.904 | INFO     | app.chain.modules.cache_checker:handle:77 - out:[{'_id': ObjectId('68c3c2f59c9227a6e6abc9c5'), 'document': 'punch out time for himanshu saini of it department on 10 may', 'metadatas': {'query': "select e.EmployeeName, b.PunchMode,b.AttendanceDate \nfrom emp.bioattendance b\nleft join emp.vw_EmployeesList e on b.EmployeeId = e.Id \nwhere e.EmployeeName = 'himanshu saini'\nand e.DepartmentName = 'information technology'\nand cast(b.AttendanceDate as date) = '2025-05-10'\nand b.PunchMode = 'out'", 'metadata': '', 'datasource': 'database_agent', 'config_id': 1}, 'score': 0.7689894437789917, 'distances': 0.2310105562210083}, {'_id': ObjectId('68c3c2f59c9227a6e6abca46'), 'document': 'show me the salary deduction of ankush verma month of march and april', 'metadatas': {'query': " \n\nSELECT * FROM (SELECT emp.UniversityId,FPN.EmployeeId,FPN.EmployeeName,FPN.FatherName,FPN.DesignationName,FPN.DepartmentName,FPN.PayCycleId,FPN.PayCycleName,emp.JobName,FPN.CurrentBasicSalary,emp.ActionStatusId,\n        ServicesCharge,TransportationCharge,WifiCharge,GailCharge,TDS,Advance,PF AS PF,0 AS RF,MI AS Medical,SEF,SWF AS SWF,0 AS TC,ESI,0 AS SRF,Loan,Intrest AS LoanInterest,OtherDeduction,TotDeductions,AggregateDeduction\n    FROM emp.FinalPayrollforNONTeaching FPN\n    INNER JOIN mst.PayCycle PCL ON FPN.PayCycleId = PCL.Id \n    INNER JOIN emp.vw_EmployeesList emp ON emp.Id = FPN.EmployeeId \n    UNION ALL \n    SELECT  emp.UniversityId,FPN.EmployeeId,FPN.EmployeeName,FPN.FatherName,FPN.DesignationName,FPN.DepartmentName,FPN.PayCycleId,FPN.PayCycleName,emp.JobName,FPN.CurrentBasicSalary,emp.ActionStatusId,\n        ServicesCharge,TransportationCharge,WifiCharge,GailCharge,TDS,Advance,0 AS PF,RF,Medical,SEF,0 AS SWF,TC,0 AS ESI,SRF,Loan,LoanInterest,OtherDeduction,TotDeductions,AggregateDeduction \n\t\tFROM emp.FinalPayrollforTeaching FPN\n    INNER JOIN mst.PayCycle PCL ON FPN.PayCycleId = PCL.Id \n    INNER JOIN emp.vw_EmployeesList emp ON emp.Id = FPN.EmployeeId \n    UNION ALL \n    SELECT \n        emp.UniversityId,FPN.EmployeeId,FPN.EmployeeName,FPN.FatherName,FPN.DesignationName,FPN.DepartmentName,FPN.PayCycleId,FPN.PayCycleName,emp.JobName,FPN.CurrentBasicSalary,emp.ActionStatusId,\n        ServicesCharge,TransportationCharge,WifiCharge,GailCharge,TDS,Advance,0 AS PF,RF,Medical,SEF,0 AS SWF,TC,0 AS ESI,SRF,Loan,LoanInterest,OtherDeduction,TotDeductions,AggregateDeduction\n    FROM emp.FinalPayrollforStipend FPN\n    INNER JOIN mst.PayCycle PCL ON FPN.PayCycleId = PCL.Id   \n    INNER JOIN emp.vw_EmployeesList emp ON emp.Id = FPN.EmployeeId  \n) AS EmployeeSalaryDetails\nWHERE UniversityId = 1 AND ActionStatusId=1 AND  (UPPER(PayCycleName) LIKE '%MAR%' OR UPPER(PayCycleName) LIKE '%APR%'\n)  AND LOWER(EmployeeName) LIKE LOWER('%ankush Verma%')\n\nORDER BY  PayCycleId DESC", 'metadata': '', 'datasource': 'database_agent', 'config_id': 1}, 'score': 0.7629505395889282, 'distances': 0.23704946041107178}, {'_id': ObjectId('68c3c2f59c9227a6e6abc9b5'), 'document': 'show me the list of staff who is having salary belween 30000 to 50000', 'metadatas': {'query': '"SELECT *FROM (SELECT FPN.EmployeeId,FPN.EmployeeName,FPN.FatherName,FPN.DesignationName,FPN.DepartmentName,FPN.PayCycleId,FPN.PayCycleName,FCLY.FinancialYearName,JobName,FPN.CurrentBasicSalary\nFROM emp.FinalPayrollforNONTeaching FPN\nINNER JOIN mst.PayCycle PCL ON FPN.PayCycleId = PCL.Id AND PCL.IsDefaltForPayRoll = 1 \nINNER JOIN mst.FinancialYear FCLY ON FCLY.Id = PCL.FinancialYearId AND FCLY.IsDefaultLeave = 1  \nUNION ALL \nSELECT FPN.EmployeeId,FPN.EmployeeName,FPN.FatherName,FPN.DesignationName,FPN.DepartmentName,FPN.PayCycleId,FPN.PayCycleName,FCLY.FinancialYearName,JobName,FPN.CurrentBasicSalary\nFROM emp.FinalPayrollforTeaching FPN\nINNER JOIN mst.PayCycle PCL ON FPN.PayCycleId = PCL.Id  AND PCL.IsDefaltForPayRoll = 1 \nINNER JOIN mst.FinancialYear FCLY ON FCLY.Id = PCL.FinancialYearId AND FCLY.IsDefaultLeave = 1  \nUNION ALL \nSELECT FPN.EmployeeId,FPN.EmployeeName,FPN.FatherName,FPN.DesignationName,FPN.DepartmentName,FPN.PayCycleId,FPN.PayCycleName,FCLY.FinancialYearName,JobName,FPN.CurrentBasicSalary\nFROM emp.FinalPayrollforStipend FPN\nINNER JOIN mst.PayCycle PCL ON FPN.PayCycleId = PCL.Id AND PCL.IsDefaltForPayRoll = 1 \nINNER JOIN mst.FinancialYear FCLY ON FCLY.Id = PCL.FinancialYearId AND FCLY.IsDefaultLeave = 1 \n) AS EmployeeSalaryDetails\nWHERE   TRY_CAST(EmployeeSalaryDetails.CurrentBasicSalary AS float) BETWEEN 30000 AND 50000 "', 'metadata': '', 'datasource': 'database_agent', 'config_id': 1}, 'score': 0.74469393491745, 'distances': 0.25530606508255005}, {'_id': ObjectId('68c3c2f59c9227a6e6abca68'), 'document': 'How many employees received a salary hike of more than ₹5000?', 'metadatas': {'query': 'SELECT COUNT(*) AS EmployeesWithHikeOver5000 FROM (SELECT curr.EmployeeId, TRY_CAST(curr.CurrentBasicSalary AS DECIMAL(18,2)) AS CurrSalary, TRY_CAST(prev.CurrentBasicSalary AS DECIMAL(18,2)) AS PrevSalary FROM (SELECT EmployeeId, CurrentBasicSalary, TRY_CAST(LEFT(PayCycleName, 11) AS DATE) AS PayCycleStart FROM emp.FinalPayrollforTeaching WHERE ISNUMERIC(CurrentBasicSalary) = 1 UNION ALL SELECT EmployeeId, CurrentBasicSalary, TRY_CAST(LEFT(PayCycleName, 11) AS DATE) AS PayCycleStart FROM emp.FinalPayrollforNONTeaching WHERE ISNUMERIC(CurrentBasicSalary) = 1) AS curr INNER JOIN (SELECT EmployeeId, CurrentBasicSalary, TRY_CAST(LEFT(PayCycleName, 11) AS DATE) AS PayCycleStart FROM emp.FinalPayrollforTeaching WHERE ISNUMERIC(CurrentBasicSalary) = 1 UNION ALL SELECT EmployeeId, CurrentBasicSalary, TRY_CAST(LEFT(PayCycleName, 11) AS DATE) AS PayCycleStart FROM emp.FinalPayrollforNONTeaching WHERE ISNUMERIC(CurrentBasicSalary) = 1) AS prev ON curr.EmployeeId = prev.EmployeeId WHERE MONTH(curr.PayCycleStart) = 5 AND YEAR(curr.PayCycleStart) = YEAR(GETDATE()) AND MONTH(prev.PayCycleStart) = 5 AND YEAR(prev.PayCycleStart) = YEAR(GETDATE()) - 1) AS FinalData WHERE CurrSalary IS NOT NULL AND PrevSalary IS NOT NULL AND CurrSalary - PrevSalary > 5000;\n', 'metadata': '', 'datasource': 'database_agent', 'config_id': 1}, 'score': 0.7228371500968933, 'distances': 0.2771628499031067}, {'_id': ObjectId('68c3c2f59c9227a6e6abca66'), 'document': 'How many employees received a salary hike of more than ₹5000?', 'metadatas': {'query': 'SELECT COUNT(*) AS EmployeesWithHikeOver5000 FROM (SELECT curr.EmployeeId, TRY_CAST(curr.CurrentBasicSalary AS DECIMAL(18,2)) AS CurrSalary, TRY_CAST(prev.CurrentBasicSalary AS DECIMAL(18,2)) AS PrevSalary FROM (SELECT EmployeeId, CurrentBasicSalary, TRY_CAST(LEFT(PayCycleName, 11) AS DATE) AS PayCycleStart FROM emp.FinalPayrollforTeaching WHERE ISNUMERIC(CurrentBasicSalary) = 1 UNION ALL SELECT EmployeeId, CurrentBasicSalary, TRY_CAST(LEFT(PayCycleName, 11) AS DATE) AS PayCycleStart FROM emp.FinalPayrollforNONTeaching WHERE ISNUMERIC(CurrentBasicSalary) = 1) AS curr INNER JOIN (SELECT EmployeeId, CurrentBasicSalary, TRY_CAST(LEFT(PayCycleName, 11) AS DATE) AS PayCycleStart FROM emp.FinalPayrollforTeaching WHERE ISNUMERIC(CurrentBasicSalary) = 1 UNION ALL SELECT EmployeeId, CurrentBasicSalary, TRY_CAST(LEFT(PayCycleName, 11) AS DATE) AS PayCycleStart FROM emp.FinalPayrollforNONTeaching WHERE ISNUMERIC(CurrentBasicSalary) = 1) AS prev ON curr.EmployeeId = prev.EmployeeId WHERE MONTH(curr.PayCycleStart) = 5 AND YEAR(curr.PayCycleStart) = YEAR(GETDATE()) AND MONTH(prev.PayCycleStart) = 5 AND YEAR(prev.PayCycleStart) = YEAR(GETDATE()) - 1) AS FinalData WHERE CurrSalary IS NOT NULL AND PrevSalary IS NOT NULL AND CurrSalary - PrevSalary > 5000;\n', 'metadata': '', 'datasource': 'database_agent', 'config_id': 1}, 'score': 0.7228371500968933, 'distances': 0.2771628499031067}]
