            question: show me the list of staff who is having salary belween 30000 to 50000
query: "SELECT *FROM (SELECT FPN.EmployeeId,FPN.EmployeeName,FPN.FatherName,FPN.DesignationName,FPN.DepartmentName,FPN.PayCycleId,FPN.PayCycleName,FCLY.FinancialYearName,JobName,FPN.CurrentBasicSalary
FROM emp.FinalPayrollforNONTeaching FPN
INNER JOIN mst.PayCycle PCL ON FPN.PayCycleId = PCL.Id AND PCL.IsDefaltForPayRoll = 1 
INNER JOIN mst.FinancialYear FCLY ON FCLY.Id = PCL.FinancialYearId AND FCLY.IsDefaultLeave = 1  
UNION ALL 
SELECT FPN.EmployeeId,FPN.EmployeeName,FPN.FatherName,FPN.DesignationName,FPN.DepartmentName,FPN.PayCycleId,FPN.PayCycleName,FCLY.FinancialYearName,JobName,FPN.CurrentBasicSalary
FROM emp.FinalPayrollforTeaching FPN
INNER JOIN mst.PayCycle PCL ON FPN.PayCycleId = PCL.Id  AND PCL.IsDefaltForPayRoll = 1 
INNER JOIN mst.FinancialYear FCLY ON FCLY.Id = PCL.FinancialYearId AND FCLY.IsDefaultLeave = 1  
UNION ALL 
SELECT FPN.EmployeeId,FPN.EmployeeName,FPN.FatherName,FPN.DesignationName,FPN.DepartmentName,FPN.PayCycleId,FPN.PayCycleName,FCLY.FinancialYearName,JobName,FPN.CurrentBasicSalary
FROM emp.FinalPayrollforStipend FPN
INNER JOIN mst.PayCycle PCL ON FPN.PayCycleId = PCL.Id AND PCL.IsDefaltForPayRoll = 1 
INNER JOIN mst.FinancialYear FCLY ON FCLY.Id = PCL.FinancialYearId AND FCLY.IsDefaultLeave = 1 
) AS EmployeeSalaryDetails
WHERE   TRY_CAST(EmployeeSalaryDetails.CurrentBasicSalary AS float) BETWEEN 30000 AND 50000 "

question: Which employees in the IT department have resigned within the last three months?
query: select EmployeeName, UpdateDate as ResignationDate from emp.employees where UpdateDate > DateAdd(Month, -3, GetDate())and ActionStatusId = 2 and DepartmentId = (select top 1 Id from mst.Department where DepartmentName like 'information technology%') 

question: list of those employee which designation is software developer and working in MS Office?
query: SELECT EmployeeCode, EmployeeName, DepartmentName, DesignationName FROM emp.vw_EmployeesList WHERE LOWER(DesignationName) LIKE LOWER('%software developer%') AND LOWER(DepartmentName) LIKE LOWER('%M.S.OFFICE%')

question: employees who have done M.COM
query: select * from emp.vw_EducationDetailsList  where CoursesShortName = 'm.com'

question: Who are the employees with unverified profiles?
query: SELECT * FROM emp.employees WHERE ActionStatusId=1 AND VerifyEnable =1

question: show me the list of IT department with the staff names
query: SELECT Id, EmployeeName, DepartmentName FROM emp.vw_EmployeesList WHERE LOWER(DepartmentName) LIKE LOWER('%information technology%')


