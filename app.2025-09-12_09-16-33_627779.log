2025-09-12 12:08:38.523 | INFO     | app.chain.modules.cache_checker:handle:77 - out:[{'_id': ObjectId('68c3ae609c9227a6e6abc8af'), 'document': 'show the user profile of neeru singh in pharmacy department', 'metadatas': {'query': "SELECT e.Id, e.TitleName, e.EmployeeName, e.FrontImage, e.FatherName, e.DesignationName, e.DepartmentName, e.JoiningDate, ISNULL(exp.Years, 0) AS WorkingExperience, ISNULL(lv.LeaveTaken, 0) AS LeaveTaken, e.Phone, ISNULL(rel.Relatives, '') AS Relatives FROM emp.vw_EmployeesList e LEFT JOIN (SELECT EmployeeId, SUM(DATEDIFF(DAY, JoiningDate, CASE WHEN LeavingDate IS NULL OR LeavingDate = '' OR LeavingDate = '1900-01-01' THEN CAST(GETDATE() AS DATE) ELSE LeavingDate END)) / 365 AS Years FROM emp.WorkingExperience GROUP BY EmployeeId) AS exp ON e.Id = exp.EmployeeId LEFT JOIN (SELECT EmployeeId, SUM(CASE WHEN IsHalf = 1 THEN 0.5 ELSE 1.0 END) AS LeaveTaken FROM emp.LeaveDateWiseDetails WHERE MONTH(LeaveDate) = MONTH(GETDATE()) AND YEAR(LeaveDate) = YEAR(GETDATE()) GROUP BY EmployeeId) AS lv ON e.Id = lv.EmployeeId OUTER APPLY (SELECT STRING_AGG(CONCAT(RelativeName, ', ', EmployeeName, ', ', DesignationName, ', ', DepartmentName, ', ', CollegeName), ': ') AS Relatives FROM emp.vw_RelativesList r WHERE r.EmployeeId = e.Id) AS rel WHERE LOWER(e.DepartmentName) LIKE LOWER('%pharmacy%') AND LOWER(e.EmployeeName) LIKE LOWER('%neeru%');\n", 'metadata': '', 'datasource': 'database_agent', 'config_id': 1}, 'score': 0.6366000175476074, 'distances': 0.3633999824523926}, {'_id': ObjectId('68c3ae609c9227a6e6abc8dd'), 'document': 'Can you provide the arrear details for amil shaji?', 'metadatas': {'query': "SELECT Id, EmployeeName, AllowanceArrear, BasicSalaryArrear, OtArrear FROM emp.FinalPayrollforStipend WHERE LOWER(EmployeeName) LIKE LOWER('amil shaji%') UNION ALL SELECT Id, EmployeeName, AllowanceArrear, BasicSalaryArrear, OtArrear FROM emp.FinalPayrollforTeaching WHERE LOWER(EmployeeName) LIKE LOWER('amil shaji%') UNION ALL SELECT Id, EmployeeName, AllowanceArrear, BasicSalaryArrear, OtArrear FROM emp.FinalPayrollforNonTeaching WHERE LOWER(EmployeeName) LIKE LOWER('amil shaji%');\n", 'metadata': '', 'datasource': 'database_agent', 'config_id': 1}, 'score': 0.6310840249061584, 'distances': 0.36891597509384155}, {'_id': ObjectId('68c3ae609c9227a6e6abc80f'), 'document': 'show me the PAN card/Aadhaar card/Passport of Mr. amil shaji.', 'metadatas': {'query': "SELECT DD.EmployeeId,emp.EmployeeName,DD.Id,DT.DocumentTypeName,DD.EmployeeDocumentTypeId,DD.FilePath,DD.FileName,DD.FileType,DD.ActionStatusId FROM emp.DocumentDetails  DD\nINNER JOIN mst.EmployeeDocumentType  DT ON DD.EmployeeDocumentTypeId=DT.Id \nINNER JOIN emp.Employees emp ON emp.Id=DD.EmployeeId AND emp.ActionStatusId=1 AND emp.University_Id=1\nWHERE  DD.ActionStatusId=1  AND EmployeeName LIKE 'amil shaji%' AND (DT.DocumentTypeName LIKE'%PAN card%' OR DT.DocumentTypeName LIKE'%Aadhaar card%' OR DT.DocumentTypeName LIKE'%Passport%') \nORDER BY  DD.EmployeeId", 'metadata': '', 'datasource': 'database_agent', 'config_id': 1}, 'score': 0.6267358064651489, 'distances': 0.3732641935348511}, {'_id': ObjectId('68c3ae609c9227a6e6abc8a2'), 'document': "Who hasn't submitted their Aadhaar card?", 'metadatas': {'query': 'SELECT  *FROM  emp.[Employees]    \nWhere LocationId=1 AND ActionStatusId=1  \nAND Id NOT IN(SELECT DISTINCT EmployeeId FROM emp.DocumentDetails WHERE  ActionStatusId=1 AND EmployeeDocumentTypeId   IN(1,3))', 'metadata': '', 'datasource': 'database_agent', 'config_id': 1}, 'score': 0.6197906732559204, 'distances': 0.3802093267440796}, {'_id': ObjectId('68c3ae609c9227a6e6abc8dc'), 'document': 'arrear details for amil shaji', 'metadatas': {'query': "SELECT Id, EmployeeName, AllowanceArrear, BasicSalaryArrear, OtArrear FROM emp.FinalPayrollforStipend WHERE LOWER(EmployeeName) LIKE LOWER('amil shaji%') UNION ALL SELECT Id, EmployeeName, AllowanceArrear, BasicSalaryArrear, OtArrear FROM emp.FinalPayrollforTeaching WHERE LOWER(EmployeeName) LIKE LOWER('amil shaji%') UNION ALL SELECT Id, EmployeeName, AllowanceArrear, BasicSalaryArrear, OtArrear FROM emp.FinalPayrollforNonTeaching WHERE LOWER(EmployeeName) LIKE LOWER('amil shaji%');\n", 'metadata': '', 'datasource': 'database_agent', 'config_id': 1}, 'score': 0.6123694777488708, 'distances': 0.38763052225112915}, {'_id': ObjectId('68c3ae609c9227a6e6abc801'), 'document': 'show me the attendence of amil shaji', 'metadatas': {'query': "SELECT A.EmployeeId, E.EmployeeName, E.FrontImage, E.DepartmentName, A.AttendanceDate, A.SiftIn, A.SiftOut, A.SiftTypeId, MBA.SiftName, RIGHT('0' + CAST(CASE WHEN A.SiftIn > (CAST(A.AttendanceDate AS DATETIME) + CAST(MBA.SiftIn AS DATETIME)) THEN DATEDIFF(MINUTE, CAST(A.AttendanceDate AS DATETIME) + CAST(MBA.SiftIn AS DATETIME), A.SiftIn) ELSE 0 END / 60 AS VARCHAR), 2) + ':' + RIGHT('0' + CAST(CASE WHEN A.SiftIn > (CAST(A.AttendanceDate AS DATETIME) + CAST(MBA.SiftIn AS DATETIME)) THEN DATEDIFF(MINUTE, CAST(A.AttendanceDate AS DATETIME) + CAST(MBA.SiftIn AS DATETIME), A.SiftIn) ELSE 0 END % 60 AS VARCHAR), 2) AS LateMins, RIGHT('0' + CAST(CASE WHEN A.SiftOut > (CAST(A.AttendanceDate AS DATETIME) + CAST(MBA.SiftOut AS DATETIME)) THEN DATEDIFF(MINUTE, CAST(A.AttendanceDate AS DATETIME) + CAST(MBA.SiftOut AS DATETIME), A.SiftOut) ELSE 0 END / 60 AS VARCHAR), 2) + ':' + RIGHT('0' + CAST(CASE WHEN A.SiftOut > (CAST(A.AttendanceDate AS DATETIME) + CAST(MBA.SiftOut AS DATETIME)) THEN DATEDIFF(MINUTE, CAST(A.AttendanceDate AS DATETIME) + CAST(MBA.SiftOut AS DATETIME), A.SiftOut) ELSE 0 END % 60 AS VARCHAR), 2) AS OTHours, RIGHT('0' + CAST(DATEDIFF(MINUTE, CASE WHEN A.SiftIn > (CAST(A.AttendanceDate AS DATETIME) + CAST(MBA.SiftIn AS DATETIME)) THEN A.SiftIn ELSE (CAST(A.AttendanceDate AS DATETIME) + CAST(MBA.SiftIn AS DATETIME)) END, CASE WHEN A.SiftOut < (CAST(A.AttendanceDate AS DATETIME) + CAST(MBA.SiftOut AS DATETIME)) THEN A.SiftOut ELSE (CAST(A.AttendanceDate AS DATETIME) + CAST(MBA.SiftOut AS DATETIME)) END) / 60 AS VARCHAR), 2) + ':' + RIGHT('0' + CAST(DATEDIFF(MINUTE, CASE WHEN A.SiftIn > (CAST(A.AttendanceDate AS DATETIME) + CAST(MBA.SiftIn AS DATETIME)) THEN A.SiftIn ELSE (CAST(A.AttendanceDate AS DATETIME) + CAST(MBA.SiftIn AS DATETIME)) END, CASE WHEN A.SiftOut < (CAST(A.AttendanceDate AS DATETIME) + CAST(MBA.SiftOut AS DATETIME)) THEN A.SiftOut ELSE (CAST(A.AttendanceDate AS DATETIME) + CAST(MBA.SiftOut AS DATETIME)) END) % 60 AS VARCHAR), 2) AS DutyHours FROM (SELECT BA.EmployeeId, CAST(BA.AttendanceDate AS DATE) AS AttendanceDate, MIN(CASE WHEN BA.PunchMode = 'In' THEN BA.AttendanceDate END) AS SiftIn, MAX(CASE WHEN BA.PunchMode = 'Out' THEN BA.AttendanceDate END) AS SiftOut, MIN(CASE WHEN BA.PunchMode = 'In' THEN BA.SiftTypeId END) AS SiftTypeId FROM emp.BioAttendance BA WHERE BA.EmployeeId IN (SELECT Id FROM emp.vw_EmployeesList WHERE EmployeeName LIKE 'amil shaji%') AND CAST(BA.AttendanceDate AS DATE) BETWEEN '2025-06-01' AND '2025-06-18' GROUP BY BA.EmployeeId, CAST(BA.AttendanceDate AS DATE)) AS A INNER JOIN emp.vw_EmployeesList E ON A.EmployeeId = E.Id LEFT JOIN mst.BioAttSift MBA ON MBA.Id = A.SiftTypeId ORDER BY A.EmployeeId, A.AttendanceDate;", 'metadata': '', 'datasource': 'database_agent', 'config_id': 1}, 'score': 0.6099328994750977, 'distances': 0.39006710052490234}]
