ceDate AS DATE) AS AttendanceDate, MIN(CASE WHEN BA.PunchMode = 'In' THEN BA.AttendanceDate END) AS SiftIn, MAX(CASE WHEN BA.PunchMode = 'Out' THEN BA.AttendanceDate END) AS SiftOut, MIN(CASE WHEN BA.PunchMode = 'In' THEN BA.SiftTypeId END) AS SiftTypeId FROM emp.BioAttendance BA WHERE BA.EmployeeId IN (SELECT Id FROM emp.vw_EmployeesList WHERE LOWER(EmployeeName) LIKE LOWER('vivek tiwari%')) AND CAST(BA.AttendanceDate AS DATE) BETWEEN '2025-06-01' AND '2025-06-18' GROUP BY BA.EmployeeId, CAST(BA.AttendanceDate AS DATE)) AS A INNER JOIN emp.vw_EmployeesList E ON A.EmployeeId = E.Id LEFT JOIN mst.BioAttSift MBA ON MBA.Id = A.SiftTypeId ORDER BY A.EmployeeId, A.AttendanceDate;", 'intent': 'database_agent', 'summary': "Vivek Tiwari's attendance details are as follows:\n\n- He works in the INFORMATION TECHNOLOGY department.\n- His attendance records are available for the dates between June 1, 2025, and June 18, 2025.\n- He was late on multiple days, with the latest being 1 hour and 46 minutes on June 12, 2025.\n- His shift name is SFT:A8 and shift type ID is 40.\n- On June 14, 2025, he worked for 37 minutes before checking out.\n\nHere are the detailed attendance records:\n\nJune 1, 2025: \n- In at 8:41:34 AM\n- Late by 41 minutes\n- Worked for 7 hours and 19 minutes\n\nJune 2, 2025: \n- In at 9:16:10 AM\n- Late by 1 hour and 16 minutes\n- Worked for 6 hours and 44 minutes\n\nJune 3, 2025: \n- In at 9:14:54 AM\n- Late by 1 hour and 14 minutes\n- Worked for 6 hours and 46 minutes\n\nJune 4, 2025: \n- In at 8:41:23 AM\n- Late by 41 minutes\n- Worked for 7 hours and 19 minutes\n\nJune 5, 2025: \n- In at 8:37:59 AM\n- Late by 37 minutes\n- Worked for 7 hours and 23 minutes\n\nJune 6, 2025: \n- In at 8:09:42 AM\n- Late by 9 minutes\n- Worked for 7 hours and 51 minutes\n\nJune 9, 2025: \n- In at 8:54:22 AM\n- Late by 54 minutes\n- Worked for 7 hours and 6 minutes\n\nJune 10, 2025: \n- In at 8:58:50 AM\n- Late by 58 minutes\n- Worked for 7 hours and 2 minutes\n\nJune 11, 2025: