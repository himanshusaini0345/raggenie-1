rs FROM (SELECT BA.EmployeeId, CAST(BA.AttendanceDate AS DATE) AS AttendanceDate, MIN(CASE WHEN BA.PunchMode = 'In' THEN BA.AttendanceDate END) AS SiftIn, MAX(CASE WHEN BA.PunchMode = 'Out' THEN BA.AttendanceDate END) AS SiftOut, MIN(CASE WHEN BA.PunchMode = 'In' THEN BA.SiftTypeId END) AS SiftTypeId FROM emp.BioAttendance BA WHERE BA.EmployeeId IN (SELECT Id FROM emp.vw_EmployeesList WHERE EmployeeName LIKE 'xxxx xx%') AND CAST(BA.AttendanceDate AS DATE) BETWEEN '2025-06-01' AND '2025-06-18' GROUP BY BA.EmployeeId, CAST(BA.AttendanceDate AS DATE)) AS A INNER JOIN emp.vw_EmployeesList E ON A.EmployeeId = E.Id LEFT JOIN mst.BioAttSift MBA ON MBA.Id = A.SiftTypeId ORDER BY A.EmployeeId, A.AttendanceDate;

question: last increment of 'xxxx yy'
query: WITH RankedSalaries AS (SELECT ESD.Id,ESD.EmployeeId,emp.EmployeeName,emp.FatherName,ESD.PreviousSalary,ESD.CurrentBasicSalary,ESD.EffectiveDate, ROW_NUMBER() OVER (PARTITION BY ESD.EmployeeId ORDER BY ESD.EffectiveDate DESC) AS rn
    FROM [emp].[EmpSalaryDetails] ESD INNER JOIN emp.Employees emp  ON emp.Id = ESD.EmployeeId
    WHERE emp.ActionStatusId = 1 AND emp.EmployeeName LIKE '%xxxx yy%'
)
SELECT Id,EmployeeId,EmployeeName,FatherName,PreviousSalary,CurrentBasicSalary,EffectiveDate FROM RankedSalaries WHERE rn = 1
ORDER BY EmployeeId

