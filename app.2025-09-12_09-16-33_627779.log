2412109, 'distances': 0.34708595275878906}, {'_id': ObjectId('68c3ae609c9227a6e6abc80f'), 'document': 'show me the PAN card/Aadhaar card/Passport of Mr. amil shaji.', 'metadatas': {'query': "SELECT DD.EmployeeId,emp.EmployeeName,DD.Id,DT.DocumentTypeName,DD.EmployeeDocumentTypeId,DD.FilePath,DD.FileName,DD.FileType,DD.ActionStatusId FROM emp.DocumentDetails  DD\nINNER JOIN mst.EmployeeDocumentType  DT ON DD.EmployeeDocumentTypeId=DT.Id \nINNER JOIN emp.Employees emp ON emp.Id=DD.EmployeeId AND emp.ActionStatusId=1 AND emp.University_Id=1\nWHERE  DD.ActionStatusId=1  AND EmployeeName LIKE 'amil shaji%' AND (DT.DocumentTypeName LIKE'%PAN card%' OR DT.DocumentTypeName LIKE'%Aadhaar card%' OR DT.DocumentTypeName LIKE'%Passport%') \nORDER BY  DD.EmployeeId", 'metadata': '', 'datasource': 'database_agent', 'config_id': 1}, 'score': 0.6451619267463684, 'distances': 0.3548380732536316}, {'_id': ObjectId('68c3ae609c9227a6e6abc888'), 'document': 'what is the status of complaints of room no 103 of mahaveer bhawan', 'metadatas': {'query': "SELECT Id,EmployeeName,DesignationName,DepartmentName,TicketingDepartmentName,SuggestionName,StatusName FROM emp.vw_TicketingHeadList\nWHERE  RoomNo=103 AND BuildingName LIKE'%mahaveer bhawan%'", 'metadata': '', 'datasource': 'database_agent', 'config_id': 1}, 'score': 0.6429059505462646, 'distances': 0.35709404945373535}, {'_id': ObjectId('68c3ae609c9227a6e6abc816'), 'document': 'is there any vacant room at mahaveer bhawan?', 'metadatas': {'query': "SELECT Case When COUNT(*)>0 THEN 1 ELSE 0 END IsVacant  FROM acom.vw_AccommodationAvailabilityList emp  WHERE  AllotmentStatusName='vacant' AND BuildingName='mahaveer bhawan'", 'metadata': '', 'datasource': 'database_agent', 'config_id': 1}, 'score': 0.6400597095489502, 'distances': 0.3599402904510498}, {'_id': ObjectId('68c3ae609c9227a6e6abc821'), 'document': 'what is the address of sukumar', 'metadatas': {'query': "SELECT EA.Id,EA.EmployeeId,emp.EmployeeName,emp.FatherName,EA.AddressTypeName,EA.Address,EA.StateName,EA.CityName,EA.PinCode FROM  emp.vw_EmployeesAddressList EA\n INNER JOIn emp.Employees emp ON emp.Id=EA.EmployeeId AND emp.ActionStatusId=1\n WHERE EA.ActionStatusId=1 AND EmployeeName LIKE 'sukumar%' \n ORDER BY EA.EmployeeId,EA.AddressTypeName DESC", 'metadata': '', 'datasource': 'database_agent', 'config_id': 1}, 'score': 0.6247684955596924, 'distances': 0.3752315044403076}]
