WHERE e.ActionStatusId = 1 AND e.UniversityId = 1 AND e.JobTypeId IN(2,4)  and UpdatedInTime IS NOT NULL  AND e.EmployeeName LIKE '%Amit%'  
  ORDER BY  e.EmployeeName,e.DepartmentName


