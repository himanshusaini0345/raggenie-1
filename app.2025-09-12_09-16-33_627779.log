            question: show me the salary deduction of ankush verma month of march and april
query:  

SELECT * FROM (SELECT emp.UniversityId,FPN.EmployeeId,FPN.EmployeeName,FPN.FatherName,FPN.DesignationName,FPN.DepartmentName,FPN.PayCycleId,FPN.PayCycleName,emp.JobName,FPN.CurrentBasicSalary,emp.ActionStatusId,
        ServicesCharge,TransportationCharge,WifiCharge,GailCharge,TDS,Advance,PF AS PF,0 AS RF,MI AS Medical,SEF,SWF AS SWF,0 AS TC,ESI,0 AS SRF,Loan,Intrest AS LoanInterest,OtherDeduction,TotDeductions,AggregateDeduction
    FROM emp.FinalPayrollforNONTeaching FPN
    INNER JOIN mst.PayCycle PCL ON FPN.PayCycleId = PCL.Id 
    INNER JOIN emp.vw_EmployeesList emp ON emp.Id = FPN.EmployeeId 
    UNION ALL 
    SELECT  emp.UniversityId,FPN.EmployeeId,FPN.EmployeeName,FPN.FatherName,FPN.DesignationName,FPN.DepartmentName,FPN.PayCycleId,FPN.PayCycleName,emp.JobName,FPN.CurrentBasicSalary,emp.ActionStatusId,
        ServicesCharge,TransportationCharge,WifiCharge,GailCharge,TDS,Advance,0 AS PF,RF,Medical,SEF,0 AS SWF,TC,0 AS ESI,SRF,Loan,LoanInterest,OtherDeduction,TotDeductions,AggregateDeduction 
		FROM emp.FinalPayrollforTeaching FPN
    INNER JOIN mst.PayCycle PCL ON FPN.PayCycleId = PCL.Id 
    INNER JOIN emp.vw_EmployeesList emp ON emp.Id = FPN.EmployeeId 
    UNION ALL 
    SELECT 
        emp.UniversityId,FPN.EmployeeId,FPN.EmployeeName,FPN.FatherName,FPN.DesignationName,FPN.DepartmentName,FPN.PayCycleId,FPN.PayCycleName,emp.JobName,FPN.CurrentBasicSalary,emp.ActionStatusId,
        ServicesCharge,TransportationCharge,WifiCharge,GailCharge,TDS,Advance,0 AS PF,RF,Medical,SEF,0 AS SWF,TC,0 AS ESI,SRF,Loan,LoanInterest,OtherDeduction,TotDeductions,AggregateDeduction
    FROM emp.FinalPayrollforStipend FPN
    INNER JOIN mst.PayCycle PCL ON FPN.PayCycleId = PCL.Id   
    INNER JOIN emp.vw_EmployeesList emp ON emp.Id = FPN.EmployeeId  
) AS EmployeeSalaryDetails
WHERE UniversityId = 1 AND ActionStatusId=1 AND  (UPPER(PayCycleName) LIKE '%MAR%' OR UPPER(PayCycleName) LIKE '%APR%'
)  AND LOWER(EmployeeName) LIKE LOWER('%ankush Verma%')

ORDER BY  PayCycleId DESC

question: List of leave days taken by Iwin Shaji last month
query: SELECT ld.EmployeeId, ev.EmployeeName, ev.DepartmentName, ev.DesignationName, COUNT(*) AS LeavesTaken FROM emp.LeaveDateWiseDetails ld INNER JOIN emp.vw_EmployeesList ev ON ld.EmployeeId = ev.Id WHERE LOWER(ev.EmployeeName) LIKE 'iwin shaji%' AND ld.LeaveDate >= DATEFROMPARTS(YEAR(GETDATE()), MONTH(GETDATE())-1, 1) AND ld.LeaveDate <= EOMONTH(DATEFROMPARTS(YEAR(GETDATE()), MONTH(GETDATE())-1, 1)) AND ld.ActionStatusId = 4 AND ld.ApprovedActionStatusId = 4 GROUP BY ld.EmployeeId, ev.EmployeeName, ev.DepartmentName, ev.DesignationName;

question: show me the list of individuals whose salary has been stopped.
query: SELECT * FROM ( SELECT EmployeeName,EmployeeCode,FatherName,PanNo,DOB,DesignationName,DepartmentName,JobName,CollegeName,PayCycleName  FROM emp.FinalPayrollforNONTeaching WHERE PayCycleId = (SELECT TOP(1) Id FROM mst.PayCycle WHERE IsDefaltForPayRoll = 1 AND JobTypeId = 1) AND StopSalary = 1


question: Expenditures incurred by iwin shaji, the driver, on 15 May
query: SELECT e.EmployeeName, pc.Date, pc.Amount, pc.Remark FROM Vhc.PetrolConception pc INNER JOIN Vhc.DriverDetails d ON d.Id = pc.DriverId INNER JOIN emp.employees e ON e.Id = d.EmployeeId WHERE e.EmployeeName LIKE 'iwin shaji%' AND pc.Date = '2025-05-15';


question: What is the headcount of IT staff on leave this month?
query: SELECT ld.EmployeeId, ev.EmployeeName, ev.DepartmentName, ev.DesignationName, COUNT(*) AS LeavesTaken FROM emp.LeaveDateWiseDetails ld INNER JOIN emp.vw_EmployeesList ev ON ld.EmployeeId = ev.Id WHERE LOWER(ev.DepartmentName) LIKE '%information technology%' AND ld.LeaveDate >= CONVERT(varchar(10), DATEFROMPARTS(YEAR(GETDATE()), MONTH(GETDATE()), 1), 120) AND ld.LeaveDate <= GETDATE() AND ld.ActionStatusId = 4 AND ld.ApprovedActionStatusId = 4 GROUP BY ld.EmployeeId, ev.EmployeeName, ev.DepartmentName, ev.DesignationName;

question: Please provide the details of employees whose city name is Saharanpur.
query: SELECT EAD.EmployeeId,EMP.JobName,EMP.DesignationName,EMP.DepartmentName,EMP.EmployeeName,EMP.FatherName,EAD.CityName FROM emp.VW_EmployeesList EMP 
INNER JOIN [emp].[vw_EmployeesAddressList] EAD ON EMP.Id=EAD.EmployeeId
WHERE EAD.CityName LIKE 'Saharanpur'


