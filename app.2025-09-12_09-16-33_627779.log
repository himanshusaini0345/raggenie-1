2025-09-12 09:54:40.844 | INFO     | app.chain.modules.cache_checker:handle:77 - out:[{'_id': ObjectId('68c394cc9c9227a6e6abc46e'), 'document': 'show me the salary deduction of ankush verma month of march and april', 'metadatas': {'query': " \n\nSELECT * FROM (SELECT emp.UniversityId,FPN.EmployeeId,FPN.EmployeeName,FPN.FatherName,FPN.DesignationName,FPN.DepartmentName,FPN.PayCycleId,FPN.PayCycleName,emp.JobName,FPN.CurrentBasicSalary,emp.ActionStatusId,\n        ServicesCharge,TransportationCharge,WifiCharge,GailCharge,TDS,Advance,PF AS PF,0 AS RF,MI AS Medical,SEF,SWF AS SWF,0 AS TC,ESI,0 AS SRF,Loan,Intrest AS LoanInterest,OtherDeduction,TotDeductions,AggregateDeduction\n    FROM emp.FinalPayrollforNONTeaching FPN\n    INNER JOIN mst.PayCycle PCL ON FPN.PayCycleId = PCL.Id \n    INNER JOIN emp.vw_EmployeesList emp ON emp.Id = FPN.EmployeeId \n    UNION ALL \n    SELECT  emp.UniversityId,FPN.EmployeeId,FPN.EmployeeName,FPN.FatherName,FPN.DesignationName,FPN.DepartmentName,FPN.PayCycleId,FPN.PayCycleName,emp.JobName,FPN.CurrentBasicSalary,emp.ActionStatusId,\n        ServicesCharge,TransportationCharge,WifiCharge,GailCharge,TDS,Advance,0 AS PF,RF,Medical,SEF,0 AS SWF,TC,0 AS ESI,SRF,Loan,LoanInterest,OtherDeduction,TotDeductions,AggregateDeduction \n\t\tFROM emp.FinalPayrollforTeaching FPN\n    INNER JOIN mst.PayCycle PCL ON FPN.PayCycleId = PCL.Id \n    INNER JOIN emp.vw_EmployeesList emp ON emp.Id = FPN.EmployeeId \n    UNION ALL \n    SELECT \n        emp.UniversityId,FPN.EmployeeId,FPN.EmployeeName,FPN.FatherName,FPN.DesignationName,FPN.DepartmentName,FPN.PayCycleId,FPN.PayCycleName,emp.JobName,FPN.CurrentBasicSalary,emp.ActionStatusId,\n        ServicesCharge,TransportationCharge,WifiCharge,GailCharge,TDS,Advance,0 AS PF,RF,Medical,SEF,0 AS SWF,TC,0 AS ESI,SRF,Loan,LoanInterest,OtherDeduction,TotDeductions,AggregateDeduction\n    FROM emp.FinalPayrollforStipend FPN\n    INNER JOIN mst.PayCycle PCL ON FPN.PayCycleId = PCL.Id   \n    INNER JOIN emp.vw_EmployeesList emp ON emp.Id = FPN.EmployeeId  \n) AS EmployeeSalaryDetails\nWHERE UniversityId = 1 AND ActionStatusId=1 AND  (UPPER(PayCycleName) LIKE '%MAR%' OR UPPER(PayCycleName) LIKE '%APR%'\n)  AND LOWER(EmployeeName) LIKE LOWER('%ankush Verma%')\n\nORDER BY  PayCycleId DESC", 'metadata': '', 'datasource': 'database_agent', 'config_id': 1}, 'score': 0.6663227677345276, 'distances': 0.3336772322654724}, {'_id': ObjectId('68c394cc9c9227a6e6abc3f2'), 'document': 'what is the total working experience of amil shaji', 'metadatas': {'query': "\nSELECT e.Id,e.EmployeeName,e.FatherName,e.JoiningDate,(SELECT CAST(FLOOR(SUM(CASE WHEN Organization IN ('SUBHARTI UNIVERSITY', 'Swami Vivekanand Subharti University', 'Swami Vivekanand Subharti Univesity') \n    THEN DATEDIFF(DAY, TRY_CONVERT(DATE, WE.JoiningDate), CASE WHEN TRY_CONVERT(DATE, WE.LeavingDate) IN ('1900-01-01', '') THEN CONVERT(DATE, GETDATE()) ELSE TRY_CONVERT(DATE, WE.LeavingDate) END) \n    ELSE 0 END) / 365.25) AS VARCHAR) + ' Years ' + CAST(FLOOR((SUM(CASE WHEN Organization IN ('SUBHARTI UNIVERSITY', 'Swami Vivekanand Subharti University', 'Swami Vivekanand Subharti Univesity') \n    THEN DATEDIFF(DAY, TRY_CONVERT(DATE, WE.JoiningDate),CASE WHEN TRY_CONVERT(DATE, WE.LeavingDate) IN ('1900-01-01', '') THEN CONVERT(DATE, GETDATE()) ELSE TRY_CONVERT(DATE, WE.LeavingDate)END) \n    ELSE 0 END) % 365.25) / 30.44) AS VARCHAR) + ' Months ' + CAST(FLOOR((SUM(CASE WHEN Organization IN ('SUBHARTI UNIVERSITY', 'Swami Vivekanand Subharti University', 'Swami Vivekanand Subharti Univesity') \n    THEN DATEDIFF(DAY, TRY_CONVERT(DATE, WE.JoiningDate),CASE WHEN TRY_CONVERT(DATE, WE.LeavingDate) IN ('1900-01-01', '') THEN CONVERT(DATE, GETDATE()) ELSE TRY_CONVERT(DATE, WE.LeavingDate)END) \n    ELSE 0 END) % 365.25) % 30.44) AS VARCHAR) + ' Days' FROM emp.vw_WorkingExperienceList WE WHERE WE.EmployeeId = e.Id AND WE.ActionStatusId = 1) AS InSideExperience, \n    (SELECT CAST(FLOOR(SUM(CASE WHEN Organization NOT IN ('SUBHARTI UNIVERSITY', 'Swami Vivekanand Subharti University', 'Swami Vivekanand Subharti Univesity') THEN DATEDIFF(DAY, TRY_CONVERT(DATE, WE.JoiningDate), \n    CASE WHEN WE.LeavingDate = '1900-01-01' THEN GETDATE() ELSE TRY_CONVERT(DATE, WE.LeavingDate) END) ELSE 0 END) / 365.25) AS VARCHAR) + ' Years ' + CAST(FLOOR((SUM(CASE WHEN Organization NOT IN ('SUBHARTI UNIVERSITY', 'Swami Vivekanand Subharti University', 'Swami Vivekanand Subharti Univesity') \n    THEN DATEDIFF(DAY, TRY_CONVERT(DATE, WE.JoiningDate),CASE WHEN WE.LeavingDate = '1900-01-01' THEN GETDATE() ELSE TRY_CONVERT(DATE, WE.LeavingDate) END) ELSE 0 END) % 365.25) / 30.44) AS VARCHAR) + ' Months ' +\n    CAST(FLOOR((SUM(CASE WHEN Organization NOT IN ('SUBHARTI UNIVERSITY', 'Swami Vivekanand Subharti University', 'Swami Vivekanand Subharti Univesity') THEN DATEDIFF(DAY, TRY_CONVERT(DATE, WE.JoiningDate), CASE \n    WHEN WE.LeavingDate = '1900-01-01' THEN GETDATE() ELSE TRY_CONVERT(DATE, WE.LeavingDate) END) ELSE 0 END) % 365.25) % 30.44) AS VARCHAR) + ' Days' FROM emp.vw_WorkingExperienceList WE \n    WHERE WE.EmployeeId = e.Id AND WE.ActionStatusId = 1) AS OutsiteExperience,e.DesignationName,e.DepartmentName,e.MobileNo FROM emp.vw_EmployeesList e WHERE\n        e.UniversityId=1 AND\n        e.ActionStatusId = 1 AND e.EmployeeName LIKE 'amil shaji%' ", 'metadata': '', 'datasource': 'database_agent', 'config_id': 1}, 'score': 0.6635989546775818, 'distances': 0.3364010453224182}, {'_id': ObjectId('68c394cc9c9227a6e6abc402'), 'document': 'roop singh service charge details?', 'metadatas': {'query': '"\nselect e.EmployeeName ,e.FatherName ,e.DepartmentName ,e.DesignationName ,BuildingName , RoomNo,RoomCharge,\nELECtricMeaterCharge MeaterCharge,GarbageCharge  ,NETELCTCharge Charge ,NetServiceCharge , NetGailCharge  ,NetServiceCharge+NetGailCharge TotalServiceCharge\n,p.PayCycleName Month   from acom.ServicesCharges s\ninner join mst.PayCycle p  on p.Id = s.PaycycleId \ninner join emp.vw_EmployeesList  e on e.Id = s.EmployeeId \nwhere  s.PaycycleId >=40 and e.EmployeeName like \'Roop singh%\' and e.UniversityId =1\norder by s.EmployeeId ,s.PaycycleId\n"', 'metadata': '', 'datasource': 'database_agent', 'config_id': 1}, 'score': 0.6594235897064209, 'distances': 0.3405764102935791}, {'_id': ObjectId('68c394cc9c9227a6e6abc3dd'), 'document': 'show me the list of staff who is having salary belween 30000 to 50000', 'metadatas': {'query': '"SELECT *FROM (SELECT FPN.EmployeeId,FPN.EmployeeName,FPN.FatherName,FPN.DesignationName,FPN.DepartmentName,FPN.PayCycleId,FPN.PayCycleName,FCLY.FinancialYearName,JobName,FPN.CurrentBasicSalary\nFROM emp.FinalPayrollforNONTeaching FPN\nINNER JOIN mst.PayCycle PCL ON FPN.PayCycleId = PCL.Id AND PCL.IsDefaltForPayRoll = 1 \nINNER JOIN mst.FinancialYear FCLY ON FCLY.Id = PCL.FinancialYearId AND FCLY.IsDefaultLeave = 1  \nUNION ALL \nSELECT FPN.EmployeeId,FPN.EmployeeName,FPN.FatherName,FPN.DesignationName,FPN.DepartmentName,FPN.PayCycleId,FPN.PayCycleName,FCLY.FinancialYearName,JobName,FPN.CurrentBasicSalary\nFROM emp.FinalPayrollforTeaching FPN\nINNER JOIN mst.PayCycle PCL ON FPN.PayCycleId = PCL.Id  AND PCL.IsDefaltForPayRoll = 1 \nINNER JOIN mst.FinancialYear FCLY ON FCLY.Id = PCL.FinancialYearId AND FCLY.IsDefaultLeave = 1  \nUNION ALL \nSELECT FPN.EmployeeId,FPN.EmployeeName,FPN.FatherName,FPN.DesignationName,FPN.DepartmentName,FPN.PayCycleId,FPN.PayCycleName,FCLY.FinancialYearName,JobName,FPN.CurrentBasicSalary\nFROM emp.FinalPayrollforStipend FPN\nINNER JOIN mst.PayCycle PCL ON FPN.PayCycleId = PCL.Id AND PCL.IsDefaltForPayRoll = 1 \nINNER JOIN mst.FinancialYear FCLY ON FCLY.Id = PCL.FinancialYearId AND FCLY.IsDefaultLeave = 1 \n) AS EmployeeSalaryDetails\nWHERE   TRY_CAST(EmployeeSalaryDetails.CurrentBasicSalary AS float) BETWEEN 30000 AND 50000 "', 'metadata': '', 'datasource': 'database_agent', 'config_id': 1}, 'score': 0.657888650894165, 'distances': 0.34211134910583496}]
