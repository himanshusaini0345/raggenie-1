2025-09-12 09:56:27.709 | INFO     | app.chain.modules.cache_checker:handle:77 - out:[{'_id': ObjectId('68c394cc9c9227a6e6abc46e'), 'document': 'show me the salary deduction of ankush verma month of march and april', 'metadatas': {'query': " \n\nSELECT * FROM (SELECT emp.UniversityId,FPN.EmployeeId,FPN.EmployeeName,FPN.FatherName,FPN.DesignationName,FPN.DepartmentName,FPN.PayCycleId,FPN.PayCycleName,emp.JobName,FPN.CurrentBasicSalary,emp.ActionStatusId,\n        ServicesCharge,TransportationCharge,WifiCharge,GailCharge,TDS,Advance,PF AS PF,0 AS RF,MI AS Medical,SEF,SWF AS SWF,0 AS TC,ESI,0 AS SRF,Loan,Intrest AS LoanInterest,OtherDeduction,TotDeductions,AggregateDeduction\n    FROM emp.FinalPayrollforNONTeaching FPN\n    INNER JOIN mst.PayCycle PCL ON FPN.PayCycleId = PCL.Id \n    INNER JOIN emp.vw_EmployeesList emp ON emp.Id = FPN.EmployeeId \n    UNION ALL \n    SELECT  emp.UniversityId,FPN.EmployeeId,FPN.EmployeeName,FPN.FatherName,FPN.DesignationName,FPN.DepartmentName,FPN.PayCycleId,FPN.PayCycleName,emp.JobName,FPN.CurrentBasicSalary,emp.ActionStatusId,\n        ServicesCharge,TransportationCharge,WifiCharge,GailCharge,TDS,Advance,0 AS PF,RF,Medical,SEF,0 AS SWF,TC,0 AS ESI,SRF,Loan,LoanInterest,OtherDeduction,TotDeductions,AggregateDeduction \n\t\tFROM emp.FinalPayrollforTeaching FPN\n    INNER JOIN mst.PayCycle PCL ON FPN.PayCycleId = PCL.Id \n    INNER JOIN emp.vw_EmployeesList emp ON emp.Id = FPN.EmployeeId \n    UNION ALL \n    SELECT \n        emp.UniversityId,FPN.EmployeeId,FPN.EmployeeName,FPN.FatherName,FPN.DesignationName,FPN.DepartmentName,FPN.PayCycleId,FPN.PayCycleName,emp.JobName,FPN.CurrentBasicSalary,emp.ActionStatusId,\n        ServicesCharge,TransportationCharge,WifiCharge,GailCharge,TDS,Advance,0 AS PF,RF,Medical,SEF,0 AS SWF,TC,0 AS ESI,SRF,Loan,LoanInterest,OtherDeduction,TotDeductions,AggregateDeduction\n    FROM emp.FinalPayrollforStipend FPN\n    INNER JOIN mst.PayCycle PCL ON FPN.PayCycleId = PCL.Id   \n    INNER JOIN emp.vw_EmployeesList emp ON emp.Id = FPN.EmployeeId  \n) AS EmployeeSalaryDetails\nWHERE UniversityId = 1 AND ActionStatusId=1 AND  (UPPER(PayCycleName) LIKE '%MAR%' OR UPPER(PayCycleName) LIKE '%APR%'\n)  AND LOWER(EmployeeName) LIKE LOWER('%ankush Verma%')\n\nORDER BY  PayCycleId DESC", 'metadata': '', 'datasource': 'database_agent', 'config_id': 1}, 'score': 0.8208875060081482, 'distances': 0.1791124939918518}, {'_id': ObjectId('68c394cc9c9227a6e6abc3ce'), 'document': 'list employees having a salarymore than 3 lakhs', 'metadatas': {'query': 'SELECT *FROM (\nSELECT FPN.EmployeeId,FPN.EmployeeName,FPN.FatherName,FPN.DesignationName,FPN.DepartmentName,FPN.PayCycleId,FPN.PayCycleName,FCLY.FinancialYearName,JobName,FPN.CurrentBasicSalary\nFROM emp.FinalPayrollforNONTeaching FPN\nINNER JOIN mst.PayCycle PCL ON FPN.PayCycleId = PCL.Id AND PCL.IsDefaltForPayRoll = 1 \nINNER JOIN mst.FinancialYear FCLY ON FCLY.Id = PCL.FinancialYearId AND FCLY.IsDefaultLeave = 1  \nUNION ALL \nSELECT FPN.EmployeeId,FPN.EmployeeName,FPN.FatherName,FPN.DesignationName,FPN.DepartmentName,FPN.PayCycleId,FPN.PayCycleName,FCLY.FinancialYearName,JobName,FPN.CurrentBasicSalary\nFROM emp.FinalPayrollforTeaching FPN\nINNER JOIN mst.PayCycle PCL ON FPN.PayCycleId = PCL.Id  AND PCL.IsDefaltForPayRoll = 1 \nINNER JOIN mst.FinancialYear FCLY ON FCLY.Id = PCL.FinancialYearId AND FCLY.IsDefaultLeave = 1  \nUNION ALL \nSELECT FPN.EmployeeId,FPN.EmployeeName,FPN.FatherName,FPN.DesignationName,FPN.DepartmentName,FPN.PayCycleId,FPN.PayCycleName,FCLY.FinancialYearName,JobName,FPN.CurrentBasicSalary\nFROM emp.FinalPayrollforStipend FPN\nINNER JOIN mst.PayCycle PCL ON FPN.PayCycleId = PCL.Id AND PCL.IsDefaltForPayRoll = 1 \nINNER JOIN mst.FinancialYear FCLY ON FCLY.Id = PCL.FinancialYearId AND FCLY.IsDefaultLeave = 1 \n) AS EmployeeSalaryDetails\nWHERE   TRY_CAST(EmployeeSalaryDetails.CurrentBasicSalary AS float) > 300000 ', 'metadata': '', 'datasource': 'database_agent', 'config_id': 1}, 'score': 0.7021231651306152, 'distances': 0.29787683486938477}, {'_id': ObjectId('68c394cc9c9227a6e6abc3bc'), 'document': 'provide the list of employees having a salary above 2,00,000.', 'metadatas': {'query': '\nSELECT *FROM (\nSELECT emp.UniversityId,FPN.EmployeeId,FPN.EmployeeName,FPN.FatherName,FPN.DesignationName,FPN.DepartmentName,FPN.PayCycleId,FPN.PayCycleName,FCLY.FinancialYearName,emp.JobName,FPN.CurrentBasicSalary,emp.ActionStatusId\nFROM emp.FinalPayrollforNONTeaching FPN\nINNER JOIN mst.PayCycle PCL ON FPN.PayCycleId = PCL.Id AND PCL.IsDefaltForPayRoll = 1 \nINNER JOIN mst.FinancialYear FCLY ON FCLY.Id = PCL.FinancialYearId AND FCLY.IsDefaultLeave = 1  \nINNER JOIN emp.vw_EmployeesList emp ON emp.Id = FPN.EmployeeId \nUNION ALL \nSELECT emp.UniversityId,FPN.EmployeeId,FPN.EmployeeName,FPN.FatherName,FPN.DesignationName,FPN.DepartmentName,FPN.PayCycleId,FPN.PayCycleName,FCLY.FinancialYearName,emp.JobName,FPN.CurrentBasicSalary,emp.ActionStatusId\nFROM emp.FinalPayrollforTeaching FPN\nINNER JOIN mst.PayCycle PCL ON FPN.PayCycleId = PCL.Id  AND PCL.IsDefaltForPayRoll = 1 \nINNER JOIN mst.FinancialYear FCLY ON FCLY.Id = PCL.FinancialYearId AND FCLY.IsDefaultLeave = 1  \nINNER JOIN emp.vw_EmployeesList emp ON emp.Id = FPN.EmployeeId \nUNION ALL \nSELECT emp.UniversityId,FPN.EmployeeId,FPN.EmployeeName,FPN.FatherName,FPN.DesignationName,FPN.DepartmentName,FPN.PayCycleId,FPN.PayCycleName,FCLY.FinancialYearName,emp.JobName,FPN.CurrentBasicSalary,emp.ActionStatusId\nFROM emp.FinalPayrollforStipend FPN\nINNER JOIN mst.PayCycle PCL ON FPN.PayCycleId = PCL.Id AND PCL.IsDefaltForPayRoll = 1 \nINNER JOIN mst.FinancialYear FCLY ON FCLY.Id = PCL.FinancialYearId AND FCLY.IsDefaultLeave = 1 \nINNER JOIN emp.vw_EmployeesList emp ON emp.Id = FPN.EmployeeId  \n) AS EmployeeSalaryDetails\nWHERE  UniversityId=1 AND ActionStatusId=1 AND TRY_CAST(EmployeeSalaryDetails.CurrentBasicSalary AS float) > 200000 ', 'metadata': '', 'datasource': 'database_agent', 'config_id': 1}, 'score': 0.6981717944145203, 'distances': 0.30182820558547974}, {'_id': ObjectId('68c394cc9c9227a6e6abc48e'), 'document': 'How many employees received a salary hike of more than ₹5000?', 'metadatas': {'query': 'SELECT COUNT(*) AS EmployeesWithHikeOver5000 FROM (SELECT curr.EmployeeId, TRY_CAST(curr.CurrentBasicSalary AS DECIMAL(18,2)) AS CurrSalary, TRY_CAST(prev.CurrentBasicSalary AS DECIMAL(18,2)) AS PrevSalary FROM (SELECT EmployeeId, CurrentBasicSalary, TRY_CAST(LEFT(PayCycleName, 11) AS DATE) AS PayCycleStart FROM emp.FinalPayrollforTeaching WHERE ISNUMERIC(CurrentBasicSalary) = 1 UNION ALL SELECT EmployeeId, CurrentBasicSalary, TRY_CAST(LEFT(PayCycleName, 11) AS DATE) AS PayCycleStart FROM emp.FinalPayrollforNONTeaching WHERE ISNUMERIC(CurrentBasicSalary) = 1) AS curr INNER JOIN (SELECT EmployeeId, CurrentBasicSalary, TRY_CAST(LEFT(PayCycleName, 11) AS DATE) AS PayCycleStart FROM emp.FinalPayrollforTeaching WHERE ISNUMERIC(CurrentBasicSalary) = 1 UNION ALL SELECT EmployeeId, CurrentBasicSalary, TRY_CAST(LEFT(PayCycleName, 11) AS DATE) AS PayCycleStart FROM emp.FinalPayrollforNONTeaching WHERE ISNUMERIC(CurrentBasicSalary) = 1) AS prev ON curr.EmployeeId = prev.EmployeeId WHERE MONTH(curr.PayCycleStart) = 5 AND YEAR(curr.PayCycleStart) = YEAR(GETDATE()) AND MONTH(prev.PayCycleStart) = 5 AND YEAR(prev.PayCycleStart) = YEAR(GETDATE()) - 1) AS FinalData WHERE CurrSalary IS NOT NULL AND PrevSalary IS NOT NULL AND CurrSalary - PrevSalary > 5000;\n', 'metadata': '', 'datasource': 'database_agent', 'config_id': 1}, 'score': 0.6945961713790894, 'distances': 0.30540382862091064}, {'_id': ObjectId('68c394cc9c9227a6e6abc490'), 'document': 'How many employees received a salary hike of more than ₹5000?', 'metadatas': {'query': 'SELECT COUNT(*) AS EmployeesWithHikeOver5000 FROM (SELECT curr.EmployeeId, TRY_CAST(curr.CurrentBasicSalary AS DECIMAL(18,2)) AS CurrSalary, TRY_CAST(prev.CurrentBasicSalary AS DECIMAL(18,2)) AS PrevSalary FROM (SELECT EmployeeId, CurrentBasicSalary, TRY_CAST(LEFT(PayCycleName, 11) AS DATE) AS PayCycleStart FROM emp.FinalPayrollforTeaching WHERE ISNUMERIC(CurrentBasicSalary) = 1 UNION ALL SELECT EmployeeId, CurrentBasicSalary, TRY_CAST(LEFT(PayCycleName, 11) AS DATE) AS PayCycleStart FROM emp.FinalPayrollforNONTeaching WHERE ISNUMERIC(CurrentBasicSalary) = 1) AS curr INNER JOIN (SELECT EmployeeId, CurrentBasicSalary, TRY_CAST(LEFT(PayCycleName, 11) AS DATE) AS PayCycleStart FROM emp.FinalPayrollforTeaching WHERE ISNUMERIC(CurrentBasicSalary) = 1 UNION ALL SELECT EmployeeId, CurrentBasicSalary, TRY_CAST(LEFT(PayCycleName, 11) AS DATE) AS PayCycleStart FROM emp.FinalPayrollforNONTeaching WHERE ISNUMERIC(CurrentBasicSalary) = 1) AS prev ON curr.EmployeeId = prev.EmployeeId WHERE MONTH(curr.PayCycleStart) = 5 AND YEAR(curr.PayCycleStart) = YEAR(GETDATE()) AND MONTH(prev.PayCycleStart) = 5 AND YEAR(prev.PayCycleStart) = YEAR(GETDATE()) - 1) AS FinalData WHERE CurrSalary IS NOT NULL AND PrevSalary IS NOT NULL AND CurrSalary - PrevSalary > 5000;\n', 'metadata': '', 'datasource': 'database_agent', 'config_id': 1}, 'score': 0.6945961713790894, 'distances': 0.30540382862091064}, {'_id': ObjectId('68c394cc9c9227a6e6abc45e'), 'document': 'what is the total working experience of sukumar', 'metadatas': {'query': "SELECT e.Id,e.EmployeeName,e.FatherName,e.JoiningDate,(SELECT CAST(FLOOR(SUM(CASE WHEN Organization IN ('SUBHARTI UNIVERSITY', 'Swami Vivekanand Subharti University', 'Swami Vivekanand Subharti Univesity') \n    THEN DATEDIFF(DAY, TRY_CONVERT(DATE, WE.JoiningDate), CASE WHEN TRY_CONVERT(DATE, WE.LeavingDate) IN ('1900-01-01', '') THEN CONVERT(DATE, GETDATE()) ELSE TRY_CONVERT(DATE, WE.LeavingDate) END) \n    ELSE 0 END) / 365.25) AS VARCHAR) + ' Years ' + CAST(FLOOR((SUM(CASE WHEN Organization IN ('SUBHARTI UNIVERSITY', 'Swami Vivekanand Subharti University', 'Swami Vivekanand Subharti Univesity') \n    THEN DATEDIFF(DAY, TRY_CONVERT(DATE, WE.JoiningDate),CASE WHEN TRY_CONVERT(DATE, WE.LeavingDate) IN ('1900-01-01', '') THEN CONVERT(DATE, GETDATE()) ELSE TRY_CONVERT(DATE, WE.LeavingDate)END) \n    ELSE 0 END) % 365.25) / 30.44) AS VARCHAR) + ' Months ' + CAST(FLOOR((SUM(CASE WHEN Organization IN ('SUBHARTI UNIVERSITY', 'Swami Vivekanand Subharti University', 'Swami Vivekanand Subharti Univesity') \n    THEN DATEDIFF(DAY, TRY_CONVERT(DATE, WE.JoiningDate),CASE WHEN TRY_CONVERT(DATE, WE.LeavingDate) IN ('1900-01-01', '') THEN CONVERT(DATE, GETDATE()) ELSE TRY_CONVERT(DATE, WE.LeavingDate)END) \n    ELSE 0 END) % 365.25) % 30.44) AS VARCHAR) + ' Days' FROM emp.vw_WorkingExperienceList WE WHERE WE.EmployeeId = e.Id AND WE.ActionStatusId = 1) AS InSideExperience, \n    (SELECT CAST(FLOOR(SUM(CASE WHEN Organization NOT IN ('SUBHARTI UNIVERSITY', 'Swami Vivekanand Subharti University', 'Swami Vivekanand Subharti Univesity') THEN DATEDIFF(DAY, TRY_CONVERT(DATE, WE.JoiningDate), \n    CASE WHEN WE.LeavingDate = '1900-01-01' THEN GETDATE() ELSE TRY_CONVERT(DATE, WE.LeavingDate) END) ELSE 0 END) / 365.25) AS VARCHAR) + ' Years ' + CAST(FLOOR((SUM(CASE WHEN Organization NOT IN ('SUBHARTI UNIVERSITY', 'Swami Vivekanand Subharti University', 'Swami Vivekanand Subharti Univesity') \n    THEN DATEDIFF(DAY, TRY_CONVERT(DATE, WE.JoiningDate),CASE WHEN WE.LeavingDate = '1900-01-01' THEN GETDATE() ELSE TRY_CONVERT(DATE, WE.LeavingDate) END) ELSE 0 END) % 365.25) / 30.44) AS VARCHAR) + ' Months ' +\n    CAST(FLOOR((SUM(CASE WHEN Organization NOT IN ('SUBHARTI UNIVERSITY', 'Swami Vivekanand Subharti University', 'Swami Vivekanand Subharti Univesity') THEN DATEDIFF(DAY, TRY_CONVERT(DATE, WE.JoiningDate), CASE \n    WHEN WE.LeavingDate = '1900-01-01' THEN GETDATE() ELSE TRY_CONVERT(DATE, WE.LeavingDate) END) ELSE 0 END) % 365.25) % 30.44) AS VARCHAR) + ' Days' FROM emp.vw_WorkingExperienceList WE \n    WHERE WE.EmployeeId = e.Id AND WE.ActionStatusId = 1) AS OutsiteExperience,e.DesignationName,e.DepartmentName,e.MobileNo FROM emp.vw_EmployeesList e WHERE\n        e.UniversityId=1 AND\n        e.ActionStatusId = 1 AND e.EmployeeName LIKE ' sukumar%' ", 'metadata': '', 'datasource': 'database_agent', 'config_id': 1}, 'score': 0.6904683113098145, 'distances': 0.30953168869018555}]
