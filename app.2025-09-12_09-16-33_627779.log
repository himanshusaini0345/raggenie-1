FROM emp.vw_EmployeesList e INNER JOIN emp.BioAttendance a ON e.Id = a.EmployeeId 
 INNER JOIN Usr.Users usr ON usr.Id=a.BioUCreateUserId WHERE e.ActionStatusId = 1 AND e.UniversityId = 1 AND e.JobTypeId IN (1, 3, 5) and UpdatedInTime IS NOT NULL  AND e.EmployeeName LIKE '%Amit%' 
UNION ALL SELECT  e.Id AS EmployeeId,e.EmployeeName,e.FatherName,e.DepartmentName,e.JobTypeId,e.JobName,t.AttendanceDate,t.PunchMode,t.EntryType,t.UpdatedInTime,t.UpdatedOutTime,t.BioUCreateDate,t.BioUCreateUserId,usr.UserName UpdateBy,usr.FatherName ,'Teaching' AS AttendanceSource
