yeesList WHERE LOWER(EmployeeName) LIKE LOWER('vivek tiwari%')) GROUP BY BA.EmployeeId, CAST(BA.AttendanceDate AS DATE)) AS A INNER JOIN emp.vw_EmployeesList E ON A.EmployeeId = E.Id LEFT JOIN mst.BioAttSift MBA ON MBA.Id = A.SiftTypeId ORDER BY A.EmployeeId, A.AttendanceDate;", 'intent': 'database_agent', 'summary': "Vivek Tiwari's attendance details are available for multiple dates, showing his shift timings, late minutes, and duty hours, in the Information Technology department."}
