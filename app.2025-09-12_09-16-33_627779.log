question: How many employees have joined Subharti University this year?
query: SELECT Id,JobName,DesignationName,DepartmentName,EmployeeName,FatherName,MobileNo,JoiningDate FROM emp.VW_EmployeesList
WHERE JoiningDate >= DATEFROMPARTS(YEAR(GETDATE()), 1, 1) 
ORDER BY JoiningDate

question: How many employees have joined Subharti University this month?
query: SELECT Id,JobName,DesignationName,DepartmentName,EmployeeName,FatherName,MobileNo,JoiningDate FROM emp.VW_EmployeesList
WHERE UniversityId =1 and datepart(MONTH ,JoiningDate) >= datepart(MONTH ,getdate()) and datepart(YEAR ,JoiningDate)  = datepart(YEAR ,getdate()) ORDER BY JoiningDate

question: How many employees have joined in Information of Technology Department of Subharti University this month?
query: SELECT Id,JobName,DesignationName,DepartmentName,EmployeeName,FatherName,MobileNo,JoiningDate FROM emp.VW_EmployeesList
WHERE JoiningDate >= DATEFROMPARTS(YEAR(GETDATE()), MONTH(GETDATE()), 1) AND DepartmentName LIKE 'Information Technology' ORDER BY JoiningDate

question: How many employees have joined in NON Teaching College of Subharti University this month?
query: SELECT Id,TitleName,EmployeeName,FatherName,JobName,DesignationName,DepartmentName,MobileNo,JoiningDate FROM emp.VW_EmployeesList
