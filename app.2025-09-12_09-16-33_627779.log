peId=LB.LeaveTypeId AND ActionStatusId=9  AND ApprovedActionStatusId=8) CurrentBalance\n  FROM  [emp].[TeachingLeaveBalance] LB INNER JOIN emp.Employees emp ON emp.Id=LB.EmployeeId    INNER JOIN mst.Designation dst ON dst.Id=emp.DesignationId\n   INNER JOIN mst.JobType jt ON jt.Id=dst.JobTypeId INNER JOIN mst.LeaveType LT ON LT.Id=LB.LeaveTypeId INNER JOIN mst.FinancialYear FY ON FY.Id=LB.FinancialYearId ANd IsDefault=1\n WHERE EmployeeId IN(SELECT Id AS EmployeeId FROM emp.Employees  WHERE  ActionStatusId=1 AND LocationId=1 AND EmployeeName LIKE \'%Amit%\')\nUNION ALL\nSELECT emp.EmployeeCode,emp.EmployeeName,emp.FatherName,dst.DesignationName,jt.JobName, LB.LeaveTypeId,LT.LeaveTypeName,LT.LeaveTypeShortName,ISNULL(LB.OpeningBalance,0)+ISNULL(BalanceLeave,0) AS TotalLeave,\n (SELECT SUM(TotalLeave) FROM emp.LeaveDateWiseDetails WHERE EmployeeId=LB.EmployeeId AND FinancialYeraId=LB.FinancialYearId AND ActionStatusId=9  AND ApprovedActionStatusId=8\n AND LeaveTypeId=LB.LeaveTypeId) TakenLeave,ISNULL(ISNULL(LB.OpeningBalance,0) + ISNULL(LB.BalanceLeave,0) - ISNULL(LB.LeaveInCashBalance,0),0) - \n (SELECT SUM(TotalLeave) FROM emp.LeaveDateWiseDetails WHERE EmployeeId=LB.EmployeeId AND FinancialYeraId=LB.FinancialYearId  AND LeaveTypeId=LB.LeaveTypeId AND ActionStatusId=9  AND ApprovedActionStatusId=8) CurrentBalance\n  FROM  [emp].[StipendLeaveBalance] LB\n   INNER JOIN emp.Employees emp ON emp.Id=LB.EmployeeId \n   INNER JOIN mst.Designation dst ON dst.Id=emp.DesignationId\n   INNER JOIN mst.JobType jt ON jt.Id=dst.JobTypeId INNER JOIN mst.LeaveType LT ON LT.Id=LB.LeaveTypeId INNER JOIN mst.FinancialYear FY ON FY.Id=LB.FinancialYearId ANd IsDefault=1\n WHERE EmployeeId IN(SELECT Id AS EmployeeId FROM emp.Employees  \nWHERE  ActionStatusId=1 AND LocationId=1 AND EmployeeName LIKE \'%Amit%\')) AS LeaveDetails\n ORDER BY  LeaveDetails.EmployeeCode, LeaveDetails.EmployeeName,LeaveDetails.LeaveTypeName"', 'metadata': '', 'datasource': 'database_agent', 'config_id': 1}, 'sc