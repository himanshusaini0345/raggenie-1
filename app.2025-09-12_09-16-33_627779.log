EmployeeId, SUM(CASE WHEN IsHalf = 1 THEN 0.5 ELSE 1.0 END) AS LeaveTaken FROM emp.LeaveDateWiseDetails WHERE MONTH(LeaveDate) = MONTH(GETDATE()) AND YEAR(LeaveDate) = YEAR(GETDATE()) GROUP BY EmployeeId) AS lv ON e.Id = lv.EmployeeId OUTER APPLY (SELECT STRING_AGG(CONCAT(RelativeName, ', ', EmployeeName, ', ', DesignationName, ', ', DepartmentName, ', ', CollegeName), ': ') AS Relatives FROM emp.vw_RelativesList r WHERE r.EmployeeId = e.Id) AS rel WHERE LOWER(e.DepartmentName) LIKE LOWER('%pharmacy%') AND LOWER(e.EmployeeName) LIKE LOWER('%neeru%');\n", 'metadata': '', 'datasource': 'database_agent', 'config_id': 1}, 'score': 0.6857355237007141, 'distances': 0.3142644762992859}, {'_id': ObjectId('68c3ae609c9227a6e6abc848'), 'document': 'How many rooms are vacant in Ambedkar Bhawan?', 'metadatas': {'query': "\n SELECT *  FROM acom.vw_AccommodationAvailabilityList emp  WHERE  AllotmentStatusName='vacant'   AND BuildingName LIKE'Ambedkar Bhawan%'", 'metadata': '', 'datasource': 'database_agent', 'config_id': 1}, 'score': 0.6807698011398315, 'distances': 0.31923019886016846}, {'_id': ObjectId('68c3ae609c9227a6e6abc832'), 'document': 'roop singh monthly electricity reading details', 'metadatas': {'query': "select e.EmployeeName ,e.FatherName ,e.DepartmentName ,e.DesignationName ,BuildingName , RoomNo,ElctOPReading OpeingReading \n,ELCTCurrentReading CurrentReading,ELCTNetReading  Reading,NETELCTCharge Charge ,p.PayCycleName Month   from acom.ServicesCharges s\ninner join mst.PayCycle p  on p.Id = s.PaycycleId \ninner join emp.vw_EmployeesList  e on e.Id = s.EmployeeId \nwhere  s.PaycycleId >=41 and e.EmployeeName like 'Roop singh%' and e.UniversityId =1\norder by s.EmployeeId ,s.PaycycleId", 'metadata': '', 'datasource': 'database_agent', 'config_id': 1}, 'score': 0.680210530757904, 'distances': 0.31978946924209595}, {'_id': ObjectId('68c3ae609c9227a6e6abc8bb'), 'document': 'give me accomodation applications for 2 bhk', 'metadatas': {'query': "SELECT * FROM acom.vw_Acco