            question: has Ankush upload his covid vaccaine details?
query: SELECT EmployeeId,EmployeeName,FatherName,DepartmentName,VaccineDoseName, 'https://ems.subharti.org'+FilePath + FileName AS FileName FROM emp.vw_EmployeesCovidVaccineList WHERE EmployeeName LIKE 'Ankush%'

question: show me the salary deduction of ankush verma month of march and april
query:  

SELECT * FROM (SELECT emp.UniversityId,FPN.EmployeeId,FPN.EmployeeName,FPN.FatherName,FPN.DesignationName,FPN.DepartmentName,FPN.PayCycleId,FPN.PayCycleName,emp.JobName,FPN.CurrentBasicSalary,emp.ActionStatusId,
        ServicesCharge,TransportationCharge,WifiCharge,GailCharge,TDS,Advance,PF AS PF,0 AS RF,MI AS Medical,SEF,SWF AS SWF,0 AS TC,ESI,0 AS SRF,Loan,Intrest AS LoanInterest,OtherDeduction,TotDeductions,AggregateDeduction
    FROM emp.FinalPayrollforNONTeaching FPN
    INNER JOIN mst.PayCycle PCL ON FPN.PayCycleId = PCL.Id 
    INNER JOIN emp.vw_EmployeesList emp ON emp.Id = FPN.EmployeeId 
    UNION ALL 
    SELECT  emp.UniversityId,FPN.EmployeeId,FPN.EmployeeName,FPN.FatherName,FPN.DesignationName,FPN.DepartmentName,FPN.PayCycleId,FPN.PayCycleName,emp.JobName,FPN.CurrentBasicSalary,emp.ActionStatusId,
        ServicesCharge,TransportationCharge,WifiCharge,GailCharge,TDS,Advance,0 AS PF,RF,Medical,SEF,0 AS SWF,TC,0 AS ESI,SRF,Loan,LoanInterest,OtherDeduction,TotDeductions,AggregateDeduction 
		FROM emp.FinalPayrollforTeaching FPN
    INNER JOIN mst.PayCycle PCL ON FPN.PayCycleId = PCL.Id 
    INNER JOIN emp.vw_EmployeesList emp ON emp.Id = FPN.EmployeeId 
    UNION ALL 
    SELECT 
        emp.UniversityId,FPN.EmployeeId,FPN.EmployeeName,FPN.FatherName,FPN.DesignationName,FPN.DepartmentName,FPN.PayCycleId,FPN.PayCycleName,emp.JobName,FPN.CurrentBasicSalary,emp.ActionStatusId,
        ServicesCharge,TransportationCharge,WifiCharge,GailCharge,TDS,Advance,0 AS PF,RF,Medical,SEF,0 AS SWF,TC,0 AS ESI,SRF,Loan,LoanInterest,OtherDeduction,TotDeductions,AggregateDeduction
    FROM emp.FinalPayrollforStipend FPN
    INNER JOIN mst.PayCycle PCL ON FPN.PayCycleId = PCL.Id   
    INNER JOIN emp.vw_EmployeesList emp ON emp.Id = FPN.EmployeeId  
) AS EmployeeSalaryDetails
WHERE UniversityId = 1 AND ActionStatusId=1 AND  (UPPER(PayCycleName) LIKE '%MAR%' OR UPPER(PayCycleName) LIKE '%APR%'
)  AND LOWER(EmployeeName) LIKE LOWER('%ankush Verma%')

ORDER BY  PayCycleId DESC

