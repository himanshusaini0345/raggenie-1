2025-09-12 10:39:29.086 | INFO     | app.chain.modules.cache_checker:handle:77 - out:[{'_id': ObjectId('68c394cc9c9227a6e6abc46e'), 'document': 'show me the salary deduction of ankush verma month of march and april', 'metadatas': {'query': " \n\nSELECT * FROM (SELECT emp.UniversityId,FPN.EmployeeId,FPN.EmployeeName,FPN.FatherName,FPN.DesignationName,FPN.DepartmentName,FPN.PayCycleId,FPN.PayCycleName,emp.JobName,FPN.CurrentBasicSalary,emp.ActionStatusId,\n        ServicesCharge,TransportationCharge,WifiCharge,GailCharge,TDS,Advance,PF AS PF,0 AS RF,MI AS Medical,SEF,SWF AS SWF,0 AS TC,ESI,0 AS SRF,Loan,Intrest AS LoanInterest,OtherDeduction,TotDeductions,AggregateDeduction\n    FROM emp.FinalPayrollforNONTeaching FPN\n    INNER JOIN mst.PayCycle PCL ON FPN.PayCycleId = PCL.Id \n    INNER JOIN emp.vw_EmployeesList emp ON emp.Id = FPN.EmployeeId \n    UNION ALL \n    SELECT  emp.UniversityId,FPN.EmployeeId,FPN.EmployeeName,FPN.FatherName,FPN.DesignationName,FPN.DepartmentName,FPN.PayCycleId,FPN.PayCycleName,emp.JobName,FPN.CurrentBasicSalary,emp.ActionStatusId,\n        ServicesCharge,TransportationCharge,WifiCharge,GailCharge,TDS,Advance,0 AS PF,RF,Medical,SEF,0 AS SWF,TC,0 AS ESI,SRF,Loan,LoanInterest,OtherDeduction,TotDeductions,AggregateDeduction \n\t\tFROM emp.FinalPayrollforTeaching FPN\n    INNER JOIN mst.PayCycle PCL ON FPN.PayCycleId = PCL.Id \n    INNER JOIN emp.vw_EmployeesList emp ON emp.Id = FPN.EmployeeId \n    UNION ALL \n    SELECT \n        emp.UniversityId,FPN.EmployeeId,FPN.EmployeeName,FPN.FatherName,FPN.DesignationName,FPN.DepartmentName,FPN.PayCycleId,FPN.PayCycleName,emp.JobName,FPN.CurrentBasicSalary,emp.ActionStatusId,\n        ServicesCharge,TransportationCharge,WifiCharge,GailCharge,TDS,Advance,0 AS PF,RF,Medical,SEF,0 AS SWF,TC,0 AS ESI,SRF,Loan,LoanInterest,OtherDeduction,TotDeductions,AggregateDeduction\n    FROM emp.FinalPayrollforStipend FPN\n    INNER JOIN mst.PayCycle PCL ON FPN.PayCycleId = PCL.Id   \n    INNER JOIN emp.vw_EmployeesList emp ON emp.Id = FPN.EmployeeId  \n) AS EmployeeSalaryDetails\nWHERE UniversityId = 1 AND ActionStatusId=1 AND  (UPPER(PayCycleName) LIKE '%MAR%' OR UPPER(PayCycleName) LIKE '%APR%'\n)  AND LOWER(EmployeeName) LIKE LOWER('%ankush Verma%')\n\nORDER BY  PayCycleId DESC", 'metadata': '', 'datasource': 'database_agent', 'config_id': 1}, 'score': 0.764314591884613, 'distances': 0.23568540811538696}, {'_id': ObjectId('68c394cc9c9227a6e6abc487'), 'document': 'List of leave days taken by Iwin Shaji last month', 'metadatas': {'query': "SELECT ld.EmployeeId, ev.EmployeeName, ev.DepartmentName, ev.DesignationName, COUNT(*) AS LeavesTaken FROM emp.LeaveDateWiseDetails ld INNER JOIN emp.vw_EmployeesList ev ON ld.EmployeeId = ev.Id WHERE LOWER(ev.EmployeeName) LIKE 'iwin shaji%' AND ld.LeaveDate >= DATEFROMPARTS(YEAR(GETDATE()), MONTH(GETDATE())-1, 1) AND ld.LeaveDate <= EOMONTH(DATEFROMPARTS(YEAR(GETDATE()), MONTH(GETDATE())-1, 1)) AND ld.ActionStatusId = 4 AND ld.ApprovedActionStatusId = 4 GROUP BY ld.EmployeeId, ev.EmployeeName, ev.DepartmentName, ev.DesignationName;", 'metadata': '', 'datasource': 'database_agent', 'config_id': 1}, 'score': 0.7596192359924316, 'distances': 0.24038076400756836}, {'_id': ObjectId('68c394cc9c9227a6e6abc3be'), 'document': 'show me the list of individuals whose salary has been stopped.', 'metadatas': {'query': 'SELECT * FROM ( SELECT EmployeeName,EmployeeCode,FatherName,PanNo,DOB,DesignationName,DepartmentName,JobName,CollegeName,PayCycleName  FROM emp.FinalPayrollforNONTeaching WHERE PayCycleId = (SELECT TOP(1) Id FROM mst.PayCycle WHERE IsDefaltForPayRoll = 1 AND JobTypeId = 1) AND StopSalary = 1\n', 'metadata': '', 'datasource': 'database_agent', 'config_id': 1}, 'score': 0.7365410923957825, 'distances': 0.26345890760421753}, {'_id': ObjectId('68c394cd9c9227a6e6abc4a6'), 'document': 'Expenditures incurred by iwin shaji, the driver, on 15 May', 'metadatas': {'query': "SELECT e.EmployeeName, pc.Date, pc.Amount, pc.Remark FROM Vhc.PetrolConception pc INNER JOIN Vhc.DriverDetails d ON d.Id = pc.DriverId INNER JOIN emp.employees e ON e.Id = d.EmployeeId WHERE e.EmployeeName LIKE 'iwin shaji%' AND pc.Date = '2025-05-15';\n", 'metadata': '', 'datasource': 'database_agent', 'config_id': 1}, 'score': 0.7361852526664734, 'distances': 0.2638147473335266}, {'_id': ObjectId('68c394cd9c9227a6e6abc499'), 'document': 'What is the headcount of IT staff on leave this month?', 'metadatas': {'query': "SELECT ld.EmployeeId, ev.EmployeeName, ev.DepartmentName, ev.DesignationName, COUNT(*) AS LeavesTaken FROM emp.LeaveDateWiseDetails ld INNER JOIN emp.vw_EmployeesList ev ON ld.EmployeeId = ev.Id WHERE LOWER(ev.DepartmentName) LIKE '%information technology%' AND ld.LeaveDate >= CONVERT(varchar(10), DATEFROMPARTS(YEAR(GETDATE()), MONTH(GETDATE()), 1), 120) AND ld.LeaveDate <= GETDATE() AND ld.ActionStatusId = 4 AND ld.ApprovedActionStatusId = 4 GROUP BY ld.EmployeeId, ev.EmployeeName, ev.DepartmentName, ev.DesignationName;", 'metadata': '', 'datasource': 'database_agent', 'config_id': 1}, 'score': 0.7354175448417664, 'distances': 0.26458245515823364}, {'_id': ObjectId('68c394cc9c9227a6e6abc41a'), 'document': 'Please provide the details of employees whose city name is Saharanpur.', 'metadatas': {'query': "SELECT EAD.EmployeeId,EMP.JobName,EMP.DesignationName,EMP.DepartmentName,EMP.EmployeeName,EMP.FatherName,EAD.CityName FROM emp.VW_EmployeesList EMP \nINNER JOIN [emp].[vw_EmployeesAddressList] EAD ON EMP.Id=EAD.EmployeeId\nWHERE EAD.CityName LIKE 'Saharanpur'", 'metadata': '', 'datasource': 'database_agent', 'config_id': 1}, 'score': 0.7334526777267456, 'distances': 0.2665473222732544}]
