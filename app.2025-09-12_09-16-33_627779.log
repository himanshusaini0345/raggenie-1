query: SELECT DD.EmployeeId,emp.EmployeeName,DD.Id,DT.DocumentTypeName,DD.EmployeeDocumentTypeId,DD.FilePath,DD.FileName,DD.FileType,DD.ActionStatusId FROM emp.DocumentDetails  DD
INNER JOIN mst.EmployeeDocumentType  DT ON DD.EmployeeDocumentTypeId=DT.Id 
INNER JOIN emp.Employees emp ON emp.Id=DD.EmployeeId AND emp.ActionStatusId=1 AND emp.University_Id=1
WHERE  DD.ActionStatusId=1  AND EmployeeName LIKE 'amil shaji%' AND (DT.DocumentTypeName LIKE'%PAN card%' OR DT.DocumentTypeName LIKE'%Aadhaar card%' OR DT.DocumentTypeName LIKE'%Passport%') 
ORDER BY  DD.EmployeeId

