LEFT JOIN emp.VW_EmployeesList EMP ON NM.EmployeeId=EMP.Id AND EMP.ActionStatusId=1
WHERE EMP.EmployeeName LIke 'xxxx xxx' AND NM.ActionStatusId=1

question: employee with the highest electricity bill in February
