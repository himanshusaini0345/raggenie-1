            question: roop singh monthly Gass reading details
query: select e.EmployeeName ,e.FatherName ,e.DepartmentName ,e.DesignationName ,BuildingName , RoomNo,GailOPReading OpeingReading 
,GailCurrentReading CurrentReading,GailNetReading  Reading,GailCharge Charge ,p.PayCycleName Month   from acom.ServicesCharges s
inner join mst.PayCycle p  on p.Id = s.PaycycleId 
inner join emp.vw_EmployeesList  e on e.Id = s.EmployeeId 
where  s.PaycycleId >=41 and e.EmployeeName like 'Roop singh%' and e.UniversityId =1
order by s.EmployeeId ,s.PaycycleId

