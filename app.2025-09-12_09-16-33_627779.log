CREATE TABLE emp.EmpSalaryDetails (
    Id int NOT NULL ,
    EmployeeId int NULL ,
    JobTypeId int NULL ,
    PayCycleId int NULL ,
    PayScaleId int NULL ,
    EffectiveDate date NULL ,
    SalaryConditionId int NULL ,
    PreviousSalary nvarchar(100) NULL ,
    CurrentBasicSalary nvarchar(100) NULL ,
    IsAllowPartSalary bit NULL ,
    PartSalary1 nvarchar(100) NULL ,
    PartSalary2 nvarchar(100) NULL ,
    SalaryImage nvarchar(-1) NULL ,
    SalaryVerifyRemark nvarchar(500) NULL ,
    ActionStatusId int NULL ,
    CreateDate datetime NULL ,
    CreateUserId int NULL ,
    UpdateDate datetime NULL ,
    UpdateUserId int NULL 
);

CREATE TABLE emp.PayRollSetting (
    Id int NOT NULL ,
    EmployeeId int NOT NULL ,
    PayCycleId int NOT NULL ,
    IsPFAllowed bit NULL ,
    ISESIAllowed bit NULL ,
    IsMIAllowed bit NULL ,
    IsSwfAllowed bit NULL ,
    IsSefAllowed bit NULL ,
    IsLoanIntrestAllowed bit NULL ,
    IsAdvanceIntrestAllowed bit NULL ,
    IsrfAllowed bit NULL ,
    IsMedicalAllawed bit NULL ,
    IsTCAllawed bit NULL ,
    JobTypeId int NULL ,
    OrderNo int NULL ,
    ActionStatusId smallint NOT NULL ,
    CreateDate datetime NULL ,
    CreateUserId int NULL ,
    UpdateDate datetime NULL ,
    UpdateUserId int NULL ,
    SwfPercentage varchar(50) NULL ,
    rfPercentageId int NULL 
);

CREATE TABLE emp.EarningsMappings (
    Id int NOT NULL ,
    EmployeeId int NOT NULL ,
    FinancialYearId int NULL ,
    EarningCatDetailId int NULL ,
    Amount decimal NULL ,
    Remark varchar(250) NULL ,
    ActionStatusId smallint NULL ,
    CreateDate datetime NULL ,
    CreateUserId int NULL ,
    UpdateDate datetime NULL ,
    UpdateUserId int NULL 
);

CREATE TABLE emp.EmployeeTDSForNonTeaching (
    Id int NOT NULL ,
